.82,178.1],["musicians",178.1,178.68]]},{"start":178.68,"end":179.28,"text":"performing.","words":[["performing.",178.68,179.28]]},{"start":179.68,"end":182.94,"text":"Oh, lovely. Is it in the theatre, like last year?","words":[["Oh,",179.68,179.96],["lovely.",180.2,180.46],["Is",181.16,181.38],["it",181.38,181.5],["in",181.5,181.62],["the",181.62,181.72],["theatre,",181.72,182.08],["like",182.2,182.42],["last",182.42,182.72],["year?",182.72,182.94]]},{"start":183.18,"end":188.58,"text":"Yes, that's right. And for the next activity on the 20th, the times changed.","words":[["Yes,",183.18,183.46],["that's",183.54,183.82],["right.",183.82,184.04],["And",184.8,185.04],["for",185.04,185.16],["the",185.16,185.26],["next",185.26,185.44],["activity",185.44,185.96],["on",185.96,186.3],["the",186.3,186.42],["20th,",186.42,187.2],["the",187.44,187.5],["times",187.5,188.04],["changed.",188.04,188.58]]},{"start":189.44,"end":190.5,"text":"Is that the tour?","words":[["Is",189.44,189.96],["that",189.96,190.1],["the",190.1,190.24],["tour?",190.24,190.5]]},{"start":190.88,"end":197.48,"text":"Yes. Now it does say on the tickets that it's a 340 start but that's an error. There wasn't","words":[["Yes.",190.88,191.3],["Now",191.94,192.26],["it",192.26,192.48],["does",192.48,192.72],["say",192.72,193.02],["on",193.02,193.16],["the",193.16,193.26],["tickets",193.26,193.54],["that",193.54,193.92],["it's",193.92,194.14],["a",194.14,194.22],["340",194.22,195.02],["start",195.02,195.48],["but",195.48,195.8],["that's",195.8,196.06],["an",196.06,196.16],["error.",196.16,196.42],["There",196.96,197.22],["wasn't",197.22,197.48]]},{"start":197.48,"end":203.68,"text":"time to update them, unfortunately, so it should save four thirty instead. The correct time","words":[["time",197.48,197.72],["to",197.72,197.94],["update",197.94,198.38],["them,",198.38,198.64],["unfortunately,",198.66,199.24],["so",199.74,199.9],["it",199.9,200.06],["should",200.06,200.3],["save",200.3,200.68],["four",200.68,201.