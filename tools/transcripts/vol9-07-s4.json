.6,293.72],["sales",293.72,294.08],["picked",294.08,294.36],["up",294.36,294.56],["anyway,",294.56,294.9],["and",295.4,295.62],["the",295.62,295.72],["company",295.72,296.04],["gradually",296.04,296.64],["expanded",296.64,297.2],["its",297.2,297.42],["market",297.42,297.74],["share",297.74,298.06],["and",298.06,298.52],["is",298.52,298.66],["now",298.66,298.9],["doing",298.9,299.16],["very",299.16,299.52],["well.",299.52,299.9]]},{"start":301.4,"end":307.9,"text":"Chocozine's case is important. They were wise to carefully consider whether they could actually manage an order of this kind.","words":[["Chocozine's",301.4,302.04],["case",302.04,302.18],["is",302.18,302.34],["important.",302.34,302.8],["They",303.44,303.64],["were",303.64,303.78],["wise",303.78,304.16],["to",304.16,304.38],["carefully",304.38,304.74],["consider",304.74,305.2],["whether",305.2,305.44],["they",305.44,305.66],["could",305.66,305.96],["actually",305.96,306.44],["manage",306.44,306.78],["an",306.78,306.92],["order",306.92,307.16],["of",307.16,307.32],["this",307.32,307.48],["kind.",307.48,307.9]]},{"start":307.9,"end":312.68,"text":"But not every small business will have the happy ending that Chakuzine did.","words":[["But",307.9,308.84],["not",308.84,309.14],["every",309.14,309.6],["small",309.6,309.92],["business",309.92,310.4],["will",310.4,310.74],["have",310.74,310.94],["the",310.94,311.1],["happy",311.1,311.38],["ending",311.38,311.64],["that",311.64,311.88],["Chakuzine",311.88,312.42],["did.",312.42,312.68]]},{"start":313.1,"end":317.02,"text":"And taking on too big an order has destroyed many a small business.","words":[["And",313.1,313.38],["taking",313.38,313.68],["on",313.68,313.92],["too",313.92,314.2],["big",314.2,314.44],["an",314.44,314.56],["order",314.56,314.86],["has",314.86,315.34],["destroyed",315.34,315.72],["many",315.72,316.16],["a",316.16,316.42],["small",316.42,316.64],["business.",316.64,317.02]]},{"start":320.54,"end":325.52,"text":"That is the end of section 4. You now have half a minute to check your answers.","words":[["That",320.54,320.98],["is",320.98,321.14],["the",321.14,321.28],["end",321.28,321.5],["of",321.5,321.62],["section",321.62,321.88],["4.",321.88,322.42],["You",323.24,323.42],["now",323.42,323.64],["have",323.64,323.88],["half",323.88,324.16],["a",324.16,324.28],["minute",324.28,324.44],["to",324.44,324.64],["check",324.64,324.88],["your",324.88,325.12],["answers.",325.12,325.52]]}]}