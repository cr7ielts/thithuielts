4.79,195.09],["day",195.09,195.29],["before",195.29,195.65],["by",195.65,196.23]]},{"start":196.23,"end":204.48,"text":"random selection of students. Before you hear the rest of the discussion, you have some","words":[["random",196.23,196.57],["selection",196.57,197.11],["of",197.11,197.35],["students.",197.35,197.85],["Before",201.56,201.92],["you",201.92,202.18],["hear",202.18,202.4],["the",202.4,202.58],["rest",202.58,202.8],["of",202.8,202.92],["the",202.92,203.0],["discussion,",203.0,203.4],["you",203.92,204.1],["have",204.1,204.3],["some",204.3,204.48]]},{"start":204.48,"end":242.89,"text":"time to look at questions 25 to 30 on page 6. Now listen and answer questions 25 to 30.","words":[["time",204.48,204.9],["to",204.9,205.14],["look",205.14,205.26],["at",205.26,205.4],["questions",205.4,205.7],["25",205.7,206.58],["to",206.58,206.82],["30",206.82,207.24],["on",207.24,207.94],["page",207.94,208.26],["6.",208.26,208.84],["Now",239.29,239.71],["listen",239.71,240.03],["and",240.03,240.41],["answer",240.41,240.83],["questions",240.83,241.23],["25",241.23,242.25],["to",242.25,242.49],["30.",242.49,242.89]]},{"start":246.55,"end":252.55,"text":"So were the student markers reliable? Well comparisons were made between certain","words":[["So",246.55,247.13],["were",247.13,247.73],["the",247.73,247.91],["student",247.91,248.21],["markers",248.21,248.59],["reliable?",248.59,249.09],["Well",249.87,250.21],["comparisons",250.21,250.81],["were",250.81,251.27],["made",251.27,251.51],["between",251.51,251.91],["certain",251.91,252.55]]},{"start":252.55,"end":258.19,"text":"categories of student markers and the group as a whole, including the lecturers. The","words":[["categories",252.55,253.15],["of",253.15,253.43],["student",253.43,253.73],["markers",253.73,254.19],["and",254.19,254.75],["the",254.75,255.09],["group",255.09,255.35],["as",255.35,255.51],["a",255.51,255.61],["whole,",255.61,255.91],["including",256.15,256.61],["the",256.61,256.83],["lecturers.",256.83,257.25],["The",257.97,258.19]]},{"start":258.19,"end":262.83,"text":"The findings showed that there were some variations in the way different groups marked.","words":[["The",258.19,258.19],["findings",258.19,258.51],["showed",258.51,258.95],["that",258.95,259.15],["there",259.15,259.33],["were",259.33,259.59],["some",259.59,259.89],["variations",259.89,260.57],["in",260.57,261.33],["the",261.33,261.45],["way",261.45,261.59],["different",261.59,261.95],["groups",261.95,262.29],["marked.",262.29,262.83]]},{"start":263.55,"end":265.59,"text":"Gender did come into play, for example.","words":[["Gender",263.55,263.91],["did",263.91,264.21],["come",264.21,264.47],["into",264.47,264.67],["play,",264.67,264.97],["for",265.07,265.17],["example.",265.17,265.59]]},{"start":266.27,"end":270.87,"text":"I expect the male students were more generous when marking female presenters, were they?","words":[["I",266.27,266.37],["expect",266.37,266.69],["the",266.69,266.89],["male",266.89,267.13],["students",267.13,267.63],["were",267.63,267.89],["more",267.89,268.03],["generous",268.03,268.49],["when",268.49,268.77],["marking",268.77,269.17],["female",269.17,269.69],["presenters,",269.69,270.37],["were",270.55,270.67],["they?",270.67,270.87]]},{"start":271.19,"end":272.47,"text":"Quite the reverse, actually.","words":[["Quite",271.19,271.43],["the",271.43,271.59],["reverse,",271.59,271.97],["actually.",272.11,272.47]]},{"start":273.09,"end":276.13,"text":"They were harder on the female presenters than on the males.","words":[["They",273.09,273.19],["were",273.19,273.37],["harder",273.37,273.77],["on",273.77,274.01],["the",274.01,274.15],["female",274.15,274.47],["presenters",274.47,275.13],["than",275.13,275.43],["on",275.43,275.59],["the",275.59,275.75],["males.",275.75,276.13]]},{"start":276.61,"end":278.53,"text":"Which wasn't what I'd expected either.","words":[["Which",276.61,276.89],["wasn't",276.89,277.23],["what",277.23,277.37],["I'd",277.37,277.67],["expected",277.67,278.03],["either.",278.03,278.53]]},{"start":279.27,"end":282.37,"text":"Did female students show any bias towards male presenters?","words":[["Did",279.27,279.43],["female",279.43,279.87],["students",279.87,280.51],["show",280.51,280.75],["any",280.75,280.95],["bias",280.95,281.23],["towards",281.23,281.53],["male",281.53,281.87],["presenters?",281.87,282.37]]},{"start":282.91,"end":283.93,"text":"Interestingly not.","words":[["Interestingly",282.91,283.47],["not.",283.47,283.93]]},{"start":283.93,"end":288.87,"text":"So does that suggest women are fairer and more reliable markers than men?","words":[["So",283.93,284.75],["does",284.75,285.37],["that",285.37,285.59],["suggest",285.59,285.93],["women",285.93,286.31],["are",286.31,286.59],["fairer",286.59,287.11],["and",287.11,287.31],["more",287.31,287.53],["reliable",287.53,287.95],["markers",287.95,288.37],["than",288.37,288.63],["men?",288.63,288.87]]},{"start":289.27,"end":292.81,"text":"Well, I wouldn't go that far. It's only a small sample.","words":[["Well,",289.27,289.57],["I",289.75,289.87],["wouldn't",289.87,290.17],["go",290.17,290.37],["that",290.37,290.57],["far.",290.57,290.97],["It's",291.27,291.55],["only",291.55,291.75],["a",291.75,291.93],["small",291.93,292.23],["sample.",292.23,292.81]]},{"start":293.41,"end":297.77,"text":"But significantly, the results showed that when women marked other women,","words":[["But",293.41,293.67],["significantly,",293.67,294.25],["the",294.89,294.95],["results",294.95,295.31],["showed",295.31,295.81],["that",295.81,296.07],["when",296.07,296.23],["women",296.23,296.61],["marked",296.61,297.09],["other",297.09,297.43],["women,",297.43,297.77]]},{"start":298.27,"end":300.25,"text":"this didn't affect the grades they gave.","words":[["this",298.27,298.47],["didn't",298.47,298.89],["affect",298.89,299.15],["the",299.15,299.39],["grades",299.39,299.73],["they",299.73,299.95],["gave.",299.95,300.25]]},{"start":300.49,"end":305.37,"text":"What about age? Were you able to come to any conclusions about that?","words":[["What",300.49,301.01],["about",301.01,302.05],["age?",302.05,302.47],["Were",303.09,303.27],["you",303.27,303.45],["able",303.45,303.67],["to",303.67,303.83],["come",303.83,304.03],["to",304.03,304.17],["any",304.17,304.31],["conclusions",304.31,304.77],["about",304.77,305.09],["that?",305.09,305.37]]},{"start":305.73,"end":308.79,"text":"Yes, because we had some mature students presenting","words":[["Yes,",305.73,306.13],["because",306.37,306.67],["we",306.67,306.93],["had",306.93,307.17],["some",307.17,307.37],["mature",307.37,307.71],["students",307.71,308.35],["presenting",308.35,308.79]]},{"start":308.79,"end":312.57,"text":"and we found the marks awarded to them by their younger peers","words":[["and",308.79,309.37],["we",309.37,309.59],["found",309.59,309.87],["the",309.87,310.09],["marks",310.09,310.35],["awarded",310.35,310.79],["to",310.79,311.11],["them",311.11,311.35],["by",311.35,311.63],["their",311.63,311.81],["younger",311.81,312.17],["peers",312.17,312.57]]},{"start":312.57,"end":314.15,"text":"were rather more generous.","words":[["were",312.57,313.09],["rather",313.09,313.39],["more",313.39,313.67],["generous.",313.67,314.15]]},{"start":314.55,"end":316.17,"text":"Oh, I wonder why that is?","words":[["Oh,",314.55,314.79],["I",315.11,315.29],["wonder",315.29,315.47],["why",315.47,315.67],["that",315.67,315.81],["is?",315.81,316.17]]},{"start":317.27,"end":321.13,"text":"Now, you said there were groups of students from two universities.","words":[["Now,",317.27,317.45],["you",317.79,318.05],["said",318.05,318.35],["there",318.35,318.59],["were",318.59,318.71],["groups",318.71,318.97],["of",318.97,319.19],["students",319.19,319.65],["from",319.65,320.01],["two",320.01,320.41],["universities.",320.41,321.13]]},{"start":321.89,"end":325.99,"text":"Did they tend to favour students making presentations from their own universities?","words":[["Did",321.89,322.09],["they",322.09,322.31],["tend",322.31,322.53],["to",322.53,322.67],["favour",322.67,322.95],["students",322.95,323.41],["making",323.41,323.87],["presentations",323.87,324.43],["from",324.43,324.95],["their",324.95,325.13],["own",325.13,325.33],["universities?",325.33,325.99]]},{"start":326.49,"end":330.81,"text":"It didn't seem to influence marking one way or the other, which is quite encouraging.","words":[["It",326.49,326.69],["didn't",326.69,326.99],["seem",326.99,327.19],["to",327.19,327.37],["influence",327.37,327.71],["marking",327.71,328.27],["one",328.27,328.59],["way",328.59,328.85],["or",328.85,328.99],["the",328.99,329.17],["other,",329.17,329.45],["which",329.59,329.83],["is",329.83,330.01],["quite",330.01,330.27],["encouraging.",330.27,330.81]]},{"start":331.45,"end":336.43,"text":"We'd been interested to see if students' personal relationships affected their objectivity.","words":[["We'd",331.45,331.77],["been",331.77,331.91],["interested",331.91,332.27],["to",332.27,332.59],["see",332.59,332.81],["if",332.81,333.01],["students'",333.01,333.33],["personal",333.61,333.95],["relationships",333.95,334.69],["affected",334.69,335.23],["their",335.23,335.51],["objectivity.",335.51,336.43]]},{"start":336.43,"end":341.55,"text":"Once striking variation, though, was in the students who'd been asked to help devise","words":[["Once",336.43,337.31],["striking",337.31,337.81],["variation,",337.81,338.37],["though,",338.59,338.73],["was",339.05,339.25],["in",339.25,339.37],["the",339.37,339.49],["students",339.49,339.85],["who'd",339.85,340.21],["been",340.21,340.37],["asked",340.37,340.59],["to",340.59,340.83],["help",340.83,341.07],["devise",341.07,341.55]]},{"start":341.55,"end":346.41,"text":"the criteria for the marking scheme. They were actually the toughest markers of all,","words":[["the",341.55,341.77],["criteria",341.77,342.31],["for",342.31,342.59],["the",342.59,342.73],["marking",342.73,343.03],["scheme.",343.03,343.47],["They",344.07,344.31],["were",344.31,344.49],["actually",344.49,344.83],["the",344.83,345.05],["toughest",345.05,345.37],["markers",345.37,345.85],["of",345.85,346.09],["all,",346.09,346.41]]},{"start":346.79,"end":349.11,"text":"marking consistently below the tutors.","words":[["marking",346.79,347.09],["consistently",347.09,347.75],["below",347.75,348.25],["the",348.25,348.61],["tutors.",348.61,349.11]]},{"start":349.27,"end":353.47,"text":"Really? Well, it sounds as if it's generated lots of useful data.","words":[["Really?",349.27,349.61],["Well,",350.35,350.69],["it",350.87,351.03],["sounds",351.03,351.31],["as",351.31,351.51],["if",351.51,351.63],["it's",351.63,351.79],["generated",351.79,352.07],["lots",352.07,352.53],["of",352.53,352.77],["useful",352.77,353.05],["data.",353.05,353.47]]},{"start":358.05,"end":394.46,"text":"That is the end of section 3. You now have half a minute to check your answers. Now","words":[["That",358.05,358.61],["is",358.61,358.79],["the",358.79,358.93],["end",358.93,359.27],["of",359.27,359.45],["section",359.45,359.71],["3.",359.71,360.19],["You",361.01,361.29],["now",361.29,361.57],["have",361.57,361.91],["half",361.91,362.21],["a",362.21,362.41],["minute",362.41,362.63],["to",362.63,362.87],["check",362.87,363.19],["your",363.19,363.35],["answers.",363.35,363.77],["Now",394.2,394.46]]},{"start":394.46,"end":397.32,"text":"to section 4 on page 7.","words":[["to",394.46,394.9],["section",394.9,395.18],["4",395.18,395.8],["on",395.8,396.48],["page",396.48,396.84],["7.",396.84,397.32]]}]}