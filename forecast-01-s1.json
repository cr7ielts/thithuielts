0],["the",190.0,190.08],["package?",190.08,190.34]]},{"start":190.72,"end":198.91,"text":"Yes, and some photographs. Okay. Before you hear the rest of the conversation,","words":[["Yes,",190.72,191.08],["and",191.24,191.36],["some",191.36,191.6],["photographs.",191.6,192.04],["Okay.",192.52,192.94],["Before",196.77,197.21],["you",197.21,197.47],["hear",197.47,197.71],["the",197.71,197.87],["rest",197.87,198.13],["of",198.13,198.25],["the",198.25,198.35],["conversation,",198.35,198.91]]},{"start":199.35,"end":216.11,"text":"you have some time to look at questions 9 and 10. Now listen and answer questions 9 and 10.","words":[["you",199.35,199.73],["have",199.73,199.95],["some",199.95,200.13],["time",200.13,200.59],["to",200.59,200.83],["look",200.83,200.93],["at",200.93,201.09],["questions",201.09,201.43],["9",201.43,202.01],["and",202.01,202.35],["10.",202.35,202.71],["Now",212.81,213.19],["listen",213.19,213.53],["and",213.53,213.97],["answer",213.97,214.41],["questions",214.41,214.81],["9",214.81,215.49],["and",215.49,215.73],["10.",215.73,216.11]]},{"start":219.6,"end":223.88,"text":"Now, would you like to ensure the contents? It might be a good idea.","words":[["Now,",219.6,220.04],["would",220.06,220.2],["you",220.2,220.32],["like",220.32,220.46],["to",220.46,220.62],["ensure",220.62,221.02],["the",221.02,221.22],["contents?",221.22,221.76],["It",222.28,222.7],["might",222.7,223.08],["be",223.08,223.26],["a",223.26,223.34],["good",223.34,223.46],["idea.",223.46,223.88]]},{"start":224.28,"end":228.98,"text":"All right. Now, can we just weigh the package and I'll tell you how much it's going to cost?","words":[["All",224.28,224.46],["right.",224.46,224.72],["Now,",225.16,225.52],["can",225.6,225.92],["we",225.92,226.06],["just",226.06,226.3],["weigh",226.3,226.56],["the",226.56,226.72],["package",226.72,227.04],["and",227.04,227.36],["I'll",227.36,227.5],["tell",227.5,227.68],["you",227.68,227.84],["how",227.84,227.96],["much",227.96,228.18],["it's",228.18,228.38],["going",228.38,228.54],["to",228.54,228.68],["cost?",228.68,228.98]]},{"start":230.18,"end":232.04,"text":"Here you are. That's heavy.","words":[["Here",230.18,230.72],["you",230.72,230.86],["are.",230.86,231.02],["That's",231.58,231.82],["heavy.",231.82,232.04]]},{"start":232.4,"end":234.2,"text":"It's just over four kilos.","words":[["It's",232.4,232.74],["just",232.74,233.1],["over",233.1,233.5],["four",233.5,233.84],["kilos.",233.84,234.2]]},{"start":234.54,"end":238.22,"text":"So let's see, that's going to be $98 altogether.","words":[["So",234.54,234.84],["let's",234.84,235.24],["see,",235.24,235.48],["that's",235.62,235.88],["going",235.88,236.1],["to",236.1,236.28],["be",236.28,236.52],["$98",236.52,237.52],["altogether.",237.52,238.22]]},{"start":238.9,"end":240.46,"text":"Will I be able to get a receipt with that?","words":[["Will",238.9,239.14],["I",239.14,239.24],["be",239.24,239.32],["able",239.32,239.42],["to",239.42,239.52],["get",239.52,239.66],["a",239.66,239.76],["receipt",239.76,240.06],["with",240.06,240.28],["that?",240.28,240.46]]},{"start":240.76,"end":241.5,"text":"Yes, of course.","words":[["Yes,",240.76,241.06],["of",241.16,241.28],["course.",241.28,241.5]]},{"start":242.36,"end":246.1,"text":"Now, if the package gets lost, you should contact us as soon as possible.","words":[["Now,",242.36,242.56],["if",242.58,242.66],["the",242.66,242.76],["package",242.76,243.0],["gets",243.0,243.36],["lost,",243.36,243.74],["you",244.16,244.22],["should",244.22,244.32],["contact",244.32,244.7],["us",244.7,245.02],["as",245.02,245.24],["soon",245.24,245.56],["as",245.56,245.68],["possible.",245.68,246.1]]},{"start":246.56,"end":250.18,"text":"It's very unusual for anything to go missing, but just in case,","words":[["It's",246.56,246.8],["very",246.8,247.14],["unusual",247.14,247.58],["for",247.58,247.9],["anything",247.9,248.18],["to",248.18,248.48],["go",248.48,248.62],["missing,",248.62,248.9],["but",248.9,249.28],["just",249.28,249.62],["in",249.62,249.86],["case,",249.86,250.18]]},{"start":250.74,"end":255.24,"text":"your receipt has an ID code on it which we will need to be able to trace the package.","words":[["your",250.74,250.96],["receipt",250.96,251.3],["has",251.3,251.58],["an",251.58,251.74],["ID",251.74,252.06],["code",252.06,252.48],["on",252.48,252.7],["it",252.7,252.8],["which",252.8,253.02],["we",253.02,253.26],["will",253.26,253.38],["need",253.38,253.74],["to",253.74,254.06],["be",254.06,254.18],["able",254.18,254.36],["to",254.36,254.52],["trace",254.52,254.76],["the",254.76,254.94],["package.",254.94,255.24]]},{"start":255.56,"end":255.94,"text":"Right.","words":[["Right.",255.56,255.94]]},{"start":255.94,"end":261.52,"text":"So will I also need to bring in the receipt and the delivery form to you if it does get lost?","words":[["So",255.94,256.78],["will",256.78,257.04],["I",257.04,257.18],["also",257.18,257.36],["need",257.36,257.6],["to",257.6,257.8],["bring",257.8,257.96],["in",257.96,258.16],["the",258.16,258.28],["receipt",258.28,258.68],["and",258.68,259.04],["the",259.04,259.18],["delivery",259.18,259.46],["form",259.46,259.84],["to",259.84,260.12],["you",260.12,260.36],["if",260.36,260.54],["it",260.54,260.68],["does",260.68,260.9],["get",260.9,261.14],["lost?",261.14,261.52]]},{"start":261.88,"end":265.0,"text":"No, you can just give us a call with the ID code, okay?","words":[["No,",261.88,262.08],["you",262.28,262.4],["can",262.4,262.52],["just",262.52,262.78],["give",262.78,262.94],["us",262.94,263.08],["a",263.08,263.16],["call",263.16,263.44],["with",263.44,263.64],["the",263.64,263.78],["ID",263.78,264.02],["code,",264.02,264.48],["okay?",264.76,265.0]]},{"start":265.74,"end":267.4,"text":"Now is there anything else I can help you with?","words":[["Now",265.74,265.86],["is",265.86,265.96],["there",265.96,266.08],["anything",266.08,266.32],["else",266.32,266.62],["I",266.62,266.78],["can",266.78,266.9],["help",266.9,267.08],["you",267.08,267.22],["with?",267.22,267.4]]},{"start":267.64,"end":269.76,"text":"No, that's all. Thanks for your help.","words":[["No,",267.64,267.9],["that's",267.98,268.2],["all.",268.2,268.38],["Thanks",268.9,269.26],["for",269.26,269.44],["your",269.44,269.5],["help.",269.5,269.76]]},{"start":273.22,"end":279.72,"text":"That is the end of Part 1. You now have one minute to check your answers to Part 1.","words":[["That",273.22,273.7],["is",273.7,273.88],["the",273.88,274.04],["end",274.04,274.42],["of",274.42,274.6],["Part",274.6,274.82],["1.",274.82,275.2],["You",276.0,276.28],["now",276.28,276.54],["have",276.54,276.9],["one",276.9,277.2],["minute",277.2,277.6],["to",277.6,277.84],["check",277.84,278.16],["your",278.16,278.4],["answers",278.4,278.82],["to",278.82,279.1],["Part",279.1,279.32],["1.",279.32,279.72]]}]}