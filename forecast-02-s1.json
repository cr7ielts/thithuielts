{"id":"forecast-02","section":1,"path":"bank/listening/forecast-02/audio-1.mp3","model":"small","duration":409.74,"segments":[{"start":1.3,"end":5.64,"text":"IELTS Listening, version 59269.","words":[["IELTS",1.3,2.1],["Listening,",2.1,2.48],["version",3.24,3.6],["59269.",3.6,5.64]]},{"start":7.44,"end":12.74,"text":"You will hear a number of different recordings and you will have to answer questions on what","words":[["You",7.44,7.76],["will",7.76,7.98],["hear",7.98,8.18],["a",8.18,8.36],["number",8.36,8.68],["of",8.68,8.92],["different",8.92,9.24],["recordings",9.24,9.8],["and",9.8,10.7],["you",10.7,10.84],["will",10.84,10.96],["have",10.96,11.14],["to",11.14,11.28],["answer",11.28,11.6],["questions",11.6,12.12],["on",12.12,12.54],["what",12.54,12.74]]},{"start":12.74,"end":13.32,"text":"you hear.","words":[["you",12.74,12.94],["hear.",12.94,13.32]]},{"start":14.12,"end":19.38,"text":"There will be time for you to read the instructions and questions and you will have a chance to","words":[["There",14.12,14.54],["will",14.54,14.68],["be",14.68,14.84],["time",14.84,15.18],["for",15.18,15.44],["you",15.44,15.54],["to",15.54,15.66],["read",15.66,15.96],["the",15.96,16.2],["instructions",16.2,16.72],["and",16.72,17.02],["questions",17.02,17.4],["and",17.4,18.32],["you",18.32,18.48],["will",18.48,18.6],["have",18.6,18.76],["a",18.76,18.92],["chance",18.92,19.16],["to",19.16,19.38]]},{"start":19.38,"end":20.32,"text":"check your work.","words":[["check",19.38,19.72],["your",19.72,19.92],["work.",19.92,20.32]]},{"start":21.32,"end":24.62,"text":"All the recordings will be played once only.","words":[["All",21.32,21.68],["the",21.68,21.8],["recordings",21.8,22.2],["will",22.2,22.82],["be",22.82,22.98],["played",22.98,23.4],["once",23.4,23.94],["only.",23.94,24.62]]},{"start":25.46,"end":33.86,"text":"The test is in four parts. Write all your answers in the listening question booklet. At the","words":[["The",25.46,26.16],["test",26.16,26.56],["is",26.56,27.28],["in",27.28,2