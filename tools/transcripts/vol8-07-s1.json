9,292.21],["on",292.21,292.45],["and",292.45,293.39],["I",293.39,293.63],["guess",293.63,293.85],["most",293.85,294.07],["people",294.07,294.35],["tell",294.35,294.63],["you",294.63,294.71],["they",294.71,294.83],["want",294.83,294.99]]},{"start":294.99,"end":299.23,"text":"to be in beachfront accommodation do they but it's gonna be in winter and I","words":[["to",294.99,295.17],["be",295.17,295.29],["in",295.29,295.39],["beachfront",295.39,295.95],["accommodation",295.95,296.55],["do",296.55,296.81],["they",296.81,297.05],["but",297.05,297.81],["it's",297.81,297.93],["gonna",297.93,298.01],["be",298.01,298.17],["in",298.17,298.33],["winter",298.33,298.61],["and",298.61,299.11],["I",299.11,299.23]]},{"start":299.23,"end":302.55,"text":"And out the sea we'll be warm enough to swim in, so for us that doesn't actually matter.","words":[["And",299.23,299.29],["out",299.29,299.41],["the",299.41,299.57],["sea",299.57,299.71],["we'll",299.71,299.87],["be",299.87,299.99],["warm",299.99,300.17],["enough",300.17,300.35],["to",300.35,300.53],["swim",300.53,300.75],["in,",300.75,300.95],["so",301.05,301.25],["for",301.25,301.53],["us",301.53,301.67],["that",301.67,301.81],["doesn't",301.81,302.01],["actually",302.01,302.25],["matter.",302.25,302.55]]},{"start":303.19,"end":304.27,"text":"Okay, that's fine.","words":[["Okay,",303.19,303.59],["that's",303.73,303.99],["fine.",303.99,304.27]]},{"start":304.87,"end":307.53,"text":"And now, what facilities are important to you?","words":[["And",304.87,305.09],["now,",305.09,305.43],["what",305.59,305.77],["facilities",305.77,306.27],["are",306.27,306.57],["important",306.57,306.95],["to",306.95,307.29],["you?",307.29,307.53]]},{"start":307.87,"end":309.51,"text":"Would you like a babysitter for the evenings?","words":[["Would",307.87,307.99],["you",307.99,308.07],["like",308.07,308.25],["a",308.25,308.39],["babysitter",308.39,308.91],["for",308.91,309.11],["the",309.11,309.21],["evenings?",309.21,309.51]]},{"start":309.91,"end":311.43,"text":"I don't think that's necessary this time.","words":[["I",309.91,310.03],["don't",310.03,310.15],["think",310.15,310.31],["that's",310.31,310.53],["necessary",310.53,310.97],["this",310.97,311.21],["time.",311.21,311.43]]},{"start":311.79,"end":315.63,"text":"We don't plan to go out without the children, but we would want someone to come in to","words":[["We",311.79,311.93],["don't",311.93,312.09],["plan",312.09,312.27],["to",312.27,312.45],["go",312.45,312.55],["out",312.55,312.71],["without",312.71,312.85],["the",312.85,313.03],["children,",313.03,313.41],["but",313.67,314.09],["we",314.09,314.27],["would",314.27,314.47],["want",314.47,314.67],["someone",314.67,314.95],["to",314.95,315.11],["come",315.11,315.35],["in",315.35,315.49],["to",315.49,315.63]]},{"start":315.63,"end":317.97,"text":"tidy up and wash the dishes and so on every day.","words":[["tidy",315.63,315.91],["up",315.91,316.23],["and",316.23,316.47],["wash",316.47,316.73],["the",316.73,316.87],["dishes",316.87,317.09],["and",317.09,317.27],["so",317.27,317.39],["on",317.39,317.53],["every",317.53,317.69],["day.",317.69,317.97]]},{"start":319.01,"end":319.61,"text":"What else?","words":[["What",319.01,319.41],["else?",319.41,319.61]]},{"start":320.51,"end":322.21,"text":"It doesn't have to be too flash.","words":[["It",320.51,320.91],["doesn't",320.91,321.19],["have",321.19,321.39],["to",321.39,321.53],["be",321.53,321.67],["too",321.67,321.85],["flash.",321.85,322.21]]},{"start":322.75,"end":324.23,"text":"Like we wouldn't use a gym or anything.","words":[["Like",322.75,322.95],["we",322.95,323.17],["wouldn't",323.17,323.35],["use",323.35,323.53],["a",323.53,323.61],["gym",323.61,323.83],["or",323.83,323.97],["anything.",323.97,324.23]]},{"start":324.71,"end":327.95,"text":"And none of us really like saunas or spas, so we don't need one of those.","words":[["And",324.71,324.95],["none",324.95,325.11],["of",325.11,325.23],["us",325.23,325.35],["really",325.35,325.57],["like",325.57,325.87],[