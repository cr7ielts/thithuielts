8],["would",110.78,110.88],["you",110.88,110.98],["like",110.98,111.14],["to",111.14,111.32],["know?",111.32,111.5]]},{"start":111.5,"end":116.38,"text":"Well, I've got a number of questions, if that's okay. Have you got a few minutes?","words":[["Well,",111.5,112.34],["I've",112.58,112.76],["got",112.76,112.9],["a",112.9,113.04],["number",113.04,113.32],["of",113.32,113.54],["questions,",113.54,113.96],["if",114.1,114.22],["that's",114.22,114.52],["okay.",114.52,114.84],["Have",115.34,115.58],["you",115.58,115.7],["got",115.7,115.86],["a",115.86,116.02],["few",116.02,116.14],["minutes?",116.14,116.38]]},{"start":117.04,"end":117.48,"text":"Of course.","words":[["Of",117.04,117.18],["course.",117.18,117.48]]},{"start":117.96,"end":119.38,"text":"Can I make a note of your name?","words":[["Can",117.96,118.22],["I",118.22,118.34],["make",118.34,118.52],["a",118.52,118.64],["note",118.64,118.82],["of",118.82,118.98],["your",118.98,119.1],["name?",119.1,119.38]]},{"start":120.0,"end":122.18,"text":"Yes, I'm Jim, Jim Granley.","words":[["Yes,",120.0,120.36],["I'm",120.62,120.78],["Jim,",120.78,121.02],["Jim",121.36,121.64],["Granley.",121.64,122.18]]},{"start":125.69,"end":131.43,"text":"The man's name is Jim Granley. So, Granley has been written in the space.","words":[["The",125.69,125.93],["man's",125.93,126.33],["name",126.33,126.63],["is",126.63,126.91],["Jim",126.91,127.21],["Granley.",127.21,127.87],["So,",128.31,128.65],["Granley",129.21,129.87],["has",129.87,130.33],["been",130.33,130.51],["written",130.51,130.75],["in",130.75,130.99],["the",130.99,131.11],["space.",131.11,131.43]]},{"start":132.65,"end":140.01,"text":"Now we shall begin. You should answer the questions as you listen, because you will not hear the recording a second time.","words":[["Now",132.65,133.17],["we",133.17,133.31],["shall",133.31,133.47],["begin.",133.47,133.85],["You",134.63,134.85],["should",134.85,135.01],["answer",135.01,135.25],["the",135.25,135.41],["questions",135.41,135.87],["a