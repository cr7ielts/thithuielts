ls against our database","words":[["But",119.66,119.92],["first",119.92,120.08],["of",120.08,120.24],["all,",120.24,120.5],["I",120.64,120.82],["need",120.82,121.04],["some",121.04,121.22],["personal",121.22,121.64],["details",121.64,122.14],["and",122.14,122.58],["then",122.58,122.72],["we'll",122.72,122.98],["match",122.98,123.32],["your",123.32,123.62],["details",123.62,124.06],["against",124.06,124.38],["our",124.38,124.66],["database",124.66,125.18]]},{"start":125.18,"end":132.62,"text":"to see what's available work wise great okay your full name Sarah Brown date of","words":[["to",125.18,125.8],["see",125.8,125.98],["what's",125.98,126.28],["available",126.28,126.64],["work",126.64,127.04],["wise",127.04,127.38],["great",127.38,128.06],["okay",128.06,128.82],["your",128.82,129.6],["full",129.6,129.8],["name",129.8,130.08],["Sarah",130.08,130.78],["Brown",130.78,131.26],["date",131.26,132.46],["of",132.46,132.62]]},{"start":132.62,"end":143.04,"text":"birth March the 30th oh I'm the 31st 1988 and your address 21 Waverley Road","words":[["birth",132.62,132.94],["March",132.94,133.64],["the",133.64,133.92],["30th",133.92,134.82],["oh",134.82,135.14],["I'm",135.14,135.76],["the",135.76,135.86],["31st",135.86,136.56],["1988",136.56,138.54],["and",138.54,139.84],["your",139.84,140.22],["address",140.22,140.74],["21",140.74,141.88],["Waverley",141.88,142.64],["Road",142.64,143.04]]},{"start":143.04,"end":151.38,"text":"Radstone RD4 6WV and a contact telephone number please I can give you my mobile","words":[["Radstone",143.04,143.92],["RD4",143.92,145.26],["6WV",145.26,146.9],["and",146.9,147.88],["a",147.88,148.04],["contact",148.04,148.32],["telephone",148.32,148.68],["number",148.68,149.14],["please",149.14,149.42],["I",149.42,150.34],["can",150.34,150.74],["give",150.74,150.88],["you",150.88,150.94],["my",150.94,151.1],["mobile",151.1,151.38]]},{"start":151.38,"end":163.16,"text":"number 0903 775 115 fine now tell me where you plan to travel to and I'll see how I","words":[["number",151.38,151.78],["0903",151.78,153.78],["775",153.78,155.88],["115",155.88,156.78],["fine",156.78,158.62],["now",158.62,159.94],["tell",159.94,160.66],["me",160.66,160.8],["where",160.8,160.96],["you",160.96,161.08],["plan",161.08,161.26],["to",161.26,161.42],["travel",161.42,161.74],["to",161.74,162.04],["and",162.04,162.42],["I'll",162.42,162.6],["see",162.6,162.78],["how",162.78,163.02],["I",163.02,163.16]]},{"start":163.16,"end":168.76,"text":"can help well I'd like to go to northern Europe have you been there before no I","words":[["can",163.16,163.3],["help",163.3,163.56],["well",163.56,164.16],["I'd",164.16,164.68],["like",164.68,164.8],["to",164.8,164.96],["go",164.96,165.1],["to",165.1,165.28],["northern",165.28,165.54],["Europe",165.54,165.98],["have",165.98,166.68],["you",166.68,166.76],["been",166.76,166.94],["there",166.94,167.1],["before",167.1,167.38],["no",167.38,168.28],["I",168.28,168.76]]},{"start":168.76,"end":172.9,"text":"know southern Europe quite well as I've been there with my family we always went","words":[["know",168.76,168.94],["southern",168.94,169.4],["Europe",169.4,169.64],["quite",169.64,169.96],["well",169.96,170.26],["as",170.26,170.58],["I've",170.58,170.78],["been",170.78,170.94],["there",170.94,171.08],["with",171.08,171.2],["my",171.2,171.34],["family",171.34,171.74],["we",171.74,172.6],["always",172.6,172.78],["went",172.78,172.9]]},{"start":172.9,"end":178.4,"text":"by plane but now I can choose I'd like to go by train so I can stop off whenever","words":[["by",172.9,173.08],["plane",173.08,173.52],["but",173.52,173.86],["now",173.86,174.3],["I",174.3,174.4],["can",174.4,174.6],["choose",174.6,175.02],["I'd",175.02,175.78],["like",175.78,175.86],["to",175.86,176.02],["go",176.02,176.14],["by",176.14,176.34],["train",176.34,176.72],["so",176.72,177.08],["I",177.08,177.34],["can",177.34,177.5],["stop",177.5,177.76],["off",177.76,178.06],["whenever",178.06,178.4]]},{"start":178.4,"end":186.16,"text":"I want. Okay. Now just as important what sort of work have you got in mind? Well I thought about","words":[["I",178.4,178.64],["want.",178.64,178.82],["Okay.",179.18,179.6],["Now",180.28,180.64],["just",180.64,180.92],["as",180.92,181.1],["important",181.1,181.48],["what",181.48,182.08],["sort",182.08,182.62],["of",182.62,182.86],["work",182.86,183.12],["have",183.12,183.34],["you",183.34,183.42],["got",183.42,183.58],["in",183.58,183.72],["mind?",183.72,183.96],["Well",184.7,185.02],["I",185.02,185.52],["thought",185.52,185.8],["about",185.8,186.16]]},{"start":186.16,"end":192.8,"text":"hotel work because then I might get accommodation with the job and I'd like to work for about half","words":[["hotel",186.16,186.64],["work",186.64,187.16],["because",187.16,187.6],["then",187.6,187.84],["I",187.84,187.96],["might",187.96,188.14],["get",188.14,188.32],["accommodation",188.32,188.96],["with",188.96,189.34],["the",189.34,189.44],["job",189.44,189.8],["and",189.8,190.8],["I'd",190.8,191.02],["like",191.02,191.14],["to",191.14,191.32],["work",191.32,191.58],["for",191.58,191.82],["about",191.82,192.28],["half",192.28,192.8]]},{"start":192.8,"end":199.32,"text":"the year. That sort of work is usually quite competitive perhaps you should consider an","words":[["the",192.8,193.08],["year.",193.08,193.44],["That",194.1,194.74],["sort",194.74,195.14],["of",195.14,195.3],["work",195.3,195.52],["is",195.52,195.7],["usually",195.7,196.02],["quite",196.02,196.34],["competitive",196.34,197.0],["perhaps",197.0,198.14],["you",198.14,198.42],["should",198.42,198.56],["consider",198.56,199.08],["an",199.08,199.32]]},{"start":199.32,"end":205.86,"text":"alternative just in case. Such as? Well lots of students like to work on a farm and we have","words":[["alternative",199.32,199.86],["just",199.86,200.34],["in",200.34,200.54],["case.",200.54,200.86],["Such",201.24,201.68],["as?",201.68,202.08],["Well",202.3,202.62],["lots",202.62,203.22],["of",203.22,203.48],["students",203.48,203.82],["like",203.82,204.14],["to",204.14,204.3],["work",204.3,204.46],["on",204.46,204.6],["a",204.6,204.72],["farm",204.72,205.0],["and",205.0,205.68],["we",205.68,205.76],["have",205.76,205.86]]},{"start":205.86,"end":210.8,"text":"lots of requests from people looking for student workers for a few weeks at a time throughout","words":[["lots",205.86,206.08],["of",206.08,206.24],["requests",206.24,206.66],["from",206.66,207.0],["people",207.0,207.36],["looking",207.36,207.68],["for",207.68,208.0],["student",208.0,208.38],["workers",208.38,208.84],["for",208.84,209.16],["a",209.16,209.3],["few",209.3,209.5],["weeks",209.5,209.82],["at",209.82,209.98],["a",209.98,210.08],["time",210.08,210.48],["throughout",210.48,210.8]]},{"start":210.8,"end":215.86,"text":"the year. You can generally earn quite good money if you're willing to work fairly long","words":[["the",210.8,211.08],["year.",211.08,211.38],["You",212.16,212.34],["can",212.34,212.48],["generally",212.48,212.84],["earn",212.84,213.36],["quite",213.36,213.68],["good",213.68,213.96],["money",213.96,214.3],["if",214.3,214.5],["you're",214.5,214.64],["willing",214.64,214.78],["to",214.78,214.98],["work",214.98,215.2],["fairly",215.2,215.58],["long",215.58,215.86]]},{"start":215.86,"end":216.34,"text":"hours.","words":[["hours.",215.86,216.34]]},{"start":219.8,"end":225.06,"text":"Before you hear the rest of the conversation, you have some time to look at questions 7","words":[["Before",219.8,220.08],["you",220.08,220.34],["hear",220.34,220.56],["the",220.56,220.72],["rest",220.72,220.96],["of",220.96,221.08],["the",221.08,221.18],["conversation,",221.18,221.82],["you",222.24,222.52],["have",222.52,222.7],["some",222.7,222.9],["time",222.9,223.32],["to",223.32,223.8],["look",223.8,223.94],["at",223.94,224.08],["questions",224.08,224.38],["7",224.38,225.06]]},{"start":225.06,"end":250.1,"text":"to 10. Now listen and answer questions 7 to 10.","words":[["to",225.06,225.56],["10.",225.56,225.96],["Now",246.22,246.54],["listen",246