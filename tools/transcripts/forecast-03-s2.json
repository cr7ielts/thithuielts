ers","words":[["So",370.26,370.46],["if",370.46,371.3],["you",371.3,371.56],["think",371.56,371.82],["that",371.82,372.06],["is",375.3,376.24],["the",376.24,376.38],["end",376.38,376.74],["of",376.74,376.92],["part",376.92,377.12],["2,",377.12,377.6],["you",378.28,378.56],["now",378.56,378.82],["have",378.82,379.14],["30",379.14,379.56],["seconds",379.56,379.98],["to",379.98,380.36],["check",380.36,380.68],["your",380.68,380.88],["answers",380.88,381.3]]},{"start":381.3,"end":382.08,"text":"is to part two.","words":[["is",381.3,381.46],["to",381.46,381.54],["part",381.54,381.74],["two.",381.74,382.08]]}]}