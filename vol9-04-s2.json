.56,335.9],["get",335.9,336.06],["to",336.06,336.26],["the",336.26,336.36]]},{"start":336.36,"end":344.08,"text":"festival but it's twice the size of B and it's a nice flat walk. There's one","words":[["festival",336.36,336.78],["but",336.78,337.48],["it's",337.48,337.8],["twice",337.8,338.08],["the",338.08,338.42],["size",338.42,338.88],["of",338.88,339.16],["B",339.16,339.54],["and",339.54,340.36],["it's",340.36,340.6],["a",340.6,340.72],["nice",340.72,340.94],["flat",340.94,341.32],["walk.",341.32,341.78],["There's",343.12,343.8],["one",343.8,344.08]]},{"start":344.08,"end":346.14,"text":"One more change I'd like to tell you about.","words":[["One",344.08,344.18],["more",344.18,344.4],["change",344.4,344.8],["I'd",344.8,345.2],["like",345.2,345.34],["to",345.34,345.52],["tell",345.52,345.72],["you",345.72,345.86],["about.",345.86,346.14]]},{"start":346.84,"end":354.04,"text":"Last year we sent out nearly 30,000 free programs with the tickets, and we're aware","words":[["Last",346.84,347.14],["year",347.14,347.5],["we",347.5,347.84],["sent",347.84,348.2],["out",348.2,348.42],["nearly",348.42,348.78],["30",348.78,349.54],[",000",349.54,350.18],["free",350.18,350.58],["programs",350.58,351.28],["with",351.28,351.82],["the",351.82,352.02],["tickets,",352.02,352.3],["and",352.98,353.32],["we're",353.32,353.72],["aware",353.72,354.04]]},{"start":354.04,"end":357.58,"text":"of both the cost and the environmental impact of this.","words":[["of",354.04,354.5],["both",354.5,354.74],["the",354.74,354.98],["cost",354.98,355.34],["and",355.34,355.76],["the",355.76,355.94],["environmental",355.94,356.52],["impact",356.52,357.02],["of",357.02,357.3],["this.",357.3,357.58]]},{"start":358.32,"end":362.38,"text":"We looked into having an app instead, but that was too expensive.","words":[["We",358.32,358.72],["looked",358.72,358.92],["into",358.92,359.22],["having",359.22,359.5],["an",359.5,359.8],["app",359.8,360.04],["instead,",360.04,360.52],["but",361.0,361.34],["that",361.34,