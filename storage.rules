rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ĐỔI email này cho khớp với ADMIN_EMAILS trong js/config.js và firestore.rules
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['nguyennhatkha812@gmail.com'];
    }

    function underMB(n) { return request.resource.size < n * 1024 * 1024; }

    // Loại file học sinh được nộp: ảnh, audio, video, PDF, Word, PowerPoint, Excel, text
    function allowedType() {
      return request.resource.contentType.matches('image/.*')
        || request.resource.contentType.matches('audio/.*')
        || request.resource.contentType.matches('video/.*')
        || request.resource.contentType.matches('application/pdf')
        || request.resource.contentType.matches('application/(msword|vnd\\.openxmlformats-officedocument\\..*|vnd\\.ms-.*)')
        || request.resource.contentType.matches('text/plain');
    }

    // Ghi âm bài thi Speaking
    match /speaking/{uid}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == uid
                   && underMB(25) && request.resource.contentType.matches('audio/.*');
      allow read:  if request.auth != null && (request.auth.uid == uid || isAdmin());
    }

    // Tài liệu đề homework: giáo viên upload, học sinh đã đăng nhập xem được
    // Ngân hàng đề (PDF, audio): học sinh đã đăng nhập mới xem được; chỉ giáo viên tải lên
    match /bank/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin() && underMB(200)
        && (request.resource.contentType.matches('application/pdf') || request.resource.contentType.matches('audio/.*'));
    }

    match /homework/{aid}/materials/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if isAdmin() && underMB(100);
    }

    // Ảnh đại diện lớp: giáo viên tải lên (chỉ ảnh, < 5 MB), ai đăng nhập cũng xem được
    match /classes/{cid}/{file} {
      allow read:   if request.auth != null;
      allow write:  if isAdmin() && underMB(5) && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    // File học sinh nộp: chỉ chủ nhân và giáo viên xem được
    match /homework/{aid}/submissions/{uid}/{allPaths=**} {
      allow read:   if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == uid && underMB(50) && allowedType();
      allow update, delete: if false;
    }
  }
}
