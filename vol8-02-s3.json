r.","words":[["the",167.51,167.61],["local",167.61,167.87],["dance",167.87,168.21],["school",168.21,168.57],["and",168.57,169.19],["I",169.19,169.31],["may",169.31,169.53],["get",169.53,169.75],["the",169.75,169.85],["chance",169.85,170.15],["to",170.15,170.39],["go",170.39,170.53],["back",170.53,170.77],["there",170.77,171.05],["next",171.05,171.37],["summer.",171.37,171.83]]},{"start":173.21,"end":177.45,"text":"I've been offered more work at the place where I was working in Canada.","words":[["I've",173.21,173.77],["been",173.77,173.93],["offered",173.93,174.17],["more",174.17,174.55],["work",174.55,175.05],["at",175.05,175.43],["the",175.43,175.53],["place",175.53,175.83],["where",175.83,176.11],["I",176.11,176.27],["was",176.27,176.41],["working",176.41,176.73],["in",176.73,176.99],["Canada.",176.99,177.45]]},{"start":177.45,"end":184.07,"text":"great so what do you think you gained most from the experience I think I've","words":[["great",177.45,178.27],["so",178.27,179.59],["what",179.59,179.97],["do",179.97,180.13],["you",180.13,180.23],["think",180.23,180.45],["you",180.45,180.63],["gained",180.63,180.95],["most",180.95,181.33],["from",181.33,181.57],["the",181.57,181.75],["experience",181.75,182.35],["I",182.35,183.45],["think",183.45,183.73],["I've",183.73,184.07]]},{"start":184.07,"end":190.27,"text":"got much better at controlling my stress levels for me it was probably the fact","words":[["got",184.07,184.21],["much",184.21,184.53],["better",184.53,184.85],["at",184.85,185.03],["controlling",185.03,185.47],["my",185.47,185.73],["stress",185.73,186.05],["levels",186.05,186.57],["for",186.57,187.43],["me",187.43,187.75],["it",187.75,188.27],["was",188.27,188.61],["probably",188.61,189.41],["the",189.41,189.95],["fact",189.95,190.27]]},{"start":190.27,"end":194.37,"text":"that I learned a lot about collaborating with others rather than","words":[["that",190.27,190.45],["I",190.45,190.61],["learned",190.61,190.87],["a",190.87,191.05],["lot",191.05,191.29],[