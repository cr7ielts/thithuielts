 there's no charge","words":[["there",220.08,220.38],["and",220.38,221.16],["I",221.16,221.36],["think",221.36,221.5],["the",221.5,221.66],["plan",221.66,221.84],["is",221.84,222.02],["to",222.02,222.16],["stop",222.16,222.38],["for",222.38,222.6],["a",222.6,222.76],["break",222.76,222.92],["in",222.92,223.1],["the",223.1,223.22],["park.",223.22,223.5],["And",223.88,224.32],["there's",224.32,224.46],["no",224.46,224.62],["charge",224.62,225.0]]},{"start":225.0,"end":229.8,"text":"for the tour. And the tour will finish with a visit to the 16th century mill where they","words":[["for",225.0,225.22],["the",225.22,225.32],["tour.",225.32,225.62],["And",226.3,226.6],["the",226.6,226.7],["tour",226.7,226.94],["will",226.94,227.12],["finish",227.12,227.38],["with",227.38,227.64],["a",227.64,227.74],["visit",227.74,227.9],["to",227.9,228.12],["the",228.12,228.22],["16th",228.22,229.08],["century",229.08,229.08],["mill",229.08,229.42],["where",229.42,229.66],["they",229.66,229.8]]},{"start":229.8,"end":232.5,"text":"used to make flour. It's recently been restored.","words":[["used",229.8,229.94],["to",229.94,230.06],["make",230.06,230.18],["flour.",230.18,230.54],["It's",231.28,231.5],["recently",231.5,231.84],["been",231.84,232.08],["restored.",232.08,232.5]]},{"start":233.2,"end":233.48,"text":"Fine.","words":[["Fine.",233.2,233.48]]},{"start":233.96,"end":237.26,"text":"And then on the 21st there's an all day event for children.","words":[["And",233.96,234.22],["then",234.22,234.34],["on",234.34,234.46],["the",234.46,234.54],["21st",234.54,235.42],["there's",235.42,235.72],["an",235.72,235.84],["all",235.84,236.0],["day",236.0,236.24],["event",236.24,236.58],["for",236.58,236.8],["children.",236.8,237.26]]},{"start":237.74,"end":241.72,"text":"Oh, that could be good for my visitors. They're bringing theirs, you see.","words":[["Oh,",237.74,238.08],["that",238.52,238.86],["could",238.86,238.98],["be",238.98,239.1],["good",239.1,239.26],["for",239.26,239.38],["my",239.38,23