242.72,243.0],["child.",243.0,243.52]]},{"start":244.48,"end":246.04,"text":"A couple of points first.","words":[["A",244.48,245.06],["couple",245.06,245.26],["of",245.26,245.4],["points",245.4,245.68],["first.",245.68,246.04]]},{"start":246.84,"end":251.46,"text":"Once you and your child have settled into the centre and are familiar with how things","words":[["Once",246.84,247.38],["you",247.38,247.66],["and",247.66,247.8],["your",247.8,247.94],["child",247.94,248.32],["have",248.32,248.46],["settled",248.46,248.76],["into",248.76,249.06],["the",249.06,249.22],["centre",249.22,249.58],["and",249.58,250.2],["are",250.2,250.38],["familiar",250.38,250.66],["with",250.66,250.96],["how",250.96,251.14],["things",251.14,251.46]]},{"start":251.46,"end":258.76,"text":"work, you will be asked to choose a particular job like secretary or gardener or librarian","words":[["work,",251.46,251.84],["you",252.5,252.78],["will",252.78,252.9],["be",252.9,253.06],["asked",253.06,253.32],["to",253.32,253.54],["choose",253.54,253.84],["a",253.84,254.16],["particular",254.16,254.64],["job",254.64,255.26],["like",255.26,256.08],["secretary",256.08,256.8],["or",256.8,257.32],["gardener",257.32,258.06],["or",258.06,258.22],["librarian",258.22,258.76]]},{"start":259.46,"end":267.3,"text":"or something to be responsible for. And we have a meeting which we use to plan the programme","words":[["or",259.46,259.84],["something",259.84,260.26],["to",260.26,260.48],["be",260.48,260.62],["responsible",260.62,261.24],["for.",261.24,261.78],["And",262.74,263.42],["we",263.42,264.34],["have",264.34,264.64],["a",264.64,264.74],["meeting",264.74,265.12],["which",265.12,265.52],["we",265.52,265.7],["use",265.7,265.96],["to",265.96,266.16],["plan",266.16,266.5],["the",266.5,266.76],["programme",266.76,267.3]]},{"start":268.0,"end":274.86,"text":"and each parent is expected to attend this. Now just before we move on to answer any questions","words":[["and",268.0,268.34],["each",268.34,268.78],["parent",268.78,269.18],["is",269.18,269.6],["expected",269.6,270.04],["to",270.04,270.26],["attend",270.26,270.52],["this.",270.52,270.88],["Now",271.62,271.86],["just",271.86,272.58],["before",272.58,272.96],["we",272.96,273.18],["move",273.18,273.38],["on",273.38,273.66],["to",273.66,273.84],["answer",273.84,274.18],["any",274.18,274.42],["questions",274.42,274.86]]},{"start":274.86,"end":280.24,"text":"you have, I'd just quickly like to mention some of the ways you and your child are","words":[["you",274.86,275.18],["have,",275.18,275.42],["I'd",276.02,276.36],["just",276.36,276.52],["quickly",276.52,277.04],["like",277.04,277.3],["to",277.3,277.5],["mention",277.5,277.74],["some",277.74,278.12],["of",278.12,278.26],["the",278.26,278.34],["ways",278.34,278.6],["you",278.6,279.22],["and",279.22,279.4],["your",279.4,279.54],["child",279.54,280.0],["are",280.0,280.24]]},{"start":280.24,"end":287.34,"text":"able to get the most out of the centre. It's important that you attend regularly. This","words":[["able",280.24,280.56],["to",280.56,280.76],["get",280.76,280.92],["the",280.92,281.08],["most",281.08,281.44],["out",281.44,281.74],["of",281.74,281.9],["the",281.9,282.0],["centre.",282.0,282.36],["It's",283.92,284.34],["important",284.34,284.88],["that",284.88,285.2],["you",285.2,285.38],["attend",285.38,285.8],["regularly.",285.8,286.44],["This",287.12,287.34]]},{"start":287.34,"end":293.58,"text":"way, you'll get to know other parents well and your child will develop confidence while","words":[["way,",287.34,287.62],["you'll",288.16,288.48],["get",288.48,288.64],["to",288.64,288.84],["know",288.84,289.04],["other",289.04,289.34],["parents",289.34,289.78],["well",289.78,290.2],["and",290.2,290.98],["your",290.98,291.12],["child",291.12,291.52],["will",291.52,291.78],["develop",291.78,292.24],["confidence",292.24,292.92],["while",292.92,293.58]]},{"start":293.58,"end":299.62,"text":"he or she is here. Younger children might need to leave early. It's better to leave","words":[["he",293.58,293.82],["or",293.82,293.96],["she",293.96,294.2],["is",294.2,294.34],["here.",294.34,294.6],["Younger",295.88,296.48],["children",296.48,296.78],["might",296.78,297.24],["need",297.24,297.48],["to",297.48,297.7],["leave",297.7,297.82],["early.",297.82,298.2],["It's",298.72,299.0],["better",299.0,299.16],["to",299.16,299.34],["leave",299.34,299.62]]},{"start":299.62,"end":306.62,"text":"early than to go home with an over-tired child. We do provide drinks for the children but","words":[["early",299.62,300.14],["than",300.14,300.3],["to",300.3,300.46],["go",300.46,300.58],["home",300.58,300.96],["with",300.96,301.1],["an",301.1,301.24],["over",301.24,301.44],["-tired",301.44,301.86],["child.",301.86,302.44],["We",303.54,304.04],["do",304.04,304.26],["provide",304.26,304.64],["drinks",304.64,305.16],["for",305.16,305.4],["the",305.4,305.48],["children",305.48,305.9],["but",305.9,306.62]]},{"start":306.62,"end":310.36,"text":"But we ask you to make sure your child has a snack to eat during the morning.","words":[["But",306.62,306.68],["we",306.68,306.82],["ask",306.82,307.06],["you",307.06,307.2],["to",307.2,307.28],["make",307.28,307.48],["sure",307.48,307.78],["your",307.78,307.96],["child",307.96,308.36],["has",308.36,308.64],["a",308.64,308.74],["snack",308.74,309.06],["to",309.06,309.4],["eat",309.4,309.56],["during",309.56,309.86],["the",309.86,310.06],["morning.",310.06,310.36]]},{"start":310.96,"end":313.06,"text":"No crisps or chocolate please.","words":[["No",310.96,311.28],["crisps",311.28,311.96],["or",311.96,312.16],["chocolate",312.16,312.68],["please.",312.68,313.06]]},{"start":314.66,"end":319.32,"text":"Right, I think I'll stop there and ask if anyone's got any questions.","words":[["Right,",314.66,315.3],["I",315.72,315.96],["think",315.96,316.16],["I'll",316.16,316.4],["stop",316.4,316.64],["there",316.64,316.96],["and",316.96,317.46],["ask",317.46,317.78],["if",317.78,317.94],["anyone's",317.94,318.46],["got",318.46,318.62],["any",318.62,318.8],["questions.",318.8,319.32]]},{"start":323.2,"end":325.5,"text":"That is the end of section 2.","words":[["That",323.2,323.82],["is",323.82,324.02],["the",324.02,324.18],["end",324.18,324.46],["of",324.46,324.64],["section",324.64,324.94],["2.",324.94,325.5]]},{"start":326.42,"end":329.56,"text":"You now have half a minute to check your answers.","words":[["You",326.42,326.64],["now",326.64,326.9],["have",326.9,327.2],["half",327.2,327.52],["a",327.52,327.7],["minute",327.7,327.96],["to",327.96,328.42],["check",328.42,328.78],["your",328.78,329.1],["answers.",329.1,329.56]]},{"start":359.99,"end":363.51,"text":"Now turn to section 3 on page 4.","words":[["Now",359.99,360.37],["turn",360.37,360.71],["to",360.71,360.91],["section",360.91,361.23],["3",361.23,361.81],["on",361.81,362.57],["page",362.57,362.91],["4.",362.91,363.51]]}]}