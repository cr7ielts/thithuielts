{"id":"vol9-02","section":1,"path":"bank/listening/vol9-02/audio-1.m4a","model":"small","duration":430.29,"segments":[{"start":0.0,"end":5.28,"text":"Here are a number of different recordings, and you will have to answer questions on what you hear.","words":[["Here",0.0,0.2],["are",0.2,0.32],["a",0.32,0.36],["number",0.36,0.66],["of",0.66,0.92],["different",0.92,1.2],["recordings,",1.2,1.8],["and",2.46,2.66],["you",2.66,2.82],["will",2.82,2.94],["have",2.94,3.1],["to",3.1,3.24],["answer",3.24,3.56],["questions",3.56,4.12],["on",4.12,4.52],["what",4.52,4.72],["you",4.72,4.92],["hear.",4.92,5.28]]},{"start":6.2,"end":12.28,"text":"There will be time for you to read the instructions and questions, and you will have a chance to check your work.","words":[["There",6.2,6.52],["will",6.52,6.64],["be",6.64,6.8],["time",6.8,7.18],["for",7.18,7.42],["you",7.42,7.52],["to",7.52,7.62],["read",7.62,7.94],["the",7.94,8.16],["instructions",8.16,8.72],["and",8.72,8.98],["questions,",8.98,9.38],["and",9.96,10.3],["you",10.3,10.46],["will",10.46,10.58],["have",10.58,10.74],["a",10.74,10.88],["chance",10.88,11.14],["to",11.14,11.36],["check",11.36,11.7],["your",11.7,11.9],["work.",11.9,12.28]]},{"start":13.38,"end":16.62,"text":"All the recordings will be played once only.","words":[["All",13.38,13.64],["the",13.64,13.78],["recordings",13.78,14.18],["will",14.18,14.8],["be",14.8,14.94],["played",14.94,15.4],["once",15.4,15.94],["only.",15.94,16.62]]},{"start":17.84,"end":20.36,"text":"The test is in four parts.","words":[["The",17.84,18.14],["test",18.14,18.54],["is",18.54,19.26],["in",19.26,19.4],["four",19.4,19.76],["parts.",19.76,20.36]]},{"start":21.1,"end":24.4,"text":"Write all your answers in the listening question booklet.","words":[["Write",21.1,21.42],["all",21.42,21.72],["your",21.72,21.86],["answers",21.86,22.3],["in",22.3,22.96],["the",22.96,23.12],["listening",23.12,23.44],["question",23.44,23.96],["booklet.",23.96,24.4]]},{"start":24.4,"end":30.72,"text":"At the end of the test, you will be given 10 minutes to transfer your answers to an","words":[["At",24.4,25.24],["the",25.24,25.84],["end",25.84,26.06],["of",26.06,26.2],["the",26.2,26.28],["test,",26.28,26.64],["you",27.06,27.3],["will",27.3,27.42],["be",27.42,27.56],["given",27.56,27.84],["10",27.84,28.28],["minutes",28.28,28.62],["to",28.62,29.0],["transfer",29.0,29.58],["your",29.58,29.82],["answers",29.82,30.24],["to",30.24,30.54],["an",30.54,30.72]]},{"start":30.72,"end":31.4,"text":"answer sheet.","words":[["answer",30.72,31.02],["sheet.",31.02,31.4]]},{"start":33.44,"end":37.66,"text":"Now turn to part 1 on page 2 of your question booklet.","words":[["Now",33.44,33.78],["turn",33.78,34.04],["to",34.04,34.28],["part",34.28,34.52],["1",34.52,34.98],["on",34.98,35.72],["page",35.72,36.12],["2",36.12,36.6],["of",36.6,36.78],["your",36.78,36.88],["question",36.88,37.22],["booklet.",37.22,37.66]]},{"start":43.0,"end":47.2,"text":"Part 1 You will hear a telephone conversation between","words":[["Part",43.0,43.18],["1",43.18,43.66],["You",43.66,44.9],["will",44.9,45.1],["hear",45.1,45.34],["a",45.34,45.52],["telephone",45.52,45.9],["conversation",45.9,46.78],["between",46.78,47.2]]},{"start":47.2,"end":49.14,"text":"a woman and a park ranger.","words":[["a",47.2,47.46],["woman",47.46,47.74],["and",47.74,48.24],["a",48.24,48.4],["park",48.4,48.6],["ranger.",48.6,49.14]]},{"start":50.0,"end":53.86,"text":"First you have some time to look at questions 1-5.","words":[["First",50.0,50.74],["you",50.74,50.98],["have",50.98,51.14],["some",51.14,51.32],["time",51.32,51.74],["to",51.74,52.0],["look",52.0,52.14],["at",52.14,52.28],["questions",52.28,52.7],["1",52.7,53.22],["-5.",53.22,53.86]]},{"start":79.27,"end":82.99,"text":"Now listen carefully and answer questions 1-5.","words":[["Now",79.27,79.65],["listen",79.65,80.01],["carefully",80.01,80.47],["and",80.47,80.83],["answer",80.83,81.21],["questions",81.21,81.73],["1",81.73,82.25],["-5.",82.25,82.99]]},{"start":86.31,"end":88.79,"text":"Allman Valley Poppy Reserve, may I help you?","words":[["Allman",86.31,86.87],["Valley",86.87,87.21],["Poppy",87.21,87.49],["Reserve,",87.49,88.01],["may",88.21,88.37],["I",88.37,88.47],["help",88.47,88.63],["you?",88.63,88.79]]},{"start":89.11,"end":91.07,"text":"Is the nature reserve open now?","words":[["Is",89.11,89.41],["the",89.41,89.59],["nature",89.59,89.87],["reserve",89.87,90.23],["open",90.23,90.75],["now?",90.75,91.07]]},{"start":91.63,"end":97.69,"text":"Yes, we are actually open all year, although this is the best time of year to see the wildflowers.","words":[["Yes,",91.63,91.87],["we",92.33,92.57],["are",92.57,92.79],["actually",92.79,93.13],["open",93.13,93.45],["all",93.45,93.81],["year,",93.81,94.09],["although",94.47,94.75],["this",94.75,95.11],["is",95.11,95.37],["the",95.37,95.51],["best",95.51,95.81],["time",95.81,96.13],["of",96.13,96.31],["year",96.31,96.47],["to",96.47,96.59],["see",96.59,96.79],["the",96.79,96.95],["wildflowers.",96.95,97.69]]},{"start":97.95,"end":99.43,"text":"Are the poppies blooming yet?","words":[["Are",97.95,98.25],["the",98.25,98.41],["poppies",98.41,98.79],["blooming",98.79,99.11],["yet?",99.11,99.43]]},{"start":99.93,"end":103.99,"text":"Absolutely. They started to bloom last week and are already beautiful,","words":[["Absolutely.",99.93,100.47],["They",101.15,101.33],["started",101.33,101.61],["to",101.61,101.81],["bloom",101.81,101.95],["last",101.95,102.25],["week",102.25,102.53],["and",102.53,102.83],["are",102.83,103.05],["already",103.05,103.47],["beautiful,",103.47,103.99]]},{"start":104.43,"end":107.87,"text":"but they should peak and be in full bloom at the end of the month.","words":[["but",104.43,104.69],["they",104.69,104.91],["should",104.91,105.09],["peak",105.09,105.35],["and",105.35,105.69],["be",105.69,105.89],["in",105.89,106.05],["full",106.05,106.33],["bloom",106.33,106.63],["at",106.63,106.99],["the",106.99,107.17],["end",107.17,107.45],["of",107.45,107.63],["the",107.63,107.63],["month.",107.63,107.87]]},{"start":108.15,"end":112.81,"text":"Oh, I was planning on coming at the end of this week. Is that too early?","words":[["Oh,",108.15,108.57],["I",109.15,109.43],["was",109.43,109.57],["planning",109.57,109.85],["on",109.85,110.09],["coming",110.09,110.35],["at",110.35,110.55],["the",110.55,110.65],["end",110.65,110.81],["of",110.81,110.91],["this",110.91,111.05],["week.",111.05,111.37],["Is",111.95,112.17],["that",112.17,112.31],["too",112.31,112.49],["early?",112.49,112.81]]},{"start":112.81,"end":117.35,"text":"No, not at all. The hills are already covered with orange poppies.","words":[["No,",112.81,113.67],["not",114.01,114.21],["at",114.21,114.31],["all.",114.31,114.49],["The",114.85,115.05],["hills",115.05,115.27],["are",115.27,115.49],["already",115.49,115.91],["covered",115.91,116.25],["with",116.25,116.47],["orange",116.47,116.81],["poppies.",116.81,117.35]]},{"start":117.43,"end":118.99,"text":"I thought poppies were red.","words":[["I",117.43,117.59],["thought",117.59,117.85],["poppies",117.85,118.41],["were",118.41,118.69],["red.",118.69,118.99]]},{"start":119.61,"end":122.89,"text":"Not in California. I've never seen a red poppy here.","words":[["Not",119.61,119.87],["in",119.87,120.05],["California.",120.05,120.51],["I've",121.15,121.43],["never",121.43,121.59],["seen",121.59,121.83],["a",121.83,121.97],["red",121.97,122.17],["poppy",122.17,122.63],["here.",122.63,122.89]]},{"start":123.27,"end":125.83,"text":"The poppy reserve is in Ocean County, right?","words":[["The",123.27,123.55],["poppy",123.55,123.91],["reserve",123.91,124.19],["is",124.19,124.45],["in",124.45,124.65],["Ocean",124.65,125.03],["County,",125.03,125.47],["right?",125.63,125.83]]},{"start":126.33,"end":129.79,"text":"Right. From Lakeside, you'll need to drive about an hour east.","words":[["Right.",126.33,126.57],["From",127.15,127.33],["Lakeside,",127.33,127.87],["you'll",128.01,128.13],["need",128.13,128.21],["to",128.21,128.35],["drive",128.35,128.59],["about",128.59,128.89],["an",128.89,129.09],["hour",129.09,129.39],["east.",129.39,129.79]]},{"start":130.13,"end":132.03,"text":"What time does the reserve open?","words":[["What",130.13,130.49],["time",130.49,130.93],["does",130.93,131.15],["the",131.15,131.33],["reserve",131.33,131.57],["open?",131.57,132.03]]},{"start":132.59,"end":135.05,"text":"The reserve is open from sunrise to sunset.","words":[["The",132.59,132.81],["reserve",132.81,133.11],["is",133.11,133.29],["open",133.29,133.55],["from",133.55,133.81],["sunrise",133.81,134.29],["to",134.29,134.73],["sunset.",134.73,135.05]]},{"start":135.63,"end":138.03,"text":"It's best to come early in the morning to beat the crowds,","words":[["It's",135.63,135.91],["best",135.91,136.01],["to",136.01,136.23],["come",136.23,136.35],["early",136.35,136.65],["in",136.65,136.81],["the",136.81,136.87],["morning",136.87,137.11],["to",137.11,137.33],["beat",137.33,137.51],["the",137.51,137.67],["crowds,",137.67,138.03]]},{"start":138.03,"end":142.99,"text":"but for the best photography you might want to consider a mid-afternoon visit on a weekday.","words":[["but",138.03,138.53],["for",138.53,138.77],["the",138.77,138.89],["best",138.89,139.15],["photography",139.15,139.61],["you",139.61,140.05],["might",140.05,140.23],["want",140.23,140.45],["to",140.45,140.61],["consider",140.61,140.97],["a",140.97,141.25],["mid",141.25,141.43],["-afternoon",141.43,141.89],["visit",141.89,142.19],["on",142.19,142.53],["a",142.53,142.63],["weekday.",142.63,142.99]]},{"start":143.33,"end":149.09,"text":"I heard that there are a lot of rattlesnakes in the desert. Is it dangerous to walk about?","words":[["I",143.33,143.85],["heard",143.85,144.19],["that",144.19,144.43],["there",144.43,144.57],["are",144.57,144.69],["a",144.69,144.77],["lot",144.77,145.03],["of",145.03,145.23],["rattlesnakes",145.23,145.99],["in",145.99,146.25],["the",146.25,146.35],["desert.",146.35,146.69],["Is",147.27,147.59],["it",147.59,147.75],["dangerous",147.75,148.17],["to",148.17,148.47],["walk",148.47,148.71],["about?",148.71,149.09]]},{"start":149.77,"end":155.89,"text":"Most wildlife is quite safe. There are very few people bitten by rattlesnakes, so we do recommend","words":[["Most",149.77,150.09],["wildlife",150.09,150.47],["is",150.47,150.91],["quite",150.91,151.25],["safe.",151.25,151.61],["There",151.99,152.17],["are",152.17,152.35],["very",152.35,152.67],["few",152.67,153.05],["people",153.05,153.47],["bitten",153.47,153.83],["by",153.83,154.05],["rattlesnakes,",154.05,154.61],["so",154.79,155.21],["we",155.21,155.43],["do",155.43,155.55],["recommend",155.55,155.89]]},{"start":155.89,"end":158.45,"text":"wearing trousers just to be on the safe side.","words":[["wearing",155.89,156.25],["trousers",156.25,156.75],["just",156.75,157.25],["to",157.25,157.45],["be",157.45,157.57],["on",157.57,157.79],["the",157.79,157.95],["safe",157.95,158.21],["side.",158.21,158.45]]},{"start":158.79,"end":163.61,"text":"All right. I was hoping that I might have the chance to see some wildlife too.","words":[["All",158.79,159.07],["right.",159.07,159.29],["I",159.95,160.27],["was",160.27,160.41],["hoping",160.41,160.83],["that",160.83,161.11],["I",161.11,161.23],["might",161.23,161.43],["have",161.43,161.65],["the",161.65,161.77],["chance",161.77,162.05],["to",162.05,162.31],["see",162.31,162.45],["some",162.45,162.67],["wildlife",162.67,163.19],["too.",163.19,163.61]]},{"start":164.29,"end":166.89,"text":"Oh, how much is the admission to the reserve?","words":[["Oh,",164.29,164.65],["how",165.09,165.37],["much",165.37,165.57],["is",165.57,165.73],["the",165.73,165.85],["admission",165.85,166.23],["to",166.23,166.49],["the",166.49,166.59],["reserve?",166.59,166.89]]},{"start":166.89,"end":168.41,"text":"It's five dollars.","words":[["It's",166.89,167.83],["five",167.83,168.07],["dollars.",168.07,168.41]]},{"start":168.93,"end":171.97,"text":"Can I use my national park pass to enter the reserve?","words":[["Can",168.93,169.25],["I",169.25,169.43],["use",169.43,169.65],["my",169.65,169.83],["national",169.83,170.23],["park",170.23,170.61],["pass",170.61,171.01],["to",171.01,171.29],["enter",171.29,171.49],["the",171.49,171.63],["reserve?",171.63,171.97]]},{"start":172.69,"end":176.73,"text":"Unfortunately not, since it is a state park, not a national park.","words":[["Unfortunately",172.69,173.25],["not,",173.25,173.79],["since",173.95,174.27],["it",174.27,174.55],["is",174.55,174.65],["a",174.65,174.77],["state",174.77,175.01],["park,",175.01,175.41],["not",175.55,175.77],["a",175.77,175.99],["national",175.99,176.31],["park.",176.31,176.73]]},{"start":177.11,"end":177.67,"text":"All right.","words":[["All",177.11,177.43],["right.",177.43,177.67]]},{"start":178.55,"end":181.75,"text":"I heard from a friend that there is a nature tour available.","words":[["I",178.55,179.11],["heard",179.11,179.35],["from",179.35,179.53],["a",179.53,179.67],["friend",179.67,179.99],["that",179.99,180.31],["there",180.31,180.49],["is",180.49,180.63],["a",180.63,180.75],["nature",180.75,181.05],["tour",181.05,181.39],["available.",181.39,181.75]]},{"start":182.57,"end":183.67,"text":"Can you tell me about it?","words":[["Can",182.57,182.75],["you",182.75,182.87],["tell",182.87,183.07],["me",183.07,183.21],["about",183.21,183.43],["it?",183.43,183.67]]},{"start":184.09,"end":187.07,"text":"Certainly, but can you excuse me just a sec?","words":[["Certainly,",184.09,184.45],["but",184.77,185.05],["can",185.05,185.43],["you",185.43,185.61],["excuse",185.61,185.85],["me",185.85,186.17],["just",186.17,186.47],["a",186.47,186.83],["sec?",186.83,187.07]]},{"start":187.39,"end":188.01,"text":"I'll be right back.","words":[["I'll",187.39,187.57],["be",187.57,187.67],["right",187.67,187.81],["back.",187.81,188.01]]},{"start":188.63,"end":189.03,"text":"Okay.","words":[["Okay.",188.63,189.03]]},{"start":192.46,"end":194.8,"text":"Before you hear the rest of the conversation,","words":[["Before",192.46,193.02],["you",193.02,193.32],["hear",193.32,193.6],["the",193.6,193.78],["rest",193.78,194.04],["of",194.04,194.18],["the",194.18,194.28],["conversation,",194.28,194.8]]},{"start":195.5,"end":198.6,"text":"you have some time to look at questions six to ten.","words":[["you",195.5,195.74],["have",195.74,195.96],["some",195.96,196.14],["time",196.14,196.56],["to",196.56,196.84],["look",196.84,197.0],["at",197.0,197.12],["questions",197.12,197.52],["six",197.52,198.06],["to",198.06,198.3],["ten.",198.3,198.6]]},{"start":198.6,"end":227.27,"text":"Now listen and answer questions 6 to 10.","words":[["Now",198.6,199.56],["listen",224.29,224.63],["and",224.63,225.07],["answer",225.07,225.53],["questions",225.53,225.93],["6",225.93,226.65],["to",226.65,226.87],["10.",226.87,227.27]]},{"start":230.52,"end":231.08,"text":"Hello?","words":[["Hello?",230.52,231.08]]},{"start":231.66,"end":233.22,"text":"Yes, I'm still here.","words":[["Yes,",231.66,232.2],["I'm",232.44,232.72],["still",232.72,232.94],["here.",232.94,233.22]]},{"start":234.02,"end":237.04,"text":"Now, you are interested in the nature tours, right?","words":[["Now,",234.02,234.26],["you",234.5,234.82],["are",234.82,235.1],["interested",235.1,235.54],["in",235.54,235.9],["the",235.9,236.06],["nature",236.06,236.4],["tours,",236.4,236.72],["right?",236.88,237.04]]},{"start":237.46,"end":239.28,"text":"Oh, there's more than one?","words":[["Oh,",237.46,237.8],["there's",238.18,238.7],["more",238.7,238.86],["than",238.86,239.04],["one?",239.04,239.28]]},{"start":239.62,"end":240.0,"text":"Yes.","words":[["Yes.",239.62,240.0]]},{"start":240.56,"end":244.0,"text":"We have the general tour, which is the one your friend may have taken,","words":[["We",240.56,240.86],["have",240.86,241.1],["the",241.1,241.22],["general",241.22,241.48],["tour,",241.48,241.82],["which",242.12,242.46],["is",242.46,242.64],["the",242.64,242.74],["one",242.74,242.92],["your",242.92,243.1],["friend",243.1,243.4],["may",243.4,243.62],["have",243.62,243.72],["taken,",243.72,244.0]]},{"start":244.36,"end":246.86,"text":"but we also have two more specialized tours.","words":[["but",244.36,244.7],["we",244.7,244.92],["also",244.92,245.18],["have",245.18,245.38],["two",245.38,245.62],["more",245.62,245.86],["specialized",245.86,246.32],["tours.",246.32,246.86]]},{"start":247.44,"end":250.12,"text":"Starting at 7.30 a.m. is our general tour.","words":[["Starting",247.44,247.76],["at",247.76,247.92],["7",247.92,248.12],[".30",248.12,248.4],["a",248.4,248.7],[".m.",248.7,248.94],["is",248.98,249.22],["our",249.22,249.4],["general",249.4,249.74],["tour.",249.74,250.12]]},{"start":250.48,"end":252.38,"text":"That's early for some people, I know.","words":[["That's",250.48,251.04],["early",251.04,251.32],["for",251.32,251.5],["some",251.5,251.66],["people,",251.66,251.94],["I",252.12,252.22],["know.",252.22,252.38]]},{"start":252.88,"end":254.22,"text":"It's offered every hour, too.","words":[["It's",252.88,253.14],["offered",253.14,253.38],["every",253.38,253.72],["hour,",253.72,253.98],["too.",254.1,254.22]]},{"start":254.22,"end":257.66,"text":"But it's a great time, and it only lasts 30 minutes.","words":[["But",254.22,255.14],["it's",255.14,255.44],["a",255.44,255.5],["great",255.5,255.62],["time,",255.62,255.96],["and",256.14,256.42],["it",256.42,256.56],["only",256.56,256.72],["lasts",256.72,257.04],["30",257.04,257.38],["minutes.",257.38,257.66]]},{"start":258.08,"end":260.86,"text":"Is that the tour that takes you to the Vista Points?","words":[["Is",258.08,258.56],["that",258.56,258.76],["the",258.76,258.96],["tour",258.96,259.16],["that",259.16,259.34],["takes",259.34,259.62],["you",259.62,259.84],["to",259.84,260.02],["the",260.02,260.18],["Vista",260.18,260.48],["Points?",260.48,260.86]]},{"start":261.44,"end":266.02,"text":"Yes, that is one of the highlights, along with a film introducing the park and the museum.","words":[["Yes,",261.44,261.72],["that",261.96,262.16],["is",262.16,262.28],["one",262.28,262.46],["of",262.46,262.56],["the",262.56,262.66],["highlights,",262.66,263.0],["along",263.4,263.7],["with",263.7,263.9],["a",263.9,263.98],["film",263.98,264.22],["introducing",264.22,264.64],["the",264.64,264.94],["park",264.94,265.22],["and",265.22,265.54],["the",265.54,265.68],["museum.",265.68,266.02]]},{"start":266.72,"end":268.8,"text":"You're welcome to tour the museum at your leisure.","words":[["You're",266.72,266.92],["welcome",266.92,267.18],["to",267.18,267.42],["tour",267.42,267.64],["the",267.64,267.78],["museum",267.78,268.16],["at",268.16,268.44],["your",268.44,268.58],["leisure.",268.58,268.8]]},{"start":269.42,"end":273.68,"text":"It's a great tour for those who just want to take panoramic pictures with automatic cameras.","words":[["It's",269.42,269.7],["a",269.7,269.8],["great",269.8,270.0],["tour",270.0,270.3],["for",270.3,270.46],["those",270.46,270.68],["who",270.68,270.86],["just",270.86,271.06],["want",271.06,271.24],["to",271.24,271.38],["take",271.38,271.58],["panoramic",271.58,272.08],["pictures",272.08,272.48],["with",272.48,272.9],["automatic",272.9,273.18],["cameras.",273.18,273.68]]},{"start":274.22,"end":278.92,"text":"Well, if I come all that way, I'd like to have a more detailed tour.","words":[["Well,",274.22,274.58],["if",275.16,275.36],["I",275.36,275.54],["come",275.54,275.8],["all",275.8,276.12],["that",276.12,276.32],["way,",276.32,276.58],["I'd",276.86,277.16],["like",277.16,277.3],["to",277.3,277.5],["have",277.5,277.74],["a",277.74,277.92],["more",277.92,278.08],["detailed",278.08,278.44],["tour.",278.44,278.92]]},{"start":278.92,"end":285.14,"text":"Then you are in luck because we have a wonderful wildflower tour every two hours from 8 a.m.","words":[["Then",278.92,279.74],["you",279.74,280.04],["are",280.04,280.2],["in",280.2,280.32],["luck",280.32,280.56],["because",280.56,281.06],["we",281.06,281.26],["have",281.26,281.46],["a",281.46,281.66],["wonderful",281.66,282.06],["wildflower",282.06,282.8],["tour",282.8,283.12],["every",283.12,283.5],["two",283.5,283.78],["hours",283.78,284.14],["from",284.14,284.48],["8",284.48,284.76],["a",284.76,284.94],[".m.",284.94,285.14]]},{"start":285.64,"end":290.84,"text":"It lasts one hour and the volunteer will give you information about many of the flowers on the reserve.","words":[["It",285.64,285.84],["lasts",285.84,286.14],["one",286.14,286.42],["hour",286.42,286.66],["and",286.66,287.08],["the",287.08,287.2],["volunteer",287.2,287.56],["will",287.56,287.82],["give",287.82,287.98],["you",287.98,288.12],["information",288.12,288.52],["about",288.52,288.96],["many",288.96,289.38],["of",289.38,289.6],["the",289.6,289.72],["flowers",289.72,290.02],["on",290.02,290.38],["the",290.38,290.52],["reserve.",290.52,290.84]]},{"start":291.22,"end":294.46,"text":"Besides the poppies, will cream cups be in bloom?","words":[["Besides",291.22,291.74],["the",291.74,292.08],["poppies,",292.08,292.58],["will",292.92,293.14],["cream",293.14,293.52],["cups",293.52,293.78],["be",293.78,294.16],["in",294.16,294.28],["bloom?",294.28,294.46]]},{"start":295.02,"end":297.6,"text":"Yes, and you will see lots of sage too.","words":[["Yes,",295.02,295.32],["and",295.64,295.98],["you",295.98,296.12],["will",296.12,296.22],["see",296.22,296.4],["lots",296.4,296.7],["of",296.7,296.9],["sage",296.9,297.24],["too.",297.24,297.6]]},{"start":298.26,"end":302.08,"text":"We have a volunteer who is really good at giving tips on close-up photography.","words":[["We",298.26,298.46],["have",298.46,298.62],["a",298.62,298.72],["volunteer",298.72,299.08],["who",299.08,299.34],["is",299.34,299.46],["really",299.46,299.82],["good",299.82,300.16],["at",300.16,300.3],["giving",300.3,300.5],["tips",300.5,300.86],["on",300.86,301.06],["close",301.06,301.34],["-up",301.34,301.54],["photography.",301.54,302.08]]},{"start":302.46,"end":304.2,"text":"You mentioned another tour.","words":[["You",302.46,302.84],["mentioned",302.84,303.28],["another",303.28,303.74],["tour.",303.74,304.2]]},{"start":304.2,"end":310.38,"text":"Yes, the last one is the Wildlife Tour, but it is offered at very limited times.","words":[["Yes,",304.2,305.2],["the",305.54,305.74],["last",305.74,306.08],["one",306.08,306.36],["is",306.36,306.66],["the",306.66,306.82],["Wildlife",306.82,307.24],["Tour,",307.24,307.68],["but",308.0,308.38],["it",308.38,308.6],["is",308.6,308.7],["offered",308.7,309.04],["at",309.04,309.32],["very",309.32,309.62],["limited",309.62,309.94],["times.",309.94,310.38]]},{"start":310.94,"end":313.94,"text":"Is that because most of the wildlife is nocturnal?","words":[["Is",310.94,311.24],["that",311.24,311.4],["because",311.4,311.76],["most",311.76,312.16],["of",312.16,312.36],["the",312.36,312.46],["wildlife",312.46,312.84],["is",312.84,313.26],["nocturnal?",313.26,313.94]]},{"start":314.5,"end":319.32,"text":"Yes, so we offer this tour only two times, 5.30am or 7pm.","words":[["Yes,",314.5,314.76],["so",315.08,315.36],["we",315.36,315.48],["offer",315.48,315.7],["this",315.7,315.88],["tour",315.88,316.12],["only",316.12,316.52],["two",316.52,316.88],["times,",316.88,317.22],["5",317.72,317.9],[".30am",317.9,318.62],["or",318.62,319.02],["7pm.",319.02,319.32]]},{"start":320.34,"end":325.46,"text":"Wow, that early? But don't the snakes and lizards like the sun?","words":[["Wow,",320.34,320.94],["that",321.46,321.7],["early?",321.7,322.08],["But",322.84,323.24],["don't",323.24,323.48],["the",323.48,323.62],["snakes",323.62,323.92],["and",323.92,324.2],["lizards",324.2,324.62],["like",324.62,324.9],["the",324.9,325.14],["sun?",325.14,325.46]]},{"start":326.04,"end":331.8,"text":"Right, first let me say it takes about an hour and a half, but you will have the opportunity to see other animals,","words":[["Right,",326.04,326.38],["first",326.8,327.08],["let",327.08,327.3],["me",327.3,327.36],["say",327.36,327.6],["it",327.6,327.76],["takes",327.76,327.94],["about",327.94,328.12],["an",328.12,328.28],["hour",328.28,328.54],["and",328.54,328.72],["a",328.72,328.8],["half,",328.8,329.12],["but",329.3,329.7],["you",329.7,329.9],["will",329.9,330.0],["have",330.0,330.16],["the",330.16,330.28],["opportunity",330.28,330.7],["to",330.7,330.96],["see",330.96,331.16],["other",331.16,331.42],["animals,",331.42,331.8]]},{"start":331.8,"end":334.6,"text":"like coyotes, quail, and road runners.","words":[["like",331.8,332.32],["coyotes,",332.32,332.86],["quail,",333.18,333.54],["and",333.82,334.14],["road",334.14,334.32],["runners.",334.32,334.6]]},{"start":335.06,"end":336.92,"text":"You have to get here before the crowds arrive","words":[["You",335.06,335.28],["have",335.28,335.38],["to",335.38,335.46],["get",335.46,335.58],["here",335.58,335.82],["before",335.82,336.12],["the",336.12,336.38],["crowds",336.38,336.6],["arrive",336.6,336.92]]},{"start":336.92,"end":338.66,"text":"or after most of them leave.","words":[["or",336.92,337.42],["after",337.42,337.84],["most",337.84,338.14],["of",338.14,338.28],["them",338.28,338.4],["leave.",338.4,338.66]]},{"start":339.08,"end":340.56,"text":"Well, that makes sense.","words":[["Well,",339.08,339.68],["that",339.82,340.0],["makes",340.0,340.18],["sense.",340.18,340.56]]},{"start":341.3,"end":343.18,"text":"Does it require a lot of walking?","words":[["Does",341.3,341.72],["it",341.72,341.86],["require",341.86,342.22],["a",342.22,342.54],["lot",342.54,342.7],["of",342.7,342.86],["walking?",342.86,343.18]]},{"start":343.94,"end":345.6,"text":"More like a lot of standing,","words":[["More",343.94,344.3],["like",344.3,344.62],["a",344.62,344.84],["lot",344.84,344.98],["of",344.98,345.12],["standing,",345.12,345.6]]},{"start":346.14,"end":348.78,"text":"but most of the time you will be at one or two locations,","words":[["but",346.14,346.36],["most",346.36,346.62],["of",346.62,346.74],["the",346.74,346.78],["time",346.78,347.02],["you",347.02,347.2],["will",347.2,347.28],["be",347.28,347.44],["at",347.44,347.7],["one",347.7,347.96],["or",347.96,348.1],["two",348.1,348.28],["locations,",348.28,348.78]]},{"start":349.16,"end":352.06,"text":"so we recommend bringing a tripod and zoom lens","words":[["so",349.16,349.62],["we",349.62,349.78],["recommend",349.78,350.1],["bringing",350.1,350.44],["a",350.44,350.66],["tripod",350.66,350.98],["and",350.98,351.56],["zoom",351.56,351.8],["lens",351.8,352.06]]},{"start":352.06,"end":353.22,"text":"if you want to take pictures.","words":[["if",352.06,352.42],["you",352.42,352.52],["want",352.52,352.68],["to",352.68,352.8],["take",352.8,352.92],["pictures.",352.92,353.22]]},{"start":353.78,"end":355.8,"text":"Well, thank you very much.","words":[["Well,",353.78,354.2],["thank",354.56,354.88],["you",354.88,355.04],["very",355.04,355.36],["much.",355.36,355.8]]},{"start":356.16,"end":358.7,"text":"You've been extremely helpful and informative.","words":[["You've",356.16,356.46],["been",356.46,356.58],["extremely",356.58,357.12],["helpful",357.12,357.68],["and",357.68,358.1],["informative.",358.1,358.7]]},{"start":359.48,"end":359.98,"text":"You're welcome.","words":[["You're",359.48,359.72],["welcome.",359.72,359.98]]},{"start":359.98,"end":361.46,"text":"Awesome. Glad I could be of service.","words":[["Awesome.",359.98,360.12],["Glad",360.46,360.72],["I",360.72,360.86],["could",360.86,360.98],["be",360.98,361.12],["of",361.12,361.18],["service.",361.18,361.46]]},{"start":361.84,"end":362.1,"text":"Goodbye.","words":[["Goodbye.",361.84,362.1]]},{"start":362.7,"end":363.02,"text":"Goodbye.","words":[["Goodbye.",362.7,363.02]]},{"start":366.35,"end":368.33,"text":"That is the end of Part One.","words":[["That",366.35,366.85],["is",366.85,367.03],["the",367.03,367.21],["end",367.21,367.57],["of",367.57,367.77],["Part",367.77,367.97],["One.",367.97,368.33]]},{"start":369.17,"end":372.89,"text":"You now have one minute to check your answers to Part One.","words":[["You",369.17,369.43],["now",369.43,369.71],["have",369.71,370.05],["one",370.05,370.37],["minute",370.37,370.73],["to",370.73,371.01],["check",371.01,371.31],["your",371.31,371.55],["answers",371.5