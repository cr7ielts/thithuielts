{"id":"vol8-07","section":2,"path":"bank/listening/vol8-07/audio-2.m4a","model":"small","duration":386.01,"segments":[{"start":0.0,"end":7.4,"text":"Part 2. You will hear a manager from a company that makes electrical goods, talking to some college","words":[["Part",0.0,0.28],["2.",0.28,0.78],["You",1.56,2.24],["will",2.24,2.42],["hear",2.42,2.64],["a",2.64,2.78],["manager",2.78,3.18],["from",3.18,3.56],["a",3.56,3.72],["company",3.72,4.06],["that",4.06,4.36],["makes",4.36,4.66],["electrical",4.66,5.2],["goods,",5.2,5.66],["talking",6.22,6.58],["to",6.58,6.84],["some",6.84,7.04],["college",7.04,7.4]]},{"start":7.4,"end":13.5,"text":"students who are going to spend a month with the company. First you have some time to look","words":[["students",7.4,7.92],["who",7.92,8.18],["are",8.18,8.28],["going",8.28,8.48],["to",8.48,8.68],["spend",8.68,8.88],["a",8.88,9.12],["month",9.12,9.38],["with",9.38,9.72],["the",9.72,9.82],["company.",9.82,10.2],["First",11.42,12.1],["you",12.1,12.34],["have",12.34,12.5],["some",12.5,12.68],["time",12.68,13.1],["to",13.1,13.4],["look",13.4,13.5]]},{"start":13.5,"end":49.58,"text":"at questions 11 to 16. Now listen carefully and answer questions 11 to 16.","words":[["at",13.5,13.64],["questions",13.64,13.98],["11",13.98,14.46],["to",14.46,14.7],["16.",14.7,15.14],["Now",45.78,46.18],["listen",46.18,46.5],["carefully",46.5,47.0],["and",47.0,47.4],["answer",47.4,47.78],["questions",47.78,48.2],["11",48.2,48.8],["to",48.8,49.04],["16.",49.04,49.58]]},{"start":53.18,"end":59.44,"text":"Hello and welcome to Reynolds Electrical. I'm Kathy Meredith and I'm in charge of your","words":[["Hello",53.18,53.6],["and",53.6,54.1],["welcome",54.1,54.54],["to",54.54,54.82],["Reynolds",54.82,55.16],["Electrical.",55.16,55.9],["I'm",56.44,56.76],["Kathy",56.76,57.06],["Meredith",57.06,57.48],["and",57.48,58.32],["I'm",58.32,58.64],["in",58.64,58.74],["charge",58.74,59.0],["of",59.0,59.26],["your",59.26,59.44]]},{"start":59.44,"end":64.44,"text":"training prog