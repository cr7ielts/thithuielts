,["the",111.34,111.64],["festival.",111.64,112.08]]},{"start":112.72,"end":118.84,"text":"Special buses will run from the town centre to the show at 20 minute intervals for those","words":[["Special",112.72,113.32],["buses",113.32,113.86],["will",113.86,114.1],["run",114.1,114.34],["from",114.34,114.52],["the",114.52,114.7],["town",114.7,114.96],["centre",114.96,115.38],["to",115.38,115.56],["the",115.56,115.66],["show",115.66,115.98],["at",115.98,116.68],["20",116.68,117.06],["minute",117.06,117.32],["intervals",117.32,117.92],["for",117.92,118.58],["those",118.58,118.84]]},{"start":118.84,"end":120.92,"text":"of you who prefer to take public transport.","words":[["of",118.84,119.0],["you",119.0,119.16],["who",119.16,119.3],["prefer",119.3,119.58],["to",119.58,119.76],["take",119.76,120.0],["public",120.0,120.38],["transport.",120.38,120.92]]},{"start":122.3,"end":128.14,"text":"If you're interested in seeing the latest in cars, from the fastest to the most expensive,","words":[["If",122.3,122.6],["you're",122.6,122.86],["interested",122.86,123.22],["in",123.22,123.48],["seeing",123.48,123.72],["the",123.72,123.96],["latest",123.96,124.26],["in",124.26,124.52],["cars,",124.52,125.04],["from",125.46,126.0],["the",126.0,126.16],["fastest",126.16,126.64],["to",126.64,127.18],["the",127.18,127.32],["most",127.32,127.48],["expensive,",127.48,128.14]]},{"start":128.68,"end":135.44,"text":"then head over to the Motor Show at the exhibition centre from the 10th to the 15th of September.","words":[["then",128.68,129.06],["head",129.06,129.46],["over",129.46,129.74],["to",129.74,129.9],["the",129.9,130.0],["Motor",130.0,130.3],["Show",130.3,130.62],["at",130.62,131.12],["the",131.12,131.26],["exhibition",131.26,131.64],["centre",131.64,132.28],["from",132.28,133.04],["the",133.04,133.22],["10th",133.22,133.68],["to",133.68,133.96],["the",133.96,134.08],["15th",134.08,134.86],["of",134.86,134.96],["September.",134.96,135.44]]},{"start":135.44,"end":143.04,"text":"September. I