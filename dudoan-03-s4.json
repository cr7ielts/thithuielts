.58,324.9],["introduce",324.9,325.34],["the",325.34,325.62]]},{"start":325.62,"end":327.62,"text":"project to anyone who might be interested.","words":[["project",325.62,326.06],["to",326.06,326.3],["anyone",326.3,326.72],["who",326.72,326.92],["might",326.92,327.1],["be",327.1,327.28],["interested.",327.28,327.62]]},{"start":328.64,"end":334.98,"text":"Later in the month, we'll be asking you to submit a short essay letting us know why you feel you","words":[["Later",328.64,329.2],["in",329.2,329.38],["the",329.38,329.46],["month,",329.46,329.68],["we'll",330.04,330.32],["be",330.32,330.44],["asking",330.44,330.78],["you",330.78,331.06],["to",331.06,331.16],["submit",331.16,331.44],["a",331.44,331.62],["short",331.62,331.8],["essay",331.8,332.24],["letting",332.24,332.92],["us",332.92,333.16],["know",333.16,333.44],["why",333.44,334.08],["you",334.08,334.34],["feel",334.34,334.6],["you",334.6,334.98]]},{"start":334.98,"end":341.08,"text":"should be chosen to take part in the project. You'll need to tell us about any particular skills","words":[["should",334.98,335.18],["be",335.18,335.32],["chosen",335.32,335.76],["to",335.76,336.02],["take",336.02,336.22],["part",336.22,336.5],["in",336.5,336.62],["the",336.62,336.7],["project.",336.7,337.08],["You'll",337.72,338.22],["need",338.22,338.42],["to",338.42,338.62],["tell",338.62,338.78],["us",338.78,339.06],["about",339.06,339.38],["any",339.38,339.82],["particular",339.82,340.38],["skills",340.38,341.08]]},{"start":341.08,"end":346.22,"text":"that you have and can bring to the team and any experience you may have had in the field.","words":[["that",341.08,341.4],["you",341.4,341.52],["have",341.52,341.82],["and",341.82,342.6],["can",342.6,342.82],["bring",342.82,343.04],["to",343.04,343.22],["the",343.22,343.34],["team",343.34,343.68],["and",343.68,344.26],["any",344.26,344.5],["experience",344.5,345.0],["you",345.0,345.34],["may",345.34,345.44],["have",345.44,345.56],["had",345.56,345.76],["in",345.76,345.86],["the",345.86,345.96],["field.",345.96,346.22]]},{"start":347.06,"end":353.7,"text":"Then, in June, we're organizing a trip to a factory to chat over some design considerations","words":[["Then,",347.06,347.56],["in",347.88,348.16],["June,",348.16,348.5],["we're",349.04,349.22],["organizing",349.22,349.66],["a",349.66,350.0],["trip",350.0,350.14],["to",350.14,350.34],["a",350.34,350.5],["factory",350.5,350.94],["to",350.94,351.7],["chat",351.7,351.94],["over",351.94,352.18],["some",352.18,352.46],["design",352.46,352.9],["considerations",352.9,353.7]]},{"start":353.7,"end":359.36,"text":"with specialists there who have kindly agreed to act as consultants throughout the project.","words":[["with",353.7,354.44],["specialists",354.44,355.12],["there",355.12,355.64],["who",355.64,356.28],["have",356.28,356.48],["kindly",356.48,356.84],["agreed",356.84,357.18],["to",357.18,357.4],["act",357.4,357.58],["as",357.58,357.74],["consultants",357.74,358.28],["throughout",358.28,358.72],["the",358.72,358.98],["project.",358.98,359.36]]},{"start":360.02,"end":362.96,"text":"Then at the beginning of the next semester in September,","words":[["Then",360.02,360.64],["at",360.64,360.78],["the",360.78,360.86],["beginning",360.86,361.1],["of",361.1,361.36],["the",361.36,361.46],["next",361.46,361.66],["semester",361.66,362.14],["in",362.14,362.5],["September,",362.5,362.96]]},{"start":363.8,"end":369.9,"text":"we thought we'd hold a weekend workshop to share ideas and see computer-aided design demonstrations.","words":[["we",363.8,364.06],["thought",364.06,364.36],["we'd",364.36,364.62],["hold",364.62,364.82],["a",364.82,365.0],["weekend",365.0,365.32],["workshop",365.32,365.98],["to",365.98,366.28],["share",366.28,366.58],["ideas",366.58,367.16],["and",367.16,367.72],["see",367.72,367.96],["computer",367.96,368.46],["-aided",368.46,368.86],["design",368.86,369.28],["demonstrations.",369.28,369.9]]},{"start":370.74,"end":374.64,"text":"We have a brand new package which sponsors have kindly fi