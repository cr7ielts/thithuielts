4.34]]},{"start":274.9,"end":275.58,"text":"Absolutely.","words":[["Absolutely.",274.9,275.58]]},{"start":276.32,"end":282.04,"text":"I found out that Mexico celebrates the fact that it produces a huge number of varieties","words":[["I",276.32,276.6],["found",276.6,276.94],["out",276.94,277.2],["that",277.2,277.46],["Mexico",277.46,277.92],["celebrates",277.92,278.54],["the",278.54,278.88],["fact",278.88,279.2],["that",279.2,279.4],["it",279.4,279.56],["produces",279.56,279.96],["a",279.96,280.38],["huge",280.38,280.78],["number",280.78,281.2],["of",281.2,281.5],["varieties",281.5,282.04]]},{"start":282.04,"end":287.32,"text":"and people flocked to this special event to taste dishes using them.","words":[["and",282.04,283.12],["people",283.12,283.98],["flocked",283.98,284.46],["to",284.46,284.58],["this",284.58,284.72],["special",284.72,285.12],["event",285.12,285.42],["to",285.42,285.7],["taste",285.7,286.04],["dishes",286.04,286.5],["using",286.5,286.94],["them.",286.94,287.32]]},{"start":288.08,"end":293.76,"text":"A lot of people think of Mexico as being the best place to see fantastic museums.","words":[["A",288.08,288.3],["lot",288.3,288.52],["of",288.52,288.68],["people",288.68,288.96],["think",288.96,289.32],["of",289.32,289.5],["Mexico",289.5,289.96],["as",289.96,290.62],["being",290.62,290.88],["the",290.88,291.08],["best",291.08,291.4],["place",291.4,291.76],["to",291.76,292.04],["see",292.04,292.28],["fantastic",292.28,292.76],["museums.",292.76,293.76]]},{"start":294.94,"end":297.72,"text":"That's true, but let's take a different tact.","words":[["That's",294.94,295.56],["true,",295.56,295.84],["but",296.24,296.46],["let's",296.46,296.72],["take",296.72,296.88],["a",296.88,297.06],["different",297.06,297.32],["tact.",297.32,297.72]]},{"start":298.32,"end":302.72,"text":"What about Greece, one of the world's most famous countries for tourists?","words":[["What",298.32,298.52],["about",298.52,298.76],["Greece,",298.76,299.22],["one",299.8,300.08],["of",300.08,300.24],["the",300.24,300.36],["world's",300.36,300.82],["most",300.82,300.94],["famous",300.94,301.38],["countries",301.38,301.98],["for",301.98,302.28],["tourists?",302.28,302.72]]},{"start":303.18,"end":307.32,"text":"Yes, and I think we should go for the ruins in this case.","words":[["Yes,",303.18,303.6],["and",304.04,304.3],["I",304.3,304.72],["think",304.72,304.96],["we",304.96,305.2],["should",305.2,305.42],["go",305.42,305.66],["for",305.66,305.86],["the",305.86,306.0],["ruins",306.0,306.4],["in",306.4,306.7],["this",306.7,306.96],["case.",306.96,307.32]]},{"start":307.96,"end":311.54,"text":"The temples and theaters and so on, rather than the food.","words":[["The",307.96,308.16],["temples",308.16,308.58],["and",308.58,308.88],["theaters",308.88,309.28],["and",309.28,309.64],["so",309.64,309.94],["on,",309.94,310.26],["rather",310.4,310.7],["than",310.7,311.02],["the",311.02,311.2],["food.",311.2,311.54]]},{"start":311.54,"end":321.92,"text":"And for Britain, instead of focusing on the countryside and parks, I'd like to find out more about why people go to see plays and musicals.","words":[["And",311.54,312.54],["for",312.54,312.86],["Britain,",312.86,313.24],["instead",313.76,314.12],["of",314.12,314.36],["focusing",314.36,314.7],["on",314.7,315.18],["the",315.18,315.34],["countryside",315.34,315.76],["and",315.76,316.24],["parks,",316.24,316.66],["I'd",317.08,317.34],["like",317.34,317.44],["to",317.44,317.62],["find",317.62,317.86],["out",317.86,318.12],["more",318.12,318.4],["about",318.4,318.7],["why",318.7,319.1],["people",319.1,319.5],["go",319.5,319.94],["to",319.94,320.2],["see",320.2,320.42],["plays",320.42,320.82],["and",320.82,321.06],["musicals.",321.06,321.92]]},{"start":322.34,"end":324.46,"text":"Is it because they're such a good choice?","words":[["Is",322.34,322.56],["it",322.56,322.74],["because",322.74,323.08],["they're",323.08,323.44],["such",323.44,323.72],["a",323.72,323.88],["good",323.88,324.04],["choice?",324.04,324.46]]},{"s