9.17],["that",299.17,299.35],["there",299.35,299.53]]},{"start":299.53,"end":304.67,"text":"are several advantages, but he really loves the way it helps him think clearly and takes","words":[["are",299.53,299.65],["several",299.65,299.93],["advantages,",299.93,300.49],["but",300.93,301.09],["he",301.09,301.39],["really",301.39,301.77],["loves",301.77,302.05],["the",302.05,302.27],["way",302.27,302.43],["it",302.43,302.59],["helps",302.59,302.85],["him",302.85,303.03],["think",303.03,303.41],["clearly",303.41,303.97],["and",303.97,304.39],["takes",304.39,304.67]]},{"start":304.67,"end":307.15,"text":"his mind off any worries he has. Great.","words":[["his",304.67,304.85],["mind",304.85,305.15],["off",305.15,305.35],["any",305.35,305.47],["worries",305.47,305.79],["he",305.79,306.05],["has.",306.05,306.29],["Great.",306.81,307.15]]},{"start":307.97,"end":311.03,"text":"What about you? Have you got notes about Saira?","words":[["What",307.97,308.39],["about",308.39,308.59],["you?",308.59,308.89],["Have",309.45,309.59],["you",309.59,309.71],["got",309.71,309.89],["notes",309.89,310.25],["about",310.25,310.49],["Saira?",310.49,311.03]]},{"start":311.03,"end":318.43,"text":"Yes, I spoke to her last week. She lives in the countryside and she loves being on her","words":[["Yes,",311.03,312.21],["I",312.65,312.79],["spoke",312.79,313.05],["to",313.05,313.29],["her",313.29,313.45],["last",313.45,313.73],["week.",313.73,314.03],["She",314.65,315.25],["lives",315.25,315.69],["in",315.69,315.87],["the",315.87,315.97],["countryside",315.97,316.33],["and",316.33,317.25],["she",317.25,317.53],["loves",317.53,317.83],["being",317.83,318.07],["on",318.07,318.27],["her",318.27,318.43]]},{"start":318.43,"end":323.11,"text":"bike in the open air and enjoying the beautiful environment and landscape around her.","words":[["bike",318.43,318.71],["in",318.71,318.87],["the",318.87,318.99],["open",318.99,319.25],["air",319.25,319.63],["and",319.63,320.01],["enjoying",320.01,320.43],["the",320