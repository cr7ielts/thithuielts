0.68,61.04],["to",61.04,61.26],["look",61.26,61.38],["at",61.38,61.5],["questions",61.5,61.88],["one",61.88,62.4],["to",62.4,62.66],["eight.",62.66,62.98],["Now",103.38,103.72],["listen",103.72,104.02],["carefully",104.02,104.52],["and",104.52,104.88],["answer",104.88,105.22]]},{"start":105.22,"end":106.9,"text":"questions one to eight.","words":[["questions",105.22,105.76],["one",105.76,106.3],["to",106.3,106.54],["eight.",106.54,106.9]]},{"start":110.3,"end":111.66,"text":"Hello, can I help you?","words":[["Hello,",110.3,110.78],["can",111.08,111.18],["I",111.18,111.28],["help",111.28,111.48],["you?",111.48,111.66]]},{"start":111.94,"end":117.1,"text":"Yes, I'd like to send this package to the USA urgently, but I'm not sure what the best","words":[["Yes,",111.94,112.24],["I'd",112.46,112.66],["like",112.66,112.8],["to",112.8,112.98],["send",112.98,113.18],["this",113.18,113.4],["package",113.4,113.72],["to",113.72,113.94],["the",113.94,114.06],["USA",114.06,114.48],["urgently,",114.48,115.18],["but",115.66,115.88],["I'm",115.88,116.04],["not",116.04,116.16],["sure",116.16,116.46],["what",116.46,116.7],["the",116.7,116.84],["best",116.84,117.1]]},{"start":117.1,"end":118.2,"text":"way of sending it is.","words":[["way",117.1,117.3],["of",117.3,117.4],["sending",117.4,117.74],["it",117.74,117.96],["is.",117.96,118.2]]},{"start":118.36,"end":120.82,"text":"Well, first of all, when does it need to get there?","words":[["Well,",118.36,118.62],["first",118.82,119.12],["of",119.12,119.34],["all,",119.34,119.48],["when",119.6,119.72],["does",119.72,119.9],["it",119.9,120.02],["need",120.02,120.18],["to",120.18,120.34],["get",120.34,120.52],["there?",120.52,120.82]]},{"start":121.1,"end":127.48,"text":"Well, it's Tuesday today. It's absolutely got to be there by Friday. Ideally, I'd","words":[["Well,",121.1,121.5],["it's",121.74,122.06],["Tuesday",122.06,122.38],["today.",122.38,123.0],["It's",123.5,123.7],["absolutely",123.7,124.24],["got",124.24,124.72],["to",124.72,124.9],["be",124.9,125.0],["there",125.0,125.18],["by",125.18,125.36],["Friday.",125.36,125.86],["Ideally,",126.66,127.14],["I'd",127.28,127.48]]},{"start":127.48,"end":130.98,"text":"like it to be there by Thursday but I realise that might be difficult.","words":[["like",127.48,127.66],["it",127.66,127.76],["to",127.76,127.84],["be",127.84,127.94],["there",127.94,128.1],["by",128.1,128.24],["Thursday",128.24,128.8],["but",128.8,129.36],["I",129.36,129.5],["realise",129.5,129.86],["that",129.86,130.2],["might",130.2,130.46],["be",130.46,130.64],["difficult.",130.64,130.98]]},{"start":131.2,"end":136.24,"text":"Okay, well there's Courier Post but that takes four working days so that would be next Monday","words":[["Okay,",131.2,131.54],["well",131.88,132.04],["there's",132.04,132.42],["Courier",132.42,132.78],["Post",132.78,133.06],["but",133.06,133.42],["that",133.42,133.6],["takes",133.6,133.88],["four",133.88,134.2],["working",134.2,134.56],["days",134.56,134.88],["so",134.88,135.12],["that",135.12,135.26],["would",135.26,135.38],["be",135.38,135.54],["next",135.54,135.78],["Monday",135.78,136.24]]},{"start":136.24,"end":140.8,"text":"or a slightly more expensive service called International Express which will get there","words":[["or",136.24,136.86],["a",136.86,137.02],["slightly",137.02,137.24],["more",137.24,137.48],["expensive",137.48,137.96],["service",137.96,138.46],["called",138.46,138.7],["International",138.7,139.22],["Express",139.22,139.8],["which",139.8,140.34],["will",140.34,140.48],["get",140.48,140.62],["there",140.62,140.8]]},{"start":140.8,"end":141.88,"text":"in three working days.","words":[["in",140.8,140.94],["three",140.94,141.18],["working",141.18,141.5],["days.",141.5,141.88]]},{"start":142.44,"end":146.96,"text":"Okay, I'll use that then. It's really got to be there as quickly as possible.","words":[["Okay,",142.44,142.92],["I'll",143.26,143.5],["use",143.5,143.72],["that",143.72,143.98],["then.",143.98,144.22],["It's",144.78,145.02],["really",145.02,145.22],["got",145.22,145.48],["to",145.48,145.66],["be",145.66,145.76],["there",145.76,145.92],["as",145.92,146.06],["quickly",146.06,146.36],["as",146.36,146.6],["possible.",146.6,146.96]]},{"start":147.2,"end":150.22,"text":"Okay, can I just take some details from you for the form?","words":[["Okay,",147.2,147.48],["can",148.06,148.22],["I",148.22,148.3],["just",148.3,148.5],["take",148.5,148.7],["some",148.7,148.86],["details",148.86,149.18],["from",149.18,149.5],["you",149.5,149.66],["for",149.66,149.82],["the",149.82,149.94],["form?",149.94,150.22]]},{"start":150.9,"end":152.06,"text":"First of all, what's your name?","words":[["First",150.9,150.9],["of",150.9,151.14],["all,",151.14,151.32],["what's",151.42,151.68],["your",151.68,151.76],["name?",151.76,152.06]]},{"start":152.52,"end":153.28,"text":"Peter White.","words":[["Peter",152.52,152.86],["White.",152.86,153.28]]},{"start":153.52,"end":154.16,"text":"And your address?","words":[["And",153.52,153.72],["your",153.72,153.84],["address?",153.84,154.16]]},{"start":154.96,"end":156.46,"text":"14 Mountain Road.","words":[["14",154.96,155.44],["Mountain",155.44,155.92],["Road.",155.92,156.46]]},{"start":156.46,"end":162.0,"text":"and where's that that's in Lakeview okay now who are you sending the package to","words":[["and",156.46,157.06],["where's",157.06,157.42],["that",157.42,157.66],["that's",157.66,158.3],["in",158.3,158.4],["Lakeview",158.4,159.02],["okay",159.02,159.9],["now",159.9,160.26],["who",160.26,160.64],["are",160.64,160.84],["you",160.84,160.94],["sending",160.94,161.12],["the",161.12,161.32],["package",161.32,161.54],["to",161.54,162.0]]},{"start":162.0,"end":170.18,"text":"and Anna Hillman that's H I double L M A N and what's the address apartment 228","words":[["and",162.0,162.5],["Anna",162.5,163.08],["Hillman",163.08,163.6],["that's",163.6,164.34],["H",164.34,164.72],["I",164.72,165.04],["double",165.04,165.34],["L",165.34,165.62],["M",165.62,166.06],["A",166.06,166.4],["N",166.4,