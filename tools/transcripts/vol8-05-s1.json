{"id":"vol8-05","section":1,"path":"bank/listening/vol8-05/audio-1.m4a","model":"small","duration":562.27,"segments":[{"start":0.0,"end":3.56,"text":"IELTS Listening, version 59374.","words":[["IELTS",0.0,0.16],["Listening,",0.16,0.4],["version",1.02,1.36],["59374.",1.36,3.56]]},{"start":5.1,"end":10.62,"text":"You will hear a number of different recordings, and you will have to answer questions on what","words":[["You",5.1,5.42],["will",5.42,5.58],["hear",5.58,5.8],["a",5.8,5.98],["number",5.98,6.32],["of",6.32,6.56],["different",6.56,6.88],["recordings,",6.88,7.48],["and",8.06,8.32],["you",8.32,8.48],["will",8.48,8.58],["have",8.58,8.78],["to",8.78,8.94],["answer",8.94,9.26],["questions",9.26,9.92],["on",9.92,10.36],["what",10.36,10.62]]},{"start":10.62,"end":11.22,"text":"you hear.","words":[["you",10.62,10.84],["hear.",10.84,11.22]]},{"start":12.42,"end":17.72,"text":"There will be time for you to read the instructions and questions, and you will have a chance","words":[["There",12.42,12.74],["will",12.74,12.88],["be",12.88,13.06],["time",13.06,13.42],["for",13.42,13.68],["you",13.68,13.82],["to",13.82,13.92],["read",13.92,14.26],["the",14.26,14.5],["instructions",14.5,15.04],["and",15.04,15.4],["questions,",15.4,15.8],["and",16.46,16.9],["you",16.9,17.06],["will",17.06,17.16],["have",17.16,17.34],["a",17.34,17.48],["chance",17.48,17.72]]},{"start":17.72,"end":18.86,"text":"to check your work.","words":[["to",17.72,17.94],["check",17.94,18.26],["your",18.26,18.48],["work.",18.48,18.86]]},{"start":19.74,"end":22.92,"text":"All the recordings will be played once only.","words":[["All",19.74,19.96],["the",19.96,20.1],["recordings",20.1,20.52],["will",20.52,21.2],["be",21.2,21.36],["played",21.36,21.76],["once",21.76,22.2],["only.",22.2,22.92]]},{"start":24.32,"end":27.0,"text":"The test is in four sections.","words":[["The",24.32,24.64],["test",24.64,25.08],["is",25.08,25.82],["in",25.82,25.98],["four",25.98,26.36],["sections.",26.36,27.0]]},{"start":27.0,"end":34.