{"id":"vol8-05","section":2,"path":"bank/listening/vol8-05/audio-2.m4a","model":"small","duration":406.77,"segments":[{"start":0.0,"end":3.1,"text":"Now turn to section 2 on page 3.","words":[["Now",0.0,0.22],["turn",0.22,0.52],["to",0.52,0.74],["section",0.74,1.02],["2",1.02,1.6],["on",1.6,2.18],["page",2.18,2.52],["3.",2.52,3.1]]},{"start":5.74,"end":6.52,"text":"Section 2.","words":[["Section",5.74,5.94],["2.",5.94,6.52]]},{"start":7.62,"end":12.54,"text":"You will hear the store manager of a bookshop give a short talk to new staff.","words":[["You",7.62,7.84],["will",7.84,8.02],["hear",8.02,8.22],["the",8.22,8.4],["store",8.4,8.72],["manager",8.72,9.08],["of",9.08,9.4],["a",9.4,9.54],["bookshop",9.54,10.02],["give",10.02,10.66],["a",10.66,10.8],["short",10.8,11.16],["talk",11.16,11.62],["to",11.62,11.92],["new",11.92,12.16],["staff.",12.16,12.54]]},{"start":13.52,"end":18.74,"text":"First you have some time to look at questions 11 to 16 on page 3.","words":[["First",13.52,14.04],["you",14.04,14.26],["have",14.26,14.4],["some",14.4,14.58],["time",14.58,14.96],["to",14.96,15.2],["look",15.2,15.32],["at",15.32,15.46],["questions",15.46,15.74],["11",15.74,16.3],["to",16.3,16.54],["16",16.54,17.06],["on",17.06,17.9],["page",17.9,18.24],["3.",18.24,18.74]]},{"start":49.26,"end":52.88,"text":"Now listen carefully and answer questions 11 to 16.","words":[["Now",49.26,49.56],["listen",49.56,49.92],["carefully",49.92,50.34],["and",50.34,50.7],["answer",50.7,51.12],["questions",51.12,51.56],["11",51.56,52.14],["to",52.14,52.38],["16.",52.38,52.88]]},{"start":56.57,"end":57.77,"text":"Good evening everyone.","words":[["Good",56.57,56.91],["evening",56.91,57.25],["everyone.",57.25,57.77]]},{"start":58.39,"end":59.37,"text":"Thanks for coming in.","words":[["Thanks",58.39,58.71],["for",58.71,58.87],["coming",58.87,59.11],["in.",59.11,59.37]]},{"start":60.11,"end":61.01,"text":"This won't take long.","words":[["This",60.11,60.31],["won't",60.31,60.55],["take",60.55,60.77],["lo