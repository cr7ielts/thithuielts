],["near",180.98,181.24],["tall",181.24,181.62],["structures,",181.62,182.32],["such",182.72,183.02],["as",183.02,183.26],["radio",183.26,183.7],["transmitters.",183.7,184.42],["In",185.26,185.54],["the",185.54,185.66],["past,",185.66,185.98],["the",186.42,186.58],["most",186.58,186.78],["usual",186.78,187.26]]},{"start":187.26,"end":192.68,"text":"means of tracking the movements of birds at night were radar and thermal imaging. Now","words":[["means",187.26,187.52],["of",187.52,187.72],["tracking",187.72,188.02],["the",188.02,188.26],["movements",188.26,188.54],["of",188.54,188.84],["birds",188.84,189.1],["at",189.1,189.3],["night",189.3,189.54],["were",189.54,189.84],["radar",189.84,190.28],["and",190.28,190.68],["thermal",190.68,191.08],["imaging.",191.08,191.42],["Now",192.36,192.68]]},{"start":192.68,"end":197.54,"text":"But the problem was that these methods were expensive because someone had to control the","words":[["But",192.68,192.76],["the",192.76,192.9],["problem",192.9,193.2],["was",193.2,193.5],["that",193.5,194.16],["these",194.16,194.4],["methods",194.4,194.82],["were",194.82,195.16],["expensive",195.16,195.78],["because",195.78,196.36],["someone",196.36,196.7],["had",196.7,196.9],["to",196.9,197.02],["control",197.02,197.36],["the",197.36,197.54]]},{"start":197.54,"end":199.08,"text":"devices all through the night.","words":[["devices",197.54,197.98],["all",197.98,198.38],["through",198.38,198.64],["the",198.64,198.82],["night.",198.82,199.08]]},{"start":199.86,"end":202.74,"text":"And in addition to this, they weren't really reliable.","words":[["And",199.86,200.08],["in",200.08,200.2],["addition",200.2,200.52],["to",200.52,200.72],["this,",200.72,200.92],["they",201.36,201.58],["weren't",201.58,201.92],["really",201.92,202.22],["reliable.",202.22,202.74]]},{"start":203.36,"end":207.36,"text":"So the researchers looked for an alternative that didn't need human intervention.","words":[["So",203.36,203.68],["the",203.68,203.86],["researchers",203.86,