{"id":"vol8-04","section":3,"path":"bank/listening/vol8-04/audio-3.m4a","model":"small","duration":393.51,"segments":[{"start":0.0,"end":3.26,"text":"Now turn to section 3 on page 5.","words":[["Now",0.0,0.26],["turn",0.26,0.56],["to",0.56,0.76],["section",0.76,1.0],["3",1.0,1.58],["on",1.58,2.3],["page",2.3,2.58],["5.",2.58,3.26]]},{"start":5.76,"end":6.5,"text":"Section 3.","words":[["Section",5.76,5.94],["3.",5.94,6.5]]},{"start":7.68,"end":14.14,"text":"You'll hear a student talking to a tutor at her college about the possibility of changing her course.","words":[["You'll",7.68,7.98],["hear",7.98,8.18],["a",8.18,8.36],["student",8.36,8.78],["talking",8.78,9.44],["to",9.44,9.7],["a",9.7,9.86],["tutor",9.86,10.1],["at",10.1,10.4],["her",10.4,10.52],["college",10.52,11.0],["about",11.0,11.74],["the",11.74,11.96],["possibility",11.96,12.54],["of",12.54,12.94],["changing",12.94,13.36],["her",13.36,13.64],["course.",13.64,14.14]]},{"start":15.06,"end":20.68,"text":"First you have some time to look at questions 21 to 24 on page 5.","words":[["First",15.06,15.7],["you",15.7,15.94],["have",15.94,16.08],["some",16.08,16.24],["time",16.24,16.62],["to",16.62,16.88],["look",16.88,17.02],["at",17.02,17.16],["questions",17.16,17.44],["21",17.44,18.22],["to",18.22,18.5],["24",18.5,19.1],["on",19.1,19.88],["page",19.88,20.14],["5.",20.14,20.68]]},{"start":35.83,"end":39.79,"text":"Now listen carefully and answer questions 21 to 24.","words":[["Now",35.83,36.13],["listen",36.13,36.45],["carefully",36.45,36.91],["and",36.91,37.29],["answer",37.29,37.65],["questions",37.65,38.05],["21",38.05,38.91],["to",38.91,39.19],["24.",39.19,39.79]]},{"start":43.22,"end":45.22,"text":"Ah, hello. Do come in.","words":[["Ah,",43.22,43.72],["hello.",44.0,44.24],["Do",44.76,44.9],["come",44.9,45.1],["in.",45.1,45.22]]},{"start":45.48,"end":45.8,"text":"Thanks.","words":[["Thanks.",45.48,45.8]]},{"start":45.8,"end":52.2,"text":"I understand you wanted to see me about changing courses yes that's rig