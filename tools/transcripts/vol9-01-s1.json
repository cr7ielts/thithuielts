89],["been",115.89,116.05],["written",116.05,116.29],["in",116.29,116.53],["the",116.53,116.63],["space",116.63,116.93]]},{"start":118.49,"end":124.93,"text":"Now we shall begin. You should answer the questions as you listen because you will not hear the","words":[["Now",118.49,119.01],["we",119.01,119.23],["shall",119.23,119.39],["begin.",119.39,119.79],["You",120.69,120.85],["should",120.85,121.01],["answer",121.01,121.29],["the",121.29,121.47],["questions",121.47,121.87],["as",121.87,122.35],["you",122.35,122.55],["listen",122.55,122.89],["because",122.89,123.69],["you",123.69,123.99],["will",123.99,124.13],["not",124.13,124.41],["hear",124.41,124.77],["the",124.77,124.93]]},{"start":124.93,"end":131.01,"text":"recording a second time. Listen carefully and answer questions one to five.","words":[["recording",124.93,125.39],["a",125.39,125.79],["second",125.79,126.05],["time.",126.05,126.53],["Listen",127.43,127.95],["carefully",127.95,128.39],["and",128.39,129.05],["answer",129.05,129.47],["questions",129.47,130.01],["one",130.01,130.41],["to",130.41,130.61],["five.",130.61,131.01]]},{"start":134.72,"end":137.32,"text":"Hi, I'm Jim. I'm here about the room.","words":[["Hi,",134.72,135.2],["I'm",135.5,135.72],["Jim.",135.72,135.9],["I'm",136.46,136.66],["here",136.66,136.8],["about",136.8,136.98],["the",136.98,137.12],["room.",137.12,137.32]]},{"start":137.78,"end":141.5,"text":"Hi, I'm Peter. We talked on the phone, didn't we? Come on in.","words":[["Hi,",137.78,138.14],["I'm",138.3,138.44],["Peter.",138.44,138.74],["We",139.34,139.6],["talked",139.6,139.84],["on",139.84,140.02],["the",140.02,140.1],["phone,",140.1,140.38],["didn't",140.48,140.6],["we?",140.6,140.8],["Come",141.06,141.26],["on",141.26,141.4],["in.",141.4,141.5]]},{"start":141.86,"end":145.74,"text":"Great. I just need to find out a few things before I make up my mind.","words":[["Great.",141.86,142.2],["I",142.7,143.04],["just",143.04,143.24],["need",143.24,143.4],["to",143.4,143.56],["find",143.56,143.68],["out",143.68,143.88],["a",143.88,144.04],["few",144.04,144.28],["things",144.28,144.62],["before",144.62,144.94],["I",144.94,145.08],["make",145.08,145.22],["up",145.22,145.34],["my",145.34,145.48],["mind.",145.48,145.74]]},{"start":145.74,"end":146.4,"text":"OK.","words":[["OK.",145.74,146.4]]},{"start":147.18,"end":150.0,"text":"Well, first of all, I wasn't quite clear about the rent.","words":[["Well,",147.18,147.36],["first",147.66,147.94],["of",147.94,148.14],["all,",148.14,148.34],["I",148.54,148.72],["wasn't",148.72,148.96],["quite",148.96,149.2],["clear",149.2,149.44],["about",149.44,149.62],["the",149.62,149.76],["rent.",149.76,150.0]]},{"start":150.4,"end":152.38,"text":"It depends on the room you have.","words":[["It",150.4,150.76],["depends",150.76,151.28],["on",151.28,151.54],["the",151.54,151.66],["room",151.66,151.9],["you",151.9,152.1],["have.",152.1,152.38]]},{"start":152.9,"end":156.36,"text":"I have the large bedrooms, so I pay $110 a week.","words":[["I",152.9,153.1],["have",153.1,153.26],["the",153.26,153.42],["large",153.42,153.78],["bedrooms,",153.78,154.22],["so",154.44,154.58],["I",154.58,154.72],["pay",154.72,154.94],["$110",154.94,155.42],["a",155.42,156.18],["week.",156.18,156.36]]},{"start":157.08,"end":159.6,"text":"Yours is $80 because it's a bit smaller.","words":[["Yours",157.08,157.36],["is",157.36,157.7],["$80",157.7,158.14],["because",158.14,158.8],["it's",158.8,159.04],["a",159.04,159.12],["bit",159.12,159.22],["smaller.",159.22,159.6]]},{"start":160.24,"end":160.92,"text":"That's not too bad.","words":[["That's",160.24,160.42],["not",160.42,160.56],["too",160.56,160.68],["bad.",160.68,160.92]]},{"start":161.44,"end":164.52,"text":"The last place I was in was $100 a week, and it was much smaller.","words":[["The",161.44,161.64],["last",161.64,161.82],["place",161.82,161.98],["I",161.98,162.18],["was",162.18,162.28],["in",162.28,162.38],["was",162.38,162.5],["$100",162.5,162.94],["a",162.94,163.42],["week,",163.42,163.56],["and",163.64,163.74],["it",163.74,163.8],["was",163.8,163.9],["much",163.9,164.1],["smaller.",164.1,164.52]]},{"start":165.42,"end":167.02,"text":"And it seems like a good location.","words":[["And",165.42,165.42],["it",165.42,165.82],["seems",165.82,166.04],["like",166.04,166.24],["a",166.24,166.34],["good",166.34,166.5],["location.",166.5,167.02]]},{"start":167.46,"end":167.72,"text":"Yeah.","words":[["Yeah.",167.46,167.72]]},{"start":168.36,"end":169.58,"text":"And the shops are pretty close.","words":[["And",168.36,168.56],["the",168.56,168.66],["shops",168.66,168.86],["are",168.86,169.06],["pretty",169.06,169.22],["close.",169.22,169.58]]},{"start":170.12,"end":172.86,"text":"The only thing is it's not very good for public transport.","words":[["The",170.12,170.26],["only",170.26,170.48],["thing",170.48,170.78],["is",170.78,171.12],["it's",171.12,171.38],["not",171.38,171.5],["very",171.5,171.7],["good",171.7,171.84],["for",171.84,172.0],["public",172.0,172.28],["transport.",172.28,172.86]]},{"start":173.32,"end":175.86,"text":"and the nearest bus stop is quite a walk.","words":[["and",173.32,173.76],["the",173.76,174.06],["nearest",174.06,174.28],["bus",174.28,174.6],["stop",174.6,174.98],["is",174.98,175.16],["quite",175.16,175.44],["a",175.44,175.56],["walk.",175.56,175.86]]},{"start":176.26,"end":177.84,"text":"That's not a problem. I've got a car.","words":[["That's",176.26,176.54],["not",176.54,176.64],["a",176.64,176.72],["problem.",176.72,176.98],["I've",177.22,177.36],["got",177.36,177.48],["a",177.48,177.62],["car.",177.62,177.84]]},{"start":178.5,"end":180.82,"text":"By the way, is there anywhere I can park?","words":[["By",178.5,178.94],["the",178.94,179.02],["way,",179.02,179.24],["is",179.44,179.64],["there",179.64,179.84],["anywhere",179.84,180.12],["I",180.12,180.34],["can",180.34,180.46],["park?",180.46,180.82]]},{"start":181.22,"end":183.84,"text":"Well, you're lucky because this house has a garage.","words":[["Well,",181.22,181.66],["you're",181.88,182.08],["lucky",182.08,182.34],["because",182.34,182.68],["this",182.68,182.94],["house",182.94,183.2],["has",183.2,183.42],["a",183.42,183.52],["garage.",183.52,183.84]]},{"start":184.6,"end":186.94,"text":"At the moment, there are some empty boxes in there,","words":[["At",184.6,184.8],["the",184.8,184.92],["moment,",184.92,185.22],["there",185.42,185.58],["are",185.58,185.7],["some",185.7,185.84],["empty",185.84,186.04],["boxes",186.04,186.46],["in",186.46,186.66],["there,",186.66,186.94]]},{"start":187.0,"end":188.8,"text":"but there's still plenty of room for your car.","words":[["but",187.0,187.22],["there's",187.22,187.46],["still",187.46,187.64],["plenty",187.64,187.88],["of",187.88,188.08],["room",188.08,188.22],["for",188.22,188.38],["your",188.38,188.48],["car.",188.48,188.8]]},{"start":189.58,"end":190.88,"text":"You can't park in the street.","words":[["You",189.58,189.74],["can't",189.74,190.04],["park",190.04,190.2],["in",190.2,190.36],["the",190.36,190.46],["street.",190.46,190.88]]},{"start":191.1,"end":194.64,"text":"It's zoned no parking, and the back lane is too narrow.","words":[["It's",191.1,191.34],["zoned",191.34,191.7],["no",191.7,191.94],["parking,",191.94,192.34],["and",192.58,193.08],["the",193.08,193.2],["back",193.2,193.4],["lane",193.4,193.72],["is",193.72,194.02],["too",194.02,194.36],["narrow.",194.36,194.64]]},{"start":195.26,"end":198.5,"text":"Fine. Now, what about phone calls?","words":[["Fine.",195.26,195.7],["Now,",196.38,196.82],["what",197.0,197.26],["about",197.26,197.48],["phone",197.48,198.14],["calls?",198.14,198.5]]},{"start":198.86,"end":201.18,"text":"I didn't see a phone in the hall when I came in.","words":[["I",198.86,199.3],["didn't",199.3,199.5],["see",199.5,199.68],["a",199.68,199.8],["phone",199.8,199.98],["in",199.98,200.12],["the",200.12,200.22],["hall",200.22,200.48],["when",200.48,200.66],["I",200.66,200.78],["came",200.78,200.98],["in.",200.98,201.18]]},{"start":201.66,"end":206.1,"text":"I've got a mobile which my friends usually call me on, but a phone in the house is useful.","words":[["I've",201.66,202.1],["got",202.1,202.18],["a",202.18,202.26],["mobile",202.26,202.48],["which",202.48,202.82],["my",202.82,202.98],["friends",202.98,203.24],["usually",203.24,203.58],["call",203.58,203.84],["me",203.84,204.0],["on,",204.0,204.16],["but",204.2,204.44],["a",204.44,204.76],["phone",204.76,204.92],["in",204.92,205.06],["the",205.06,205.16],["house",205.16,205.38],["is",205.38,205.74],["useful.",205.74,206.1]]},{"start":206.32,"end":211.02,"text":"Yeah, it's in the kitchen. It was in the living room, but it was hard to hear over the television.","words":[["Yeah,",206.32,206.64],["it's",206.82,207.26],["in",207.26,207.38],["the",207.38,207.46],["kitchen.",207.46,207.74],["It",208.1,208.32],["was",208.32,208.44],["in",208.44,208.6],["the",208.6,208.7],["living",208.7,208.86],["room,",208.86,209.24],["but",209.26,209.4],["it",209.4,209.5],["was",209.5,209.6],["hard",209.6,209.84],["to",209.84,210.0],["hear",210.0,210.2],["over",210.2,210.44],["the",210.44,210.56],["television.",210.56,211.02]]},{"start":211.56,"end":213.7,"text":"Oh, and we pay for our own calls.","words":[["Oh,",211.56,212.0],["and",212.02,212.12],["we",212.12,212.28],["pay",212.28,212.58],["for",212.58,212.78],["our",212.78,213.0],["own",213.0,213.22],["calls.",213.22,213.7]]},{"start":214.06,"end":216.72,"text":"That's fair enough. And what about my room?","words":[["That's",214.06,214.46],["fair",214.46,214.62],["enough.",214.62,214.8],["And",215.32,215.76],["what",215.76,216.12],["about",216.12,216.28],["my",216.28,216.48],["room?",216.48,216.72]]},{"start":217.62,"end":221.44,"text":"Yes, we'll go up and look in a minute. It's at the front of the house.","words":[["Yes,",217.62,217.98],["we'll",218.16,218.48],["go",218.48,218.62],["up",218.62,218.82],["and",218.82,218.94],["look",218.94,219.1],["in",219.1,219.24],["a",219.24,219.32],["minute.",219.32,219.5],["It's",220.06,220.38],["at",220.38,220.48],["the",220.48,220.56],["front",220.56,220.8],["of",220.8,220.96],["the",220.96,221.08],["house.",221.08,221.44]]},{"start":221.7,"end":225.26,"text":"It's a nice room and there's a cupboard and desk in there already.","words":[["It's",221.7,222.04],["a",222.04,222.14],["nice",222.14,222.38],["room",222.38,222.76],["and",222.76,222.94],["there's",222.94,223.12],["a",223.12,223.22],["cupboard",223.22,223.5],["and",223.5,224.04],["desk",224.04,224.44],["in",224.44,224.64],["there",224.64,224.82],["already.",224.82,225.26]]},{"start":225.6,"end":229.78,"text":"But it does get quite cold at night in that room and it doesn't have a heater.","words":[["But",225.6,226.04],["it",226.04,226.18],["does",226.18,226.42],["get",226.42,226.6],["quite",226.6,226.82],["cold",226.82,227.18],["at",227.18,227.42],["night",227.42,227.66],["in",227.66,227.9],["that",227.9,228.06],["room",228.06,228.42],["and",228.42,228.8],["it",228.8,228.92],["doesn't",228.92,229.28],["have",229.28,229.42],["a",229.42,229.52],["heater.",229.52,229.78]]},{"start":229.78,"end":233.26,"text":"No problem. My friend has just given me one so I'll bring that.","words":[["No",229.78,230.56],["problem.",230.56,230.86],["My",231.2,231.46],["friend",231.46,231.68],["has",231.68,231.8],["just",231.8,231.94],["given",231.94,232.12],["me",232.12,232.26],["one",232.26,232.42],["so",232.42,232.64],["I'll",232.64,232.88],["bring",232.88,233.02],["that.",233.02,233.26]]},{"start":233.68,"end":236.78,"text":"He's gone travelling and has left me with a big box of things to mind.","words":[["He's",233.68,234.12],["gone",234.12,234.26],["travelling",234.26,234.66],["and",234.66,234.92],["has",234.92,235.04],["left",235.04,235.18],["me",235.18,235.32],["with",235.32,235.46],["a",235.46,235.56],["big",235.56,235.68],["box",235.68,236.0],["of",236.0,236.18],["things",236.18,236.32],["to",236.32,236.52],["mind.",236.52,236.78]]},{"start":237.92,"end":239.04,"text":"Anything else I can bring?","words":[["Anything",237.92,238.36],["else",238.36,238.62],["I",238.62,238.76],["can",238.76,238.86],["bring?",238.86,239.04]]},{"start":239.54,"end":243.78,"text":"Well, we've just got a microwave and my mother bought me a rice cooker.","words":[["Well,",239.54,239.98],["we've",240.14,240.5],["just",240.5,240.72],["got",240.72,240.96],["a",240.96,241.08],["microwave",241.08,241.46],["and",241.46,242.2],["my",242.2,242.36],["mother",242.36,242.6],["bought",242.6,242.9],["me",242.9,243.06],["a",243.06,243.16],["rice",243.16,243.48],["cooker.",243.48,243.78]]},{"start":244.28,"end":247.24,"text":"But it would be great if you had a toaster. Mine's just broken.","words":[["But",244.28,244.5],["it",244.5,244.58],["would",244.58,244.66],["be",244.66,244.8],["great",244.8,245.14],["if",245.14,245.32],["you",245.32,245.4],["had",245.4,245.52],["a",245.52,245.62],["toaster.",245.62,246.2],["Mine's",246.46,246.72],["just",246.72,246.84],["broken.",246.84,247.24]]},{"start":247.64,"end":248.54,"text":"I'll have a look in the box.","words":[["I'll",247.64,247.86],["have",247.86,248.0],["a",248.0,248.02],["look",248.02,248.1],["in",248.1,248.22],["the",248.22,248.3],["box.",248.3,248.54]]},{"start":252.08,"end":259.3,"text":"Before you hear the rest of the conversation, you have some time to look at questions 6 to 10 on page 2.","words":[["Before",252.08,252.52],["you",252.52,252.78],["hear",252.78,253.02],["the",253.02,253.2],["rest",253.2,253.42],["of",253.42,253.56],["the",253.56,253.64],["conversation,",253.64,254.16],["you",254.76,254.98],["have",254.98,255.2],["some",255.2,255.36],["time",255.36,255.78],["to",255.78,256.06],["look",256.06,256.18],["at",256.18,256.3],["questions",256.3,256.58],["6",256.58,257.16],["to",257.16,257.36],["10",257.36,257.78],["on",257.78,258.52],["page",258.52,258.8],["2.",258.8,259.3]]},{"start":259.3,"end":282.57,"text":"Now listen and answer questions six to ten.","words":[["Now",259.3,260.22],["listen",279.87,280.23],["and",280.23,280.65],["answer",280.65,281.05],["questions",281.05,281.47],["six",281.47,282.07],["to",282.07,282.27],["ten.",282.27,282.57]]},{"start":286.01,"end":291.33,"text":"One thing, I'm a keen sports fan and I usually watch the game on TV on Friday evening.","words":[["One",286.01,286.53],["thing,",286.53,286.79],["I'm",287.09,287.49],["a",287.49,287.61],["keen",287.61,287.75],["sports",287.75,288.09],["fan",288.09,288.53],["and",288.53,288.75],["I",288.75,289.05],["usually",289.05,289.27],["watch",289.27,289.53],["the",289.53,289.71],["game",289.71,289.89],["on",289.89,290.05],["TV",290.05,290.31],["on",290.31,290.55],["Friday",290.55,290.81],["evening.",290.81,291.33]]},{"start":291.81,"end":292.39,"text":"Would that be okay?","words":[["Would",291.81,291.93],["that",291.93,292.05],["be",292.05,292.15],["okay?",292.15,292.39]]},{"start":292.77,"end":293.99,"text":"Me too, so that's good.","words":[["Me",292.77,293.13],["too,",293.13,293.37],["so",293.47,293.61],["that's",293.61,293.81],["good.",293.81,293.99]]},{"start":294.37,"end":299.09,"text":"And I work at the supermarket on Tuesday and Thursday nights.","words":[["And",294.37,294.65],["I",294.65,295.67],["work",295.67,295.87],["at",295.87,296.03],["the",296.03,296.13],["supermarket",296.13,296.49],["on",296.49,297.21],["Tuesday",297.21,297.79],["and",297.79,298.39],["Thursday",298.39,298.73],["nights.",298.73,299.09]]},{"start":299.27,"end":300.93,"text":"Great, you can do the shopping then.","words":[["Great,",299.27,299.61],["you",299.91,300.11],["can",300.11,300.23],["do",300.23,300.31],["the",300.31,300.43],["shopping",300.43,300.67],["then.",300.67,300.93]]},{"start":301.51,"end":304.37,"text":"Do you have most of your lectures in the morning or afternoon?","words":[["Do",301.51,302.03],["you",302.03,302.17],["have",302.17,302.31],["most",302.31,302.51],["of",302.51,302.67],["your",302.67,302.77],["lectures",302.77,303.03],["in",303.03,303.29],["the",303.29,303.37],["morning",303.37,303.63],["or",303.63,303.91],["afternoon?",303.91,304.37]]},{"start":305.03,"end":306.11,"text":"In the afternoons, why?","words":[["In",305.03,305.23],["the",305.23,305.33],["afternoons,",305.33,305.79],["why?",305.81,306.11]]},{"start":306.53,"end":307.91,"text":"Mine are in the afternoons too.","words":[["Mine",306.53,306.93],["are",306.93,307.03],["in",307.03,307.11],["the",307.11,307.19],["afternoons",307.19,307.65],["too.",307.65,307.91]]},{"start":308.29,"end":310.37,"text":"You could give me a lift, we can share the petrol.","words":[["You",308.29,308.47],["could",308.47,308.55],["give",308.55,308.69],["me",308.69,308.81],["a",308.81,308.93],["lift,",308.93,309.15],["we",309.33,309.59],["can",309.59,309.77],["share",309.77,309.97],["the",309.97,310.09],["petrol.",310.09,310.37]]},{"start":310.37,"end":313.75,"text":"Good idea. When do you think I could move in?","words":[["Good",310.37,310.97],["idea.",310.97,311.29],["When",311.93,312.33],["do",312.33,312.83],["you",312.83,312.91],["think",312.91,313.01],["I",313.01,313.17],["could",313.17,313.31],["move",313.31,313.55],["in?",313.55,313.75]]},{"start":314.21,"end":321.31,"text":"Well, if you're interested and the rent is okay, I need someone by the 1st of June when the new rent period starts.","words":[["Well,",314.21,314.53],["if",314.79,314.97],["you're",314.97,315.11],["interested",315.11,315.51],["and",315.51,315.97],["the",315.97,316.11],["rent",316.11,316.27],["is",316.27,316.47],["okay,",316.47,316.85],["I",317.41,317.55],["need",317.55,317.71],["someone",317.71,318.07],["by",318.07,318.43],["the",318.43,318.55],["1st",318.55,318.99],["of",318.99,319.07],["June",319.07,319.57],["when",319.57,319.95],["the",319.95,320.07],["new",320.07,320.23],["rent",320.23,320.47],["period",320.47,320.85],["starts.",320.85,321.31]]},{"start":321.97,"end":330.07,"text":"Yes, that should be fine. The house seems big enough, the rent's reasonable. I've got an exam next week, so I'll move in after that if that's okay.","words":[["Yes,",321.97,322.25],["that",322.33,322.45],["should",322.45,322.51],["be",322.51,322.65],["fine.",322.65,322.97],["The",323.45,323.57],["house",323.57,323.71],["seems",323.71,323.99],["big",323.99,324.27],["enough,",324.27,324.55],["the",324.81,324.89],["rent's",324.89,325.19],["reasonable.",325.19,325.61],["I've",326.47,326.77],["got",326.77,326.95],["an",326.95,327.11],["exam",327.11,327.39],["next",327.39,327.73],["week,",327.73,327.97],["so",328.03,328.31],["I'll",328.31,328.79],["move",328.79,328.95],["in",328.95,329.07],["after",329.07,329.25],["that",329.25,329.47],["if",329.47,329.61],["that's",329.61,329.85],["okay.",329.85,330.07]]},{"start":330.31,"end":331.37,"text":"Yeah, that sounds fine.","words":[["Yeah,",330.31,330.55],["that",330.65,330.75],["sounds",330.75,330.97],["fine.",330.97,331.37]]},{"start":334.73,"end":340.33,"text":"That is the end of section one. You now have half a minute to check your answers.","words":[["That",334.73,335.21],["is",335.21,335.33],["the",335.33,335.49],["end",335.49,335.83],["of",335.83,336.03],["section",336.03,336.27],["one.",336.27,336.77],["You",337.65,337.83],["now",337.83,338.11],["have",338.11,338.43],["half",338.43,338.73],["a",338.73,338.93],["minute",338.93,339.15],["to",339.15,339.43],["check",339.43,339.75],["your",339.75,339.93],["answers.",339.93,340.33]]}]}