],["a",143.1,143.32]]},{"start":143.32,"end":147.66,"text":"booking for the performance of pirates. Yes, of course. What day?","words":[["booking",143.32,143.54],["for",143.54,143.82],["the",143.82,143.94],["performance",143.94,144.36],["of",144.36,144.86],["pirates.",144.86,145.34],["Yes,",146.1,146.54],["of",146.62,146.72],["course.",146.72,146.98],["What",147.32,147.4],["day?",147.4,147.66]]},{"start":147.66,"end":153.6,"text":"I'd like to make a booking for the afternoon performance on December the 8th.","words":[["I'd",147.66,148.72],["like",148.72,148.84],["to",148.84,149.02],["make",149.02,149.18],["a",149.18,149.3],["booking",149.3,149.52],["for",149.52,149.82],["the",149.82,149.92],["afternoon",149.92,150.48],["performance",150.48,151.08],["on",151.08,151.96],["December",151.96,152.28],["the",152.28,152.66],["8th.",152.66,153.6]]},{"start":153.6,"end":155.1,"text":"I'll just check on the computer.","words":[["I'll",153.6,154.06],["just",154.06,154.24],["check",154.24,154.5],["on",154.5,154.64],["the",154.64,154.74],["computer.",154.74,155.1]]},{"start":156.12,"end":160.86,"text":"Good news, you're booking well ahead of time, so there are lots of seats available for that performance.","words":[["Good",156.12,156.64],["news,",156.64,156.88],["you're",157.1,157.22],["booking",157.22,157.44],["well",157.44,157.68],["ahead",157.68,157.88],["of",157.88,157.98],["time,",157.98,158.28],["so",158.44,158.72],["there",158.72,159.0],["are",159.0,159.08],["lots",159.08,159.3],["of",159.3,159.44],["seats",159.44,159.66],["available",159.66,160.08],["for",160.08,160.38],["that",160.38,160.5],["performance.",160.5,160.86]]},{"start":161.32,"end":161.6,"text":"Great.","words":[["Great.",161.32,161.6]]},{"start":162.36,"end":165.04,"text":"Now, if I can just start by taking a few details.","words":[["Now,",162.36,162.64],["if",162.74,162.96],["I",162.96,163.1],["can",163.1,163.2],["just",163.2,163.38],["start",163.38,163.68],["by",163.68,163.86],["taking",163.86,164.16],["a",164.16,164.34],["few",164.34,164.56],["details.",164.56,165.04]]},{"start":165.6,"end":166.26,"text":"Yes, of course.","words":[["Yes,",165.6,165.88],["of",165.96,166.06],["course.",166.06,166.26]]},{"start":166.92,"end":168.18,"text":"What's your name, please?","words":[["What's",166.92,167.48],["your",167.48,167.6],["name,",167.6,167.9],["please?",167.96,168.18]]},{"start":169.04,"end":170.66,"text":"It's Fenella Bitton's.","words":[["It's",169.04,169.4],["Fenella",169.4,169.88],["Bitton's.",169.88,170.66]]},{"start":171.44,"end":174.52,"text":"B-I-T-E-N-S.","words":[["B",171.44,171.66],["-I",171.66,172.1],["-T",172.1,172.48],["-E",172.48,173.54],["-N",173.54,174.1],["-S.",174.1,174.52]]},{"start":175.2,"end":177.28,"text":"Now, can I take a contact number?","words":[["Now,",175.2,175.76],["can",175.98,176.18],["I",176.18,176.3],["take",176.3,176.48],["a",176.48,176.58],["contact",176.58,176.9],["number?",176.9,177.28]]},{"start":182.8,"end":183.92,"text":"It's 07796892326.","words":[["It's",182.8,183.36],["07796892326.",183.36,183.92]]},{"start":184.98,"end":187.56,"text":"Lovely. So, how many tickets would you like?","words":[["Lovely.",184.98,185.4],["So,",185.78,185.98],["how",186.36,186.58],["many",186.58,186.74],["tickets",186.74,187.02],["would",187.02,187.24],["you",187.24,187.36],["like?",187.36,187.56]]},{"start":188.2,"end":188.9,"text":"Twenty, please.","words":[["Twenty,",188.2,188.54],["please.",188.76,188.9]]},{"start":189.62,"end":190.82,"text":"So, that's a group booking.","words":[["So,",189.62,189.9],["that's",190.0,190.28],["a",190.28,190.36],["group",190.36,190.5],["booking.",190.5,190.82]]},{"start":191.32,"end":192.72,"text":"Does that mean I get a discount?","words":[["Does",191.32,191.66],["that",191.66,191.84],["mean",191.84,191.96],["I",191.96,192.14],["get",192.14,192.3],["a",192.3,192.4],["discount?",192.4,192.72]]},{"start":193.5,"end":196.0,"text":"Yes. Are they all for adults?","words":[["Yes.",193.5,194.06],["Are",194.66,194.88],[