7],["be",159.67,159.79],["able",159.79,159.95],["to",159.95,160.11],["help",160.11,160.27],["me",160.27,160.41],["organize",160.41,160.85],["a",160.85,161.15],["trip",161.15,161.33],["to",161.33,161.55],["Beach",161.55,161.79],["Heads.",161.79,162.29]]},{"start":162.91,"end":166.85,"text":"Sure, let me just fill in our customer request sheet while I'm speaking to you.","words":[["Sure,",162.91,163.33],["let",163.49,163.61],["me",163.61,163.75],["just",163.75,163.99],["fill",163.99,164.19],["in",164.19,164.31],["our",164.31,164.49],["customer",164.49,164.83],["request",164.83,165.25],["sheet",165.25,165.75],["while",165.75,165.97],["I'm",165.97,166.11],["speaking",166.11,166.41],["to",166.41,166.65],["you.",166.65,166.85]]},{"start":167.67,"end":169.17,"text":"Could you tell me your name again, please?","words":[["Could",167.67,167.91],["you",167.91,168.03],["tell",168.03,168.15],["me",168.15,168.27],["your",168.27,168.37],["name",168.37,168.49],["again,",168.49,168.79],["please?",168.87,169.17]]},{"start":169.81,"end":172.29,"text":"Yes, it's Duncan. Duncan White.","words":[["Yes,",169.81,170.11],["it's",170.29,170.51],["Duncan.",170.51,170.83],["Duncan",171.47,171.91],["White.",171.91,172.29]]},{"start":172.95,"end":175.33,"text":"Okay, and is the trip just for yourself?","words":[["Okay,",172.95,173.37],["and",173.57,173.83],["is",173.83,174.13],["the",174.13,174.29],["trip",174.29,174.53],["just",174.53,174.75],["for",174.75,174.97],["yourself?",174.97,175.33]]},{"start":175.89,"end":184.29,"text":"No, there's three adults, myself, my wife and my mother, and our two daughters, Chloe and Eden.","words":[["No,",175.89,176.29],["there's",176.51,177.05],["three",177.05,177.51],["adults,",177.51,177.85],["myself,",178.35,178.85],["my",179.35,179.59],["wife",179.59,179.89],["and",179.89,180.37],["my",180.37,180.65],["mother,",180.65,180.97],["and",181.53,181.85],["our",181.85,182.15],["two",182.15,182.45],["daughters,",182.45,182.81],["Chloe",183.37,183.55],["and",183.55,183.95],["Eden.",183.95,184.29]]},{"start":184.29,"end":186.37,"text":"So, when are you thinking of travelling?","words":[["So,",184.29,185.01],["when",185.15,185.31],["are",185.31,185.43],["you",185.43,185.51],["thinking",185.51,185.75],["of",185.75,185.97],["travelling?",185.97,186.37]]},{"start":186.77,"end":188.11,"text":"During the next school holidays.","words":[["During",186.77,186.97],["the",186.97,187.15],["next",187.15,187.31],["school",187.31,187.67],["holidays.",187.67,188.11]]},{"start":188.73,"end":191.75,"text":"So they start on the 12th of October, don't they?","words":[["So",188.73,189.21],["they",189.21,189.69],["start",189.69,190.05],["on",190.05,190.27],["the",190.27,190.35],["12th",190.35,190.75],["of",190.75,190.79],["October,",190.79,191.17],["don't",191.33,191.55],["they?",191.55,191.75]]},{"start":192.15,"end":196.81,"text":"Yes, but we'll be arriving on the 15th and we want to stay for a fortnight.","words":[["Yes,",192.15,192.49],["but",192.83,193.11],["we'll",193.11,193.41],["be",193.41,193.55],["arriving",193.55,193.93],["on",193.93,194.17],["the",194.17,194.25],["15th",194.25,194.97],["and",194.97,195.25],["we",195.25,195.43],["want",195.43,195.61],["to",195.61,195.77],["stay",195.77,195.97],["for",195.97,196.21],["a",196.21,196.35],["fortnight.",196.35,196.81]]},{"start":197.09,"end":198.07,"text":"Right, got all that.","words":[["Right,",197.09,197.39],["got",197.49,197.63],["all",197.63,197.83],["that.",197.83,198.07]]},{"start":198.51,"end":203.23,"text":"Now I'll just take a few notes about the type of holiday you want, so I can make the bookings","words":[["Now",198.51,198.77],["I'll",198.77,199.07],["just",199.07,199.25],["take",199.25,199.47],["a",199.47,199.63],["few",199.63,199.73],["notes",199.73,199.99],["about",199.99,200.23],["the",200.23,200.39],["type",200.39,200.59],["of",200.59,200.73],["holiday",200.73,201.01],["you",201.01,201.33],["want,",201.33,201.61],["so",201.91,202.19],["I",202.19,202.45],["can",202.45,202.59],["make",202.59,202.73],["the",202.73,202.87],["bookings",202.87,203.23]]},{"start":203.23,"end":203.63,"text":"for you.","words":[["for",203.23,203.41],["you.",203.41,203.63]]},{"start":204.25,"end":206.67,"text":"Have you thought about where you want to stay while you're here?","words":[["Have",204.25,204.45],["you",204.45,204.57],["thought",204.57,204.79],["about",204.79,205.05],["where",205.05,205.31],["you",205.31,205.43],["want",205.43,205.61],["to",205.61,205.73],["stay",205.73,205.99],["while",205.99,206.25],["you're",206.25,206.43],["here?",206.43,206.67]]},{"start":207.05,"end":211.91,"text":"In the first week, we'd like a bit of luxury, and we're planning on staying in a hotel","words":[["In",207.05,207.25],["the",207.25,207.39],["first",207.39,207.69],["week,",207.69,207.99],["we'd",208.15,208.39],["like",208.39,208.61],["a",208.61,208.81],["bit",208.81,208.91],["of",208.91,209.03],["luxury,",209.03,209.41],["and",209.97,210.21],["we're",210.21,210.47],["planning",210.47,210.77],["on",210.77,210.99],["staying",210.99,211.27],["in",211.27,211.45],["a",211.45,211.57],["hotel",211.57,211.91]]},{"start":211.91,"end":218.25,"text":"on the beach if possible. That'll be so much better than a campsite. We usually stay in a tent when","words":[["on",211.91,212.09],["the",212.09,212.29],["beach",212.29,212.67],["if",212.67,212.89],["possible.",212.89,213.43],["That'll",214.03,214.21],["be",214.21,214.33],["so",214.33,214.59],["much",214.59,214.85],["better",214.85,215.07],["than",215.07,215.21],["a",215.21,215.35],["campsite.",215.35,215.87],["We",216.49,216.67],["usually",216.67,217.09],["stay",217.09,217.43],["in",217.43,217.59],["a",217.59,217.69],["tent",217.69,218.01],["when",218.01,218.25]]},{"start":218.25,"end":223.41,"text":"we go away, but we're going to treat ourselves this time. And do you have a figure in mind for","words":[["we",218.25,218.43],["go",218.43,218.55],["away,",218.55,218.91],["but",219.25,219.43],["we're",219.43,219.61],["going",219.61,219.77],["to",219.77,219.95],["treat",219.95,220.25],["ourselves",220.25,220.63],["this",220.63,221.05],["time.",221.05,221.37],["And",221.63,221.87],["do",221.87,222.07],["you",222.07,222.17],["have",222.17,222.31],["a",222.31,222.43],["figure",222.43,222.73],["in",222.73,222.93],["mind",222.93,223.23],["for",223.23,223.41]]},{"start":223.41,"end":230.85,"text":"how much you'd like to spend? Are we likely to get anything for under $150 a night? Not really.","words":[["how",223.41,223.59],["much",223.59,223.81],["you'd",223.81,223.97],["like",223.97,224.09],["to",224.09,224.27],["spend?",224.27,224.57],["Are",225.09,225.23],["we",225.23,225.35],["likely",225.35,225.69],["to",225.69,225.97],["get",225.97,226.13],["anything",226.13,226.43],["for",226.43,226.83],["under",226.83,227.13],["$150",227.13,228.13],["a",228.13,228.87],["night?",228.87,229.13],["Not",229.83,230.31],["really.",230.31,230.85]]},{"start":231.15,"end":236.73,"text":"You'd have to spend at least $175 for a big enough room. Okay, we can stretch to that.","words":[["You'd",231.15,231.25],["have",231.25,231.35],["to",231.35,231.49],["spend",231.49,231.79],["at",231.79,231.97],["least",231.97,232.13],["$175",232.13,233.39],["for",233.39,233.63],["a",233.63,233.71],["big",233.71,233.79],["enough",233.79,233.97],["room.",233.97,234.33],["Okay,",234.65,235.11],["we",235.43,235.69],["can",235.69,235.95],["stretch",235.95,236.29],["to",236.29,236.53],["that.",236.53,236.73]]},{"start":236.73,"end":242.55,"text":"I'll just have to stop myself thinking that when we go camping we only pay about $200 for","words":[["I'll",236.73,237.49],["just",237.49,237.63],["have",237.63,237.83],["to",237.83,237.95],["stop",237.95,238.17],["myself",238.17,238.51],["thinking",238.51,239.01],["that",239.01,239.25],["when",239.25,239.35],["we",239.35,239.53],["go",239.53,239.69],["camping",239.69,240.17],["we",240.17,240.49],["only",240.49,240.73],["pay",240.73,241.01],["about",241.01,241.29],["$200",241.29,241.91],["for",241.91,242.55]]},{"start":242.55,"end":243.21,"text":"a whole week.","words":[["a",242.55,242.67],["whole",242.67,242.83],["week.",242.83,243.21]]},{"start":243.71,"end":245.31,"text":"Well, I'm sure it will be worth it.","words":[["Well,",243.71,244.01],["I'm",244.05,244.17],["sure",244.17,244.41],["it",244.41,244.57],["will",244.57,244.65],["be",244.65,244.79],["worth",244.79,245.09],["it.",245.09,245.31]]},{"start":245.79,"end":248.69,"text":"I can also organise some activities for your first week.","words":[["I",245.79,245.99],["can",245.99,246.13],["also",246.13,246.41],["organise",246.41,246.85],["some",246.85,247.17],["activities",247.17,247.69],["for",247.69,248.01],["your",248.01,248.17],["first",248.17,248.39],["week.",248.39,248.69]]},{"start":249.17,"end":251.97,"text":"Is there anything your daughters would particularly like to do?","words":[["Is",249.17,249.35],["there",249.35,249.57],["anything",249.57,249.91],["your",249.91,250.19],["daughters",250.19,250.47],["would",250.47,250.67],["particularly",250.67,251.11],["like",251.11,251.51],["to",251.51,251.75],["do?",251.75,251.97]]},{"start":252.33,"end":254.51,"text":"They want to try sailing this year.","words":[["They",252.33,252.51],["want",252.51,252.73],["to",252.73,252.95],["try",252.95,253.23],["sailing",253.23,253.79],["this",253.79,254.19],["year.",254.19,254.51]]},{"start":254.87,"end":256.03,"text":"Last year it was surfing.","words":[["Last",254.87,255.05],["year",255.05,255.35],["it",255.35,255.45],["was",255.45,255.61],["surfing.",255.61,256.03]]},{"start":256.39,"end":257.43,"text":"They were mad about it.","words":[["They",256.39,256.51],["were",256.51,256.57],["mad",256.57,256.93],["about",256.93,257.17],["it.",257.17,257.43]]},{"start":257.87,"end":259.97,"text":"Kids change their minds a lot, don't they?","words":[["Kids",257.87,258.15],["change",258.15,258.51],["their",258.51,258.75],["minds",258.75,259.05],["a",259.05,259.19],["lot,",259.19,259.39],["don't",259.47,259.73],["they?",259.73,259.97]]},{"start":260.57,"end":261.97,"text":"Mine are into cycling at the moment.","words":[["Mine",260.57,260.83],["are",260.83,260.95],["into",260.95,261.07],["cycling",261.07,261.43],["at",261.43,261.61],["the",261.61,261.69],["moment.",261.69,261.97]]},{"start":262.65,"end":264.39,"text":"I know someone who can teach them to sail.","words":[["I",262.65,262.83],["know",262.83,262.95],["someone",262.95,263.21],["who",263.21,263.37],["can",263.37,263.49],["teach",263.49,263.71],["them",263.71,263.89],["to",263.89,264.01],["sail.",264.01,264.39]]},{"start":264.39,"end":266.71,"text":"would you like me to organize a class for them?","words":[["would",264.39,264.67],["you",264.67,264.79],["like",264.79,264.93],["me",264.93,265.09],["to",265.09,265.23],["organize",265.23,265.59],["a",265.59,265.89],["class",265.89,266.13],["for",266.13,266.49],["them?",266.49,266.71]]},{"start":266.91,"end":269.61,"text":"Wonderful. We're bringing our own boat with us.","words":[["Wonderful.",266.91,267.27],["We're",267.81,268.17],["bringing",268.17,268.43],["our",268.43,268.75],["own",268.75,268.95],["boat",268.95,269.15],["with",269.15,269.39],["us.",269.39,269.61]]},{"start":270.03,"end":271.61,"text":"And what about your wife and your mother?","words":[["And",270.03,270.25],["what",270.25,270.37],["about",270.37,270.57],["your",270.57,270.77],["wife",270.77,271.07],["and",271.07,271.27],["your",271.27,271.41],["mother?",271.41,271.61]]},{"start":272.11,"end":275.49,"text":"Well, my mother Susan goes bowling when she's in Brisbane,","words":[["Well,",272.11,272.41],["my",272.67,272.83],["mother",272.83,273.07],["Susan",273.07,273.59],["goes",273.59,273.99],["bowling",273.99,274.51],["when",274.51,274.77],["she's",274.77,275.05],["in",275.05,275.15],["Brisbane,",275.15,275.49]]},{"start":275.49,"end":278.17,"text":"but my wife Jenny doesn't really like it.","words":[["but",275.49,276.23],["my",276.23,276.47],["wife",276.47,276.81],["Jenny",276.81,277.11],["doesn't",277.11,277.47],["really",277.47,277.67],["like",277.67,278.01],["it.",278.01,278.17]]},{"start":278.63,"end":282.61,"text":"She loves bushwalking, but obviously my mother can't manage that.","words":[["She",278.63,278.95],["loves",278.95,279.17],["bushwalking,",279.17,280.05],["but",280.07,280.25],["obviously",280.25,280.99],["my",280.99,281.31],["mother",281.31,281.59],["can't",281.59,282.05],["manage",282.05,282.37],["that.",282.37,282.61]]},{"start":283.27,"end":286.79,"text":"Can I suggest golf for them both? It's a gentler kind of walk.","words":[["Can",283.27,283.55],["I",283.55,283.69],["suggest",283.69,283.89],["golf",283.89,284.29],["for",284.29,284.53],["them",284.53,284.63],["both?",284.63,284.87],["It's",285.27,285.65],["a",285.65,285.77],["gentler",285.77,286.09],["kind",286.09,286.37],["of",286.37,286.53],["walk.",286.53,286.79]]},{"start":287.23,"end":290.39,"text":"There's a beautiful course here with magnificent views of the sea.","words":[["There's",287.23,287.45],["a",287.45,287.57],["beautiful",287.57,287.77],["course",287.77,288.17],["here",288.17,288.45],["with",288.45,288.65],["magnificent",288.65,289.21],["views",289.21,289.77],["of",289.77,289.99],["the",289.99,290.11],["sea.",290.11,290.39]]},{"start":290.67,"end":291.43,"text":"Sounds perfect.","words":[["Sounds",290.67,290.97],["perfect.",290.97,291.43]]},{"start":291.83,"end":293.33,"text":"Okay, I'll organize a time.","words":[["Okay,",291.83,292.21],["I'll",292.35,292.49],["organize",292.49,292.77],["a",292.77,293.01],["time.",293.01,293.33]]},{"start":293.33,"end":298.85,"text":"Thanks. Could you send me some leaflets about fishing in the area? I'd like to take the","words":[["Thanks.",293.33,293.95],["Could",294.65,294.89],["you",294.89,295.07],["send",295.07,295.35],["me",295.35,295.49],["some",295.49,295.69],["leaflets",295.69,296.17],["about",296.17,296.53],["fishing",296.53,296.93],["in",296.93,297.15],["the",297.15,297.25],["area?",297.25,297.51],["I'd",297.97,298.19],["like",298.19,298.31],["to",298.31,298.49],["take",298.49,298.67],["the",298.67,298.85]]},{"start":298.85,"end":302.51,"text":"boat out myself. Sure, there are some good spots around. Great.","words":[["boat",298.85,298.99],["out",298.99,299.17],["myself.",299.17,299.55],["Sure,",299.97,300.37],["there",300.47,300.65],["are",300.65,300.73],["some",300.73,300.87],["good",300.87,301.09],["spots",301.09,301.37],["around.",301.37,301.87],["Great.",302.25,302.51]]},{"start":306.1,"end":312.18,"text":"Before you hear the rest of the conversation, you have some time to look at questions 8-10","words":[["Before",306.1,306.38],["you",306.38,306.64],["hear",306.64,306.84],["the",306.84,306.98],["rest",306.98,307.24],["of",307.24,307.36],["the",307.36,307.46],["conversation,",307.46,308.12],["you",308.8,309.0],["have",309.0,309.18],["some",309.18,309.38],["time",309.38,309.8],["to",309.8,310.32],["look",310.32,310.46],["at",310.46,310.6],["questions",310.6,310.92],["8",310.92,311.54],["-10",311.54,312.18]]},{"start":312.48,"end":332.05,"text":"on page 2. Now listen and answer questions 8-10.","words":[["on",312.48,312.76],["page",312.76,313.08],["2.",313.08,313.64],["Now",328.77,328.99],["listen",328.99,329.33],["and",329.33,330.03],["answer",330.03,330.39],["questions",330.39,330.77],["8",330.77,331.37],["-10.",331.37,332.05]]},{"start":335.83,"end":340.73,"text":"OK, so let's think about the second week now. We want something totally different.","words":[["OK,",335.83,336.19],["so",336.37,336.49],["let's",336.49,336.79],["think",336.79,336.97],["about",336.97,337.23],["the",337.23,337.45],["second",337.45,337.73],["week",337.73,338.03],["now.",338.03,338.39],["We",338.79,339.03],["want",339.03,339.27],["something",339.27,339.67],["totally",339.67,340.29],["different.",340.29,340.73]]},{"start":340.73,"end":343.77,"text":"We'd like to stay up in the mountains in the National Park.","words":[["We'd",340.73,341.45],["like",341.45,341.61],["to",341.61,341.81],["stay",341.81,342.01],["up",342.01,342.19],["in",342.19,342.27],["the",342.27,342.37],["mountains",342.37,342.75],["in",342.75,343.01],["the",343.01,343.09],["National",343.09,343.37],["Park.",343.37,343.77]]},{"start":344.07,"end":347.45,"text":"Very nice. And what kind of accommodation are you thinking of?","words":[["Very",344.07,344.37],["nice.",344.37,344.75],["And",345.31,345.53],["what",345.53,345.65],["kind",345.65,345.91],["of",345.91,346.03],["accommodation",346.03,346.41],["are",346.41,346.79],["you",346.79,346.85],["thinking",346.85,347.11],["of?",347.11,347.45]]},{"start":347.61,"end":349.45,"text":"There are some beautiful houses you can rent.","words":[["There",347.61,347.77],["are",347.77,347.87],["some",347.87,348.03],["beautiful",348.03,348.35],["houses",348.35,348.81],["you",348.81,349.03],["can",349.03,349.21],["rent.",349.21,349.45]]},{"start":349.91,"end":353.73,"text":"Yes, we did think about renting a house, but I'm worried about the cost.","words":[["Yes,",349.91,350.17],["we",350.37,350.51],["did",350.51,350.71],["think",350.71,351.11],["about",351.11,351.43],["renting",351.43,351.73],["a",351.73,351.93],["house,",351.93,352.23],["but",352.39,352.51],["I'm",352.51,352.71],["worried",352.71,352.91],["about",352.91,353.13],["the",353.13,353.33],["cost.",353.33,353.73]]},{"start":354.41,"end":358.11,"text":"Is there anything a bit cheaper, say, a caravan or even a cabin?","words":[["Is",354.41,354.57],["there",354.57,354.71],["anything",354.71,354.95],["a",354.95,355.15],["bit",355.15,355.27],["cheaper,",355.27,355.71],["say,",355.91,356.11],["a",356.47,356.57],["caravan",356.57,356.97],["or",356.97,357.41],["even",357.41,357.71],["a",357.71,357.87],["cabin?",357.87,358.11]]},{"start":358.55,"end":362.17,"text":"It'd have to be a caravan, because they don't have cabins at the campground,","words":[["It'd",358.55,358.71],["have",358.71,358.87],["to",358.87,358.99],["be",358.99,359.13],["a",359.13,359.27],["caravan,",359.27,359.81],["because",360.03,360.31],["they",360.31,360.65],["don't",360.65,360.83],["have",360.83,360.97],["cabins",360.97,361.39],["at",361.39,361.53],["the",361.53,361.63],["campground,",361.63,362.17]]},{"start":362.29,"end":364.41,"text":"but the standard is very high.","words":[["but",362.29,362.45],["the",362.45,362.65],["standard",362.65,363.11],["is",363.11,363.47],["very",363.47,363.91],["high.",363.91,364.41]]},{"start":364.71,"end":365.75,"text":"How much does it cost?","words":[["How",364.71,364.89],["much",364.89,365.07],["does",365.07,365.29],["it",365.29,365.41],["cost?",365.41,365.75]]},{"start":366.13,"end":369.43,"text":"$100 a night, but they're very roomy with all-mode cons.","words":[["$100",366.13,366.55],["a",366.55,367.09],["night,",367.09,367.39],["but",367.47,367.65],["they're",367.65,367.97],["very",367.97,368.15],["roomy",368.15,368.57],["with",368.57,368.73],["all",368.73,368.93],["-mode",368.93,369.09],["cons.",369.09,369.43]]},{"start":369.43,"end":376.27,"text":"The campground's also in a really good spot. What activities are you thinking of doing in that second week?","words":[["The",369.43,370.21],["campground's",370.21,370.95],["also",370.95,371.37],["in",371.37,371.59],["a",371.59,371.71],["really",371.71,372.01],["good",372.01,372.21],["spot.",372.21,372.57],["What",373.23,373.59],["activities",373.59,374.03],["are",374.03,374.53],["you",374.53,374.63],["thinking",374.63,374.89],["of",374.89,375.11],["doing",375.11,375.31],["in",375.31,375.49],["that",375.49,375.65],["second",375.65,375.95],["week?",375.95,376.27]]},{"start":376.85,"end":382.53,"text":"Well, it's actually going to be my wife's birthday, so I'd like to do something a bit special for her.","words":[["Well,",376.85,377.07],["it's",377.23,377.47],["actually",377.47,377.91],["going",377.91,378.15],["to",378.15,378.29],["be",378.29,378.41],["my",378.41,378.59],["wife's",378.59,379.51],["birthday,",379.51,379.51],["so",379.51,379.93],["I'd",379.93,380.47],["like",380.47,380.61],["to",380.61,380.79],["do",380.79,380.93],["something",380.93,381.23],["a",381.23,381.45],["bit",381.45,381.53],["special",381.53,381.99],["for",381.99,382.29],["her.",382.29,382.53]]},{"start":383.13,"end":386.39,"text":"I can book a really nice massage for her after lunch on that day.","words":[["I",383.13,383.31],["can",383.31,383.47],["book",383.47,383.59],["a",383.59,383.77],["really",383.77,383.95],["nice",383.95,384.23],["massage",384.23,384.77],["for",384.77,385.03],["her",385.03,385.23],["after",385.23,385.45],["lunch",385.45,385.73],["on",385.73,385.91],["that",385.91,386.05],["day.",386.05,386.39]]},{"start":386.67,"end":387.01,"text":"Lovely.","words":[["Lovely.",386.67,387.01]]},{"start":387.47,"end":395.65,"text":"Or would she rather try something more adventurous, like a walk in the treetops? It's really exciting. You go along a really high wooden bridge.","words":[["Or",387.47,387.79],["would",387.79,387.99],["she",387.99,388.23],["rather",388.23,388.49],["try",388.49,388.75],["something",388.75,389.05],["more",389.05,389.31],["adventurous,",389.31,389.75],["like",390.03,390.23],["a",390.23,390.67],["walk",390.67,390.85],["in",390.85,391.03],["the",391.03,391.11],["treetops?",391.11,391.63],["It's",392.11,392.37],["really",392.37,392.73],["exciting.",392.73,393.33],["You",393.77,393.91],["go",393.91,394.05],["along",394.05,394.25],["a",394.25,394.45],["really",394.45,394.65],["high",394.65,395.03],["wooden",395.03,395.25],["bridge.",395.25,395.65]]},{"start":395.65,"end":399.63,"text":"Oh, no. Should be terrified. Stick with your first idea.","words":[["Oh,",395.65,396.09],["no.",396.13,396.31],["Should",396.85,397.05],["be",397.05,397.19],["terrified.",397.19,397.67],["Stick",398.33,398.61],["with",398.61,398.79],["your",398.79,398.91],["first",398.91,399.21],["idea.",399.21,399.63]]},{"start":400.43,"end":403.17,"text":"Are there any nice places to eat near the campground?","words":[["Are",400.43,400.71],["there",400.71,400.85],["any",400.85,401.03],["nice",401.03,401.35],["places",401.35,401.79],["to",401.79,402.03],["eat",402.03,402.25],["near",402.25,402.51],["the",402.51,402.69],["campground?",402.69,403.17]]},{"start":403.55,"end":407.55,"text":"Yes, there's a fantastic wood-fired pizza restaurant called Marcos.","words":[["Yes,",403.55,404.07],["there's",404.17,404.41],["a",404.41,404.53],["fantastic",404.53,405.11],["wood",405.11,405.53],["-fired",405.53,405.89],["pizza",405.89,406.25],["restaurant",406.25,406.83],["called",406.83,407.01],["Marcos.",407.01,407.55]]},{"start":408.15,"end":411.33,"text":"Oh, good. I've got two very fussy daughters.","words":[["Oh,",408.15,408.45],["good.",408.53,408.79],["I've",409.51,409.75],["got",409.75,409.89],["two",409.89,410.23],["very",410.23,410.57],["fussy",410.57,410.91],["daughters.",410.91,411.33]]},{"start":411.97,"end":414.73,"text":"Could you send me their menu so we can check it'll be okay?","words":[["Could",411.97,412.11],["you",412.11,412.27],["send",412.27,412.49],["me",412.49,412.67],["their",412.67,412.87],["menu",412.87,413.21],["so",413.21,413.51],["we",413.51,413.69],["can",413.69,413.79],["check",413.79,414.01],["it'll",414.01,414.23],["be",414.23,414.37],["okay?",414.37,414.73]]},{"start":415.23,"end":417.67,"text":"No problem, Duncan. Now, while I remember...","words":[["No",415.23,415.49],["problem,",415.49,415.75],["Duncan.",415.91,416.13],["Now,",416.61,416.87],["while",416.97,417.19],["I",417.19,417.41],["remember...",417.41,417.67]]},{"start":421.07,"end":426.49,"text":"That is the end of section one. You now have half a minute to check your answers.","words":[["That",421.07,421.53],["is",421.53,421.73],["the",421.73,421.87],["end",421.87,422.07],["of",422.07,422.21],["section",422.21,422.47],["one.",422.47,422.91],["You",423.75,424.03],["now",424.03,424.25],["have",424.25,424.51],["half",424.51,424.77],["a",424.77,424.91],["minute",424.91,425.11],["to",425.11,425.49],["check",425.49,425.77],["your",425.77,426.05],["answers.",426.05,426.49]]}]}