",198.08,198.36],["called",198.36,198.78],["Variations",198.78,199.74],["on",199.74,200.02],["a",200.02,200.16],["Theme,",200.16,200.44],["you",201.02,201.26],["learn",201.26,201.48],["to",201.48,201.68],["cook",201.68,201.9],["a",201.9,202.06],["variety",202.06,202.42],["of",202.42,202.64],["dishes",202.64,202.88],["using",202.88,203.4],["a",203.4,203.68],["specific",203.68,204.04],["ingredient",204.04,204.72],["in",204.72,205.08],["each.",205.08,205.46]]},{"start":206.24,"end":213.42,"text":"For example, in the next class you will prepare meals using lemon. The lemon chicken meal is divine.","words":[["For",206.24,206.4],["example,",206.4,206.82],["in",207.44,207.6],["the",207.6,207.7],["next",207.7,207.98],["class",207.98,208.3],["you",208.3,208.64],["will",208.64,208.8],["prepare",208.8,209.14],["meals",209.14,209.54],["using",209.54,210.1],["lemon.",210.1,210.48],["The",211.14,211.36],["lemon",211.36,211.66],["chicken",211.66,212.0],["meal",212.0,212.42],["is",212.42,212.88],["divine.",212.88,213.42]]},{"start":216.88,"end":224.08,"text":"Before you hear the rest of the talk, you have some time to look at questions 17 to 20 on page 4.","words":[["Before",216.88,217.48],["you",217.48,217.72],["hear",217.72,217.94],["the",217.94,218.1],["rest",218.1,218.34],["of",218.34,218.46],["the",218.46,218.54],["talk,",218.54,218.84],["you",219.18,219.34],["have",219.34,219.54],["some",219.54,219.72],["time",219.72,220.14],["to",220.14,220.42],["look",220.42,220.58],["at",220.58,220.72],["questions",220.72,220.9],["17",220.9,221.88],["to",221.88,222.14],["20",222.14,222.54],["on",222.54,223.22],["page",223.22,223.54],["4.",223.54,224.08]]},{"start":224.08,"end":248.12,"text":"Now listen and answer questions 17 to 20.","words":[["Now",224.08,225.12],["listen",244.7,245.14],["and",245.14,245.7],["answer",245.7,246.14],["questions",246.14,246.42],["17",246.42,247.52],["to",247.52,247.72],["20.",247.72,248.12]]},{"start":251.5,"end":258.16,"text":"I'd like to give you a tour of our beautiful kitchen where the meals are made. Our one-day classes meet here.","words":[["I'd",251.5,252.06],["like",252.06,252.14],["to",252.14,252.32],["give",252.32,252.5],["you",252.5,252.62],["a",252.62,252.78],["tour",252.78,252.96],["of",252.96,253.22],["our",253.22,253.44],["beautiful",253.44,253.9],["kitchen",253.9,254.4],["where",254.4,254.7],["the",254.7,254.88],["meals",254.88,255.14],["are",255.14,255.34],["made.",255.34,255.64],["Our",256.38,256.56],["one",256.56,256.88],["-day",256.88,257.06],["classes",257.06,257.5],["meet",257.5,257.78],["here.",257.78,258.16]]},{"start":258.94,"end":265.92,"text":"Just walk through the entrance. Right, now you can see the large preparation table in the middle of the main kitchen.","words":[["Just",258.94,259.18],["walk",259.18,259.44],["through",259.44,259.68],["the",259.68,259.8],["entrance.",259.8,260.12],["Right,",261.02,261.4],["now",261.76,262.02],["you",262.02,262.28],["can",262.28,262.44],["see",262.44,262.72],["the",262.72,262.92],["large",262.92,263.24],["preparation",263.24,263.68],["table",263.68,264.28],["in",264.28,264.56],["the",264.56,264.66],["middle",264.66,264.9],["of",264.9,265.1],["the",265.1,265.22],["main",265.22,265.48],["kitchen.",265.48,265.92]]},{"start":266.76,"end":270.46,"text":"This beautiful table is large enough for 12 students to work on.","words":[["This",266.76,267.18],["beautiful",267.18,267.54],["table",267.54,267.92],["is",267.92,268.22],["large",268.22,268.5],["enough",268.5,268.68],["for",268.68,268.92],["12",268.92,269.3],["students",269.3,269.74],["to",269.74,270.1],["work",270.1,270.26],["on.",270.26,270.46]]},{"start":271.18,"end":273.66,"text":"This room also has a state-of-the-art oven.","words":[["This",271.18,271.74],["room",271.74,271.96],["also",271.96,272.28],["has",272.28,272.54],["a",272.54,272.68],["state",272.68,272.92],["-of",272.92,273.06],["-the",273.06,273.16],["-art",273.16,273.32],["oven.",273.32,273.66]]},{"start":273.66,"end":276.72,"text":"It's large enough for up to 25 cakes.","words":[["It's",273.66,274.58],["large",274.58,274.8],["enough",274.8,275.04],["for",275.04,275.3],["up",275.3,275.46],["to",275.46,275.64],["25",275.64,276.26],["cakes.",276.26,276.72]]},{"start":277.48,"end":281.82,"text":"It's just past the preparation table on the left near the entrance to the hallway.","words":[["It's",277.48,277.86],["just",277.86,278.04],["past",278.04,278.32],["the",278.32,278.52],["preparation",278.52,278.88],["table",278.88,279.34],["on",279.34,279.56],["the",279.56,279.68],["left",279.68,279.94],["near",279.94,280.56],["the",280.56,280.74],["entrance",280.74,281.1],["to",281.1,281.38],["the",281.38,281.52],["hallway.",281.52,281.82]]},{"start":283.78,"end":289.06,"text":"Parishable items are kept in this industrial-sized refrigerator next to the storage in the hallway.","words":[["Parishable",283.78,284.08],["items",284.08,284.38],["are",284.38,284.6],["kept",284.6,284.78],["in",284.78,284.98],["this",284.98,285.12],["industrial",285.12,285.66],["-sized",285.66,286.18],["refrigerator",286.18,286.82],["next",286.82,287.52],["to",287.52,287.78],["the",287.78,287.92],["storage",287.92,288.26],["in",288.26,288.58],["the",288.58,288.74],["hallway.",288.74,289.06]]},{"start":289.96,"end":292.76,"text":"We keep non-perishable items in the storage.","words":[["We",289.96,290.22],["keep",290.22,290.52],["non",290.52,290.86],["-perishable",290.86,291.42],["items",291.42,291.76],["in",291.76,292.2],["the",292.2,292.36],["storage.",292.36,292.76]]},{"start":294.32,"end":298.46,"text":"As you exit from the hallway, you'll come into the large demonstration kitchen.","words":[["As",294.32,294.62],["you",294.62,294.78],["exit",294.78,295.02],["from",295.02,295.34],["the",295.34,295.54],["hallway,",295.54,295.84],["you'll",296.28,296.56],["come",296.56,296.76],["into",296.76,297.0],["the",297.0,297.18],["large",297.18,297.42],["demonstration",297.42,297.98],["kitchen.",297.98,298.46]]},{"start":299.2,"end":305.58,"text":"Here we hold smaller classes, but mainly it's used for cooking demonstrations and tasting events.","words":[["Here",299.2,299.72],["we",299.72,299.94],["hold",299.94,300.24],["smaller",300.24,300.68],["classes,",300.68,301.1],["but",301.66,301.88],["mainly",301.88,302.18],["it's",302.18,302.52],["used",302.52,302.7],["for",302.7,302.94],["cooking",302.94,303.24],["demonstrations",303.24,303.82],["and",303.82,304.66],["tasting",304.66,305.14],["events.",305.14,305.58]]},{"start":306.9,"end":312.26,"text":"The last thing I want to point out is our utensil cabinet. It sits right next to the exit.","words":[["The",306.9,307.42],["last",307.42,307.68],["thing",307.68,307.88],["I",307.88,308.0],["want",308.0,308.14],["to",308.14,308.26],["point",308.26,308.46],["out",308.46,308.64],["is",308.64,308.8],["our",308.8,308.94],["utensil",308.94,309.46],["cabinet.",309.46,309.76],["It",310.46,310.66],["sits",310.66,310.8],["right",310.8,311.22],["next",311.22,311.68],["to",311.68,311.9],["the",311.9,312.0],["exit.",312.0,312.26]]},{"start":312.96,"end":318.12,"text":"It contains a variety of cooking pots and pans and an amazing range of forks and spoons.","words":[["It",312.96,313.24],["contains",313.24,313.52],["a",313.52,313.8],["variety",313.8,314.1],["of",314.1,314.34],["cooking",314.34,314.56],["pots",314.56,315.06],["and",315.06,315.3],["pans",315.3,315.66],["and",315.66,316.06],["an",316.06,316.2],["amazing",316.2,316.6],["range",316.6,317.02],["of",317.02,317.28],["forks",317.28,317.68],["and",317.68,317.86],["spoons.",317.86,318.12]]},{"start":319.3,"end":322.14,"text":"Please feel free to stay around the school to check out our view.","words":[["Please",319.3,319.68],["feel",319.68,319.94],["free",319.94,320.16],["to",320.16,320.36],["stay",320.36,320.52],["around",320.52,320.84],["the",320.84,321.02],["school",321.02,321.3],["to",321.3,321.52],["check",321.52,321.72],["out",321.72,321.9],["our",321.9,322.02],["view.",322.02,322.14]]},{"start":325.32,"end":330.64,"text":"That is the end of section 2. You now have half a minute to check your answers.","words":[["That",325.32,325.78],["is",325.78,325.92],["the",325.92,326.06],["end",326.06,326.42],["of",326.42,326.6],["section",326.6,326.86],["2.",326.86,327.4],["You",328.02,328.26],["now",328.26,328.48],["have",328.48,328.78],["half",328.78,329.04],["a",329.04,329.24],["minute",329.24,329.46],["to",329.46,329.72],["check",329.72,330.02],["your",330.02,330.22],["answers.",330.22,330.64]]},{"start":330.64,"end":330.76,"text":"years.","words":[["years.",330.64,330.76]]}]}