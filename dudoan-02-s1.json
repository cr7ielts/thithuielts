],["your",177.87,177.99],["phone",177.99,178.19],["number?",178.19,178.39]]},{"start":178.73,"end":181.09,"text":"I only have a mobile. Is that okay?","words":[["I",178.73,179.11],["only",179.11,179.35],["have",179.35,179.55],["a",179.55,179.67],["mobile.",179.67,179.95],["Is",180.51,180.67],["that",180.67,180.81],["okay?",180.81,181.09]]},{"start":181.45,"end":181.97,"text":"That's fine.","words":[["That's",181.45,181.69],["fine.",181.69,181.97]]},{"start":181.97,"end":191.15,"text":"OK. It's 61438197. But if you want to contact me, usually the best way is by email.","words":[["OK.",181.97,182.75],["It's",183.37,183.73],["61438197.",183.73,187.47],["But",188.11,188.43],["if",188.43,188.55],["you",188.55,188.65],["want",188.65,188.79],["to",188.79,188.93],["contact",188.93,189.19],["me,",189.19,189.47],["usually",189.55,189.97],["the",189.97,190.21],["best",190.21,190.39],["way",190.39,190.59],["is",190.59,190.73],["by",190.73,190.87],["email.",190.87,191.15]]},{"start":191.91,"end":194.13,"text":"OK. What's your email address then?","words":[["OK.",191.91,192.19],["What's",192.71,193.01],["your",193.01,193.19],["email",193.19,193.53],["address",193.53,193.85],["then?",193.85,194.13]]},{"start":194.75,"end":197.93,"text":"It's susansmithatpost.com","words":[["It's",194.75,195.05],["susansmithatpost",195.05,196.73],[".com",196.73,197.93]]},{"start":197.93,"end":200.83,"text":"Thanks. Now you said you're living in Australia.","words":[["Thanks.",197.93,198.65],["Now",199.35,199.65],["you",199.65,199.93],["said",199.93,200.09],["you're",200.09,200.25],["living",200.25,200.39],["in",200.39,200.55],["Australia.",200.55,200.83]]},{"start":201.49,"end":202.33,"text":"Right. In Brisbane.","words":[["Right.",201.49,201.81],["In",202.05,202.11],["Brisbane.",202.11,202.33]]},{"start":202.85,"end":204.97,"text":"OK. What's your address in Brisbane then?","words":[["OK.",202.85,203.13],["What's",203.61,203.91],["your",203.91,204.01],["address",204.01,204.29],["in",204.29,204.45],["Brisbane",204.45,204.71],["then?",204.71,204.97]]},{"start":206.23,"end":210.21,"text":"234 Becketts. That's B-E-C-K-E-T-S.","words":[["234",206.23,206.79],["Becketts.",206.79,207.35],["That's",207.59,208.05],["B",208.05,208.27],["-E",208.27,208.49],["-C",208.49,208.69],["-K",208.69,209.05],["-E",209.05,209.33],["-T",209.33,209.55],["-S.",209.55,210.21]]},{"start":210.71,"end":213.11,"text":"Road, Brisbane, 4054.","words":[["Road,",210.71,211.13],["Brisbane,",211.43,211.79],["4054.",212.25,213.11]]},{"start":213.79,"end":214.03,"text":"Right.","words":[["Right.",213.79,214.03]]},{"start":214.75,"end":215.95,"text":"Will you be working in New Zealand?","words":[["Will",214.75,214.91],["you",214.91,215.01],["be",215.01,215.13],["working",215.13,215.39],["in",215.39,215.59],["New",215.59,215.67],["Zealand?",215.67,215.95]]},{"start":216.37,"end":218.27,"text":"Yes, I have a job at Auckland Hospital.","words":[["Yes,",216.37,216.69],["I",216.97,217.15],["have",217.15,217.35],["a",217.35,217.43],["job",217.43,217.57],["at",217.57,217.71],["Auckland",217.71,217.87],["Hospital.",217.87,218.27]]},{"start":218.69,"end":219.57,"text":"Oh, are you a nurse?","words":[["Oh,",218.69,218.87],["are",219.03,219.15],["you",219.15,219.27],["a",219.27,219.39],["nurse?",219.39,219.57]]},{"start":220.49,"end":222.69,"text":"Most people assume that or think I'm a doctor,","words":[["Most",220.49,220.91],["people",220.91,221.25],["assume",221.25,221.67],["that",221.67,221.89],["or",221.89,221.99],["think",221.99,222.15],["I'm",222.15,222.33],["a",222.33,222.45],["doctor,",222.45,222.69]]},{"start":222.79,"end":223.97,"text":"but actually I'm a chemist.","words":[["but",222.79,222.91],["actually",222.91,223.31],["I'm",223.31,223.51],["a",223.51,223.63],["chemist.",223.63,223.97]]},{"start":224.07,"end":224.61,"text":"Oh, sorry.","words":[["Oh,",224.07,224.21],["sorry.",224.25,224.61]]},{"start":224.93,"end":225.41,"text":"That's okay.","words":[["That's",224.93,225.21],["okay.",225.21,225.41]]},{"start":226.21,"end":227.73,"text":"When will you need the accommodation from?","words":[["When",226.21,226.47],["will",226.47,226.61],["you",226.61,226.75],["need",226.75,226.89],["the",226.89,226.99],["accommodation",226.99,227.39],["from?",227.39,227.73]]},{"start":228.13,"end":230.45,"text":"Well, I don't start work until the 25th of February,","words":[["Well,",228.13,228.33],["I",228.37,228.45],["don't",228.45,228.67],["start",228.67,228.89],["work",228.89,229.15],["until",229.15,229.39],["the",229.39,229.51],["25th",229.51,230.05],["of",230.05,230.13],["February,",230.13,230.45]]},{"start":230.73,"end":232.99,"text":"but I'd like to give myself some time to settle in.","words":[["but",230.73,231.07],["I'd",231.07,231.23],["like",231.23,231.35],["to",231.35,231.49],["give",231.49,231.61],["myself",231.61,231.83],["some",231.83,232.09],["time",232.09,232.37],["to",232.37,232.55],["settle",232.55,232.75],["in.",232.75,232.99]]},{"start":233.55,"end":234.81,"text":"A couple of weeks would be nice.","words":[["A",233.55,233.73],["couple",233.73,233.91],["of",233.91,234.03],["weeks",234.03,234.23],["would",234.23,234.39],["be",234.39,234.53],["nice.",234.53,234.81]]},{"start":235.21,"end":237.33,"text":"Let's say from the 10th of February.","words":[["Let's",235.21,235.61],["say",235.61,235.89],["from",235.89,236.49],["the",236.49,236.65],["10th",236.65,236.97],["of",236.97,237.07],["February.",237.07,237.33]]},{"start":237.33,"end":242.49,"text":"At least it start from a Monday and the Monday closest to that is the 8th of February with","words":[["At",237.33,238.15],["least",238.15,238.33],["it",238.33,238.53],["start",238.53,238.71],["from",238.71,238.93],["a",238.93,239.05],["Monday",239.05,239.31],["and",239.31,239.63],["the",239.63,239.75],["Monday",239.75,239.89],["closest",239.89,240.31],["to",240.31,240.59],["that",240.59,240.77],["is",240.77,241.11],["the",241.11,241.33],["8th",241.33,241.79],["of",241.79,241.87],["February",241.87,242.27],["with",242.27,242.49]]},{"start":242.49,"end":242.91,"text":"that suit.","words":[["that",242.49,242.65],["suit.",242.65,242.91]]},{"start":243.29,"end":243.69,"text":"That's fine.","words":[["That's",243.29,243.45],["fine.",243.45,243.69]]},{"start":247.46,"end":252.7,"text":"Before you hear the rest of the conversation, you have some time to look at questions","words":[["Before",247.46,247.82],["you",247.82,248.06],["hear",248.06,248.3],["the",248.3,248.46],["rest",248.46,248.76],["of",248.76,248.88],["the",248.88,248.98],["conversation,",248.98,249.64],["you",250.12,250.56],["have",250.56,250.8],["some",250.8,251.02],["time",251.02,251.48],["to",251.48,252.02],["look",252.02,252.18],["at",252.18,252.32],["questions",252.32,252.7]]},{"start":252.7,"end":294.29,"text":"four to ten on page two. Now listen and answer questions four to ten.","words":[["four",252.7,253.4],["to",253.4,253.74],["ten",253.74,254.1],["on",254.1,254.76],["page",254.76,255.06],["two.",255.06,255.58],["Now",290.73,291.03],["listen",291.03,291.45],["and",291.45,292.01],["answer",292.01,292.35],["questions",292.35,292.79],["four",292.79,293.49],["to",293.49,293.89],["ten.",293.89,294.29]]},{"start":297.51,"end":300.43,"text":"Okay, let's talk about what kind of place you'd like to rent.","words":[["Okay,",297.51,298.03],["let's",298.11,298.37],["talk",298.37,298.53],["about",298.53,298.77],["what",298.77,298.95],["kind",298.95,299.23],["of",299.23,299.33],["place",299.33,299.57],["you'd",299.57,299.83],["like",299.83,299.97],["to",299.97,300.19],["rent.",300.19,300.43]]},{"start":300.93,"end":305.85,"text":"Hmm, I like the outdoors, so my dream would be a house that has its own garden.","words":[["Hmm,",300.93,301.41],["I",301.79,301.99],["like",301.99,302.19],["the",302.19,302.33],["outdoors,",302.33,302.77],["so",303.31,303.57],["my",303.57,303.73],["dream",303.73,304.03],["would",304.03,304.19],["be",304.19,304.35],["a",304.35,304.47],["house",304.47,304.79],["that",304.79,304.97],["has",304.97,305.11],["its",305.11,305.25],["own",305.25,305.47],["garden.",305.47,305.85]]},{"start":306.31,"end":309.21,"text":"Is there anything else you'd consider? An apartment for example?","words":[["Is",306.31,306.75],["there",306.75,306.87],["anything",306.87,307.09],["else",307.09,307.33],["you'd",307.33,307.53],["consider?",307.53,307.89],["An",308.21,308.31],["apartment",308.31,308.61],["for",308.61,308.89],["example?",308.89,309.21]]},{"start":309.69,"end":312.89,"text":"I don't know. They usually don't have an outdoor area.","words":[["I",309.69,309.85],["don't",309.85,310.11],["know.",310.11,310.45],["They",310.97,311.13],["usually",311.13,311.47],["don't",311.47,311.83],["have",311.83,311.97],["an",311.97,312.09],["outdoor",312.09,312.35],["area.",312.35,312.89]]},{"start":313.41,"end":318.73,"text":"But I guess, as an alternative, if you could find me one with a large balcony I'd be happy.","words":[["But",313.41,313.77],["I",313.77,314.03],["guess,",314.03,314.37],["as",314.73,314.87],["an",314.87,314.99],["alternative,",314.99,315.41],["if",315.87,315.93],["you",315.93,316.03],["could",316.03,316.19],["find",316.19,316.47],["me",316.47,316.69],["one",316.69,316.97],["with",316.97,317.19],["a",317.19,317.31],["large",317.31,317.61],["balcony",317.61,318.13],["I'd",318.13,318.37],["be",318.37,318.51],["happy.",318.51,318.73]]},{"start":319.33,"end":320.37,"text":"How many rooms do you want?","words":[["How",319.33,319.47],["many",319.47,319.61],["rooms",319.61,319.93],["do",319.93,320.11],["you",320.11,320.19],["want?",320.19,320.37]]},{"start":321.05,"end":325.11,"text":"Usually one bedroom places are too small. Two would be ideal.","words":[["Usually",321.05,321.49],["one",321.49,321.75],["bedroom",321.75,321.97],["places",321.97,322.45],["are",322.45,322.67],["too",322.67,322.83],["small.",322.83,323.33],["Two",323.85,324.19],["would",324.19,324.55],["be",324.55,324.71],["ideal.",324.71,325.11]]},{"start":325.71,"end":327.77,"text":"Now what would you like to have in the place when you move in?","words":[["Now",325.71,325.89],["what",325.89,326.03],["would",326.03,326.13],["you",326.13,326.23],["like",326.23,326.35],["to",326.35,326.47],["have",326.47,326.67],["in",326.67,326.75],["the",326.75,326.85],["place",326.85,327.07],["when",327.07,327.25],["you",327.25,327.35],["move",327.35,327.55],["in?",327.55,327.77]]},{"start":328.33,"end":330.31,"text":"I'm bringing most of what I need with me.","words":[["I'm",328.33,328.77],["bringing",328.77,328.95],["most",328.95,329.31],["of",329.31,329.49],["what",329.49,329.61],["I",329.61,329.73],["need",329.73,329.89],["with",329.89,330.11],["me.",330.11,330.31]]},{"start":330.85,"end":335.59,"text":"I have beds and sofas and a television, all that sort of stuff so none of that is necessary.","words":[["I",330.85,331.01],["have",331.01,331.19],["beds",331.19,331.45],["and",331.45,331.67],["sofas",331.67,332.21],["and",332.21,332.33],["a",332.33,332.45],["television,",332.45,332.75],["all",333.33,333.47],["that",333.47,333.69],["sort",333.69,333.85],["of",333.85,333.97],["stuff",333.97,334.19],["so",334.19,334.51],["none",334.51,334.75],["of",334.75,334.89],["that",334.89,334.99],["is",334.99,335.09],["necessary.",335.09,335.59]]},{"start":335.59,"end":339.19,"text":"Sounds like you want a partially furnished house with a washing machine.","words":[["Sounds",335.59,336.23],["like",336.23,336.47],["you",336.47,336.63],["want",336.63,336.75],["a",336.75,336.87],["partially",336.87,337.33],["furnished",337.33,337.81],["house",337.81,338.09],["with",338.09,338.35],["a",338.35,338.57],["washing",338.57,338.89],["machine.",338.89,339.19]]},{"start":339.81,"end":341.43,"text":"Actually, I'm bringing that too.","words":[["Actually,",339.81,340.29],["I'm",340.43,340.57],["bringing",340.57,340.81],["that",340.81,341.11],["too.",341.11,341.43]]},{"start":342.17,"end":344.03,"text":"All I really need in the place is a fridge.","words":[["All",342.17,342.41],["I",342.41,342.55],["really",342.55,342.77],["need",342.77,343.01],["in",343.01,343.17],["the",343.17,343.25],["place",343.25,343.49],["is",343.49,343.67],["a",343.67,343.81],["fridge.",343.81,344.03]]},{"start":344.73,"end":346.99,"text":"I don't have one, so we'll definitely need one.","words":[["I",344.73,344.85],["don't",344.85,345.05],["have",345.05,345.29],["one,",345.29,345.59],["so",345.65,345.85],["we'll",345.85,346.05],["definitely",346.05,346.39],["need",346.39,346.77],["one.",346.77,346.99]]},{"start":347.09,"end":347.33,"text":"Okay.","words":[["Okay.",347.09,347.33]]},{"start":347.75,"end":351.21,"text":"Can you find something like that for around $350 a week?","words":[["Can",347.75,348.03],["you",348.03,348.13],["find",348.13,348.33],["something",348.33,348.65],["like",348.65,348.89],["that",348.89,349.07],["for",349.07,349.29],["around",349.29,349.73],["$350",349.73,350.31],["a",350.31,351.05],["week?",351.05,351.21]]},{"start":351.53,"end":352.45,"text":"Well, I'll certainly try.","words":[["Well,",351.53,351.69],["I'll",351.71,351.81],["certainly",351.81,352.09],["try.",352.09,352.45]]},{"start":353.05,"end":355.41,"text":"I'll start looking for places that cost around $300","words":[["I'll",353.05,353.21],["start",353.21,353.45],["looking",353.45,353.77],["for",353.77,353.97],["places",353.97,354.29],["that",354.29,354.49],["cost",354.49,354.65],["around",354.65,354.95],["$300",354.95,355.41]]},{"start":355.41,"end":356.99,"text":"and see if there's anything suitable.","words":[["and",355.41,355.93],["see",355.93,356.11],["if",356.11,356.21],["there's",356.21,356.35],["anything",356.35,356.61],["suitable.",356.61,356.99]]},{"start":357.65,"end":360.93,"text":"You definitely won't need to pay more than $400 for something like that.","words":[["You",357.65,357.81],["definitely",357.81,358.05],["won't",358.05,358.29],["need",358.29,358.49],["to",358.49,358.63],["pay",358.63,358.79],["more",358.79,359.03],["than",359.03,359.19],["$400",359.19,359.73],["for",359.73,360.27],["something",360.27,360.49],["like",360.49,360.73],["that.",360.73,360.93]]},{"start":361.23,"end":363.51,"text":"Oh, that's good. I couldn't pay more than that.","words":[["Oh,",361.23,361.47],["that's",361.49,361.77],["good.",361.77,362.03],["I",362.29,362.43],["couldn't",362.43,362.67],["pay",362.67,362.89],["more",362.89,363.13],["than",363.13,363.29],["that.",363.29,363.51]]},{"start":363.51,"end":368.63,"text":"Alright, I'll see what I can find. You're working at the hospital. Do you want to live somewhere","words":[["Alright,",363.51,364.15],["I'll",364.35,364.49],["see",364.49,364.71],["what",364.71,364.85],["I",364.85,364.97],["can",364.97,365.13],["find.",365.13,365.49],["You're",366.25,366.43],["working",366.43,366.65],["at",366.65,366.77],["the",366.77,366.83],["hospital.",366.83,367.13],["Do",367.69,367.87],["you",367.87,367.95],["want",367.95,368.11],["to",368.11,368.21],["live",368.21,368.33],["somewhere",368.33,368.63]]},{"start":368.63,"end":369.15,"text":"near there?","words":[["near",368.63,368.89],["there?",368.89,369.15]]},{"start":369.87,"end":374.11,"text":"Most people think it's strange but I don't like living close to work. But I'm a mad","words":[["Most",369.87,370.17],["people",370.17,370.43],["think",370.43,370.61],["it's",370.61,370.83],["strange",370.83,371.23],["but",371.23,371.41],["I",371.41,371.55],["don't",371.55,371.79],["like",371.79,372.03],["living",372.03,372.21],["close",372.21,372.51],["to",372.51,372.73],["work.",372.73,373.03],["But",373.47,373.67],["I'm",373.67,373.79],["a",373.79,373.91],["mad",373.91,374.11]]},{"start":374.11,"end":376.97,"text":"keen surfer so it's important for me to be close to the beach.","words":[["keen",374.11,374.37],["surfer",374.37,374.95],["so",374.95,375.09],["it's",375.09,375.23],["important",375.23,375.59],["for",375.59,375.87],["me",375.87,375.97],["to",375.97,376.07],["be",376.07,376.15],["close",376.15,376.41],["to",376.41,376.59],["the",376.59,376.67],["beach.",376.67,376.97]]},{"start":377.75,"end":380.41,"text":"Okay, do you need to be near public transport?","words":[["Okay,",377.75,378.15],["do",378.65,378.89],["you",378.89,378.99],["need",378.99,379.09],["to",379.09,379.21],["be",379.21,379.35],["near",379.35,379.71],["public",379.71,380.03],["transport?",380.03,380.41]]},{"start":380.85,"end":385.19,"text":"No, I usually drive to work because I work a lot of shift work. So wherever I live","words":[["No,",380.85,381.11],["I",381.21,381.31],["usually",381.31,381.61],["drive",381.61,381.95],["to",381.95,382.13],["work",382.13,382.31],["because",382.31,382.57],["I",382.57,382.75],["work",382.75,382.89],["a",382.89,383.03],["lot",383.03,383.13],["of",383.13,383.23],["shift",383.23,383.41],["work.",383.41,383.77],["So",384.03,384.43],["wherever",384.43,384.67],["I",384.67,384.97],["live",384.97,385.19]]},{"start":385.19,"end":388.77,"text":"will need to have parking close to the door so I won't have to walk far at night.","words":[["will",385.19,385.39],["need",385.39,385.59],["to",385.59,385.73],["have",385.73,385.85],["parking",385.85,386.17],["close",386.17,386.51],["to",386.51,386.71],["the",386.71,386.81],["door",386.81,387.11],["so",387.11,387.31],["I",387.31,387.47],["won't",387.47,387.65],["have",387.65,387.79],["to",387.79,387.93],["walk",387.93,388.11],["far",388.11,388.35],["at",388.35,388.51],["night.",388.51,388.77]]},{"start":389.39,"end":389.87,"text":"Anything else?","words":[["Anything",389.39,389.61],["else?",389.61,389.87]]},{"start":390.49,"end":394.15,"text":"I've heard that power bills can get quite expensive, especially in the winter.","words":[["I've",390.49,391.01],["heard",391.01,391.19],["that",391.19,391.35],["power",391.35,391.71],["bills",391.71,391.97],["can",391.97,392.17],["get",392.17,392.33],["quite",392.33,392.57],["expensive,",392.57,393.15],["especially",393.17,393.55],["in",393.55,393.83],["the",393.83,393.91],["winter.",393.91,394.15]]},{"start":394.87,"end":397.13,"text":"It'd be great if electricity was part of the rent.","words":[["It'd",394.87,395.07],["be",395.07,395.17],["great",395.17,395.45],["if",395.45,395.63],["electricity",395.63,396.01],["was",396.01,396.29],["part",396.29,396.61],["of",396.61,396.77],["the",396.77,396.87],["rent.",396.87,397.13]]},{"start":397.55,"end":401.77,"text":"OK, just one last question for our records. Where did you hear about us?","words":[["OK,",397.55,397.81],["just",398.31,398.51],["one",398.51,398.69],["last",398.69,398.89],["question",398.89,399.37],["for",399.37,399.59],["our",399.59,399.71],["records.",399.71,400.09],["Where",400.71,400.87],["did",400.87,400.99],["you",400.99,401.11],["hear",401.11,401.29],["about",401.29,401.53],["us?",401.53,401.77]]},{"start":405.57,"end":411.47,"text":"That is the end of section one. You now have half a minute to check your answers.","words":[["That",405.57,406.09],["is",406.09,406.31],["the",406.31,406.45],["end",406.45,406.67],["of",406.67,406.81],["section",406.81,407.09],["one.",407.09,407.55],["You",408.53,408.75],["now",408.75,408.99],["have",408.99,409.25],["half",409.25,409.59],["a",409.59,409.75],["minute",409.75,409.97],["to",409.97,410.39],["check",410.39,410.71],["your",410.71,411.01],["answers.",411.01,411.47]]},{"start":441.95,"end":444.95,"text":"Now turn to section two on page three.","words":[["Now",441.95,442.25],["turn",442.25,442.53],["to",442.53,442.71],["section",442.71,443.03],["two",443.03,443.51],["on",443.51,444.13],["page",444.13,444.41],["three.",444.41,444.95]]}]}