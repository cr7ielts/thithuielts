["a",239.89,240.21],["regular",240.21,240.51],["travel",240.51,241.01],["feature",241.01,241.49],["where",241.49,242.21],["you",242.21,242.51],["can",242.51,242.69],["find",242.69,243.07],["good",243.07,243.45],["tips",243.45,243.83],["about",243.83,244.43],["the",244.43,244.69],["best",244.69,244.95],["places",244.95,245.39]]},{"start":245.39,"end":246.83,"text":"to go with your camera.","words":[["to",245.39,245.63],["go",245.63,245.89],["with",245.89,246.23],["your",246.23,246.39],["camera.",246.39,246.83]]},{"start":249.97,"end":256.43,"text":"Before you hear the rest of the talk, you have some time to look at questions 17 to 20.","words":[["Before",249.97,251.07],["you",251.07,251.41],["hear",251.41,251.65],["the",251.65,251.85],["rest",251.85,252.11],["of",252.11,252.23],["the",252.23,252.33],["talk,",252.33,252.65],["you",253.07,253.33],["have",253.33,253.51],["some",253.51,253.69],["time",253.69,254.11],["to",254.11,254.33],["look",254.33,254.49],["at",254.49,254.63],["questions",254.63,254.91],["17",254.91,255.79],["to",255.79,256.05],["20.",256.05,256.43]]},{"start":276.79,"end":280.27,"text":"Now listen and answer questions 17 to 20.","words":[["Now",276.79,277.17],["listen",277.17,277.47],["and",277.47,277.87],["answer",277.87,278.29],["questions",278.29,278.63],["17",278.63,279.63],["to",279.63,279.87],["20.",279.87,280.27]]},{"start":283.64,"end":291.48,"text":"Now I promised to talk about my recent holiday with a company called Photosafari when I went","words":[["Now",283.64,284.14],["I",284.14,284.64],["promised",284.64,284.98],["to",284.98,285.36],["talk",285.36,285.56],["about",285.56,285.82],["my",285.82,286.06],["recent",286.06,286.5],["holiday",286.5,287.08],["with",287.08,287.56],["a",287.56,287.68],["company",287.68,288.02],["called",288.02,288.56],["Photosafari",288.56,290.1],["when",290.1,291.06],["I",291.06,291.26],["went",291.26,291.48]]},{"start":291.48,"end":294.24,"text":"with my wife to Kenya in East Africa.","words":[["with",291.48,29