{"id":"vol8-08","section":2,"path":"bank/listening/vol8-08/audio-2.m4a","model":"small","duration":433.01,"segments":[{"start":1.26,"end":7.54,"text":"You will hear a tourism representative recommending some local events on a radio program.","words":[["You",1.26,1.98],["will",1.98,2.16],["hear",2.16,2.42],["a",2.42,2.64],["tourism",2.64,3.2],["representative",3.2,4.06],["recommending",4.06,4.88],["some",4.88,5.38],["local",5.38,5.78],["events",5.78,6.26],["on",6.26,6.48],["a",6.48,6.64],["radio",6.64,6.98],["program.",6.98,7.54]]},{"start":8.52,"end":12.92,"text":"First, you have some time to look at questions 11 to 16.","words":[["First,",8.52,9.24],["you",9.64,9.78],["have",9.78,9.94],["some",9.94,10.1],["time",10.1,10.42],["to",10.42,10.6],["look",10.6,10.8],["at",10.8,11.02],["questions",11.02,11.34],["11",11.34,11.98],["to",11.98,12.4],["16.",12.4,12.92]]},{"start":58.55,"end":62.73,"text":"Now listen carefully and answer questions 11 to 16.","words":[["Now",58.55,58.87],["listen",58.87,59.21],["carefully",59.21,59.71],["and",59.71,60.27],["answer",60.27,60.63],["questions",60.63,61.11],["11",61.11,61.77],["to",61.77,62.25],["16.",62.25,62.73]]},{"start":66.06,"end":67.46,"text":"Good afternoon listeners.","words":[["Good",66.06,66.6],["afternoon",66.6,67.04],["listeners.",67.04,67.46]]},{"start":67.82,"end":69.7,"text":"Thanks for tuning in to 4KB.","words":[["Thanks",67.82,67.96],["for",67.96,68.18],["tuning",68.18,68.42],["in",68.42,68.62],["to",68.62,68.8],["4KB.",68.8,69.7]]},{"start":70.4,"end":74.98,"text":"Jane Lewis is with us from Tourism Queensland to tell us about the annual Queensland Festival.","words":[["Jane",70.4,70.58],["Lewis",70.58,70.9],["is",70.9,71.1],["with",71.1,71.26],["us",71.26,71.4],["from",71.4,71.58],["Tourism",71.58,72.06],["Queensland",72.06,72.54],["to",72.54,72.86],["tell",72.86,72.96],["us",72.96,73.08],["about",73.08,73.32],["the",73.32,73.5],["annual",73.5,73.86],["Queensland",73.86,74.44],["Festival.",74.44,74.98]]},{"star