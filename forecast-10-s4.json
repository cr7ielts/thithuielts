.43,156.91],["is",156.91,157.27],["the",157.27,157.57],["global",157.57,158.11],["market.",158.11,158.73]]},{"start":159.51,"end":164.17,"text":"Our aim is to locate studio work in this increasingly important context.","words":[["Our",159.51,159.77],["aim",159.77,160.03],["is",160.03,160.21],["to",160.21,160.35],["locate",160.35,160.71],["studio",160.71,161.19],["work",161.19,161.61],["in",161.61,161.93],["this",161.93,162.09],["increasingly",162.09,162.79],["important",162.79,163.55],["context.",163.55,164.17]]},{"start":164.17,"end":171.78,"text":"Moving on to what we do in each year. In the first year students explore the three","words":[["Moving",164.17,165.33],["on",166.64,166.98],["to",166.98,167.18],["what",167.18,167.34],["we",167.34,167.5],["do",167.5,167.76],["in",167.76,167.88],["each",167.88,168.18],["year.",168.18,168.62],["In",169.16,169.4],["the",169.4,169.56],["first",169.56,169.8],["year",169.8,170.16],["students",170.16,170.66],["explore",170.66,171.3],["the",171.3,171.52],["three",171.52,171.78]]},{"start":171.78,"end":177.26,"text":"subject areas of textiles in rotation. The emphasis for the first year is","words":[["subject",171.78,172.18],["areas",172.18,172.66],["of",172.66,172.96],["textiles",172.96,173.62],["in",173.62,173.92],["rotation.",173.92,174.44],["The",175.48,175.72],["emphasis",175.72,176.06],["for",176.06,176.38],["the",176.38,176.48],["first",176.48,176.78],["year",176.78,177.1],["is",177.1,177.26]]},{"start":177.26,"end":181.86,"text":"experimentation and we ask for evidence of visual research which must be","words":[["experimentation",177.26,178.0],["and",178.0,178.76],["we",178.76,178.92],["ask",178.92,179.38],["for",179.38,179.66],["evidence",179.66,179.96],["of",179.96,180.24],["visual",180.24,180.54],["research",180.54,181.22],["which",181.22,181.44],["must",181.44,181.68],["be",181.68,181.86]]},{"start":181.86,"end":189.46,"text":"supported by documentation and proposals for its application. In year two design","words":[["