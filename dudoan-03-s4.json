273.63,274.07],["all,",274.07,274.57],["and",274.73,275.47],["that's",275.47,275.97],["what",275.97,276.15],["the",276.15,276.29],["team",276.29,276.59]]},{"start":276.59,"end":282.13,"text":"who work on the project will need to focus on. I'll be handing out some scientific reports","words":[["who",276.59,276.83],["work",276.83,277.09],["on",277.09,277.25],["the",277.25,277.35],["project",277.35,277.79],["will",277.79,278.03],["need",278.03,278.23],["to",278.23,278.37],["focus",278.37,278.63],["on.",278.63,278.93],["I'll",279.63,280.19],["be",280.19,280.31],["handing",280.31,280.49],["out",280.49,280.73],["some",280.73,280.95],["scientific",280.95,281.49],["reports",281.49,282.13]]},{"start":282.13,"end":288.83,"text":"about this year's vehicle shortly. It's interesting to read that even after months and months of","words":[["about",282.13,282.65],["this",282.65,282.97],["year's",282.97,283.29],["vehicle",283.29,283.59],["shortly.",283.59,283.97],["It's",284.91,285.45],["interesting",285.45,285.95],["to",285.95,286.23],["read",286.23,286.47],["that",286.47,286.77],["even",286.77,287.17],["after",287.17,287.51],["months",287.51,287.97],["and",287.97,288.23],["months",288.23,288.57],["of",288.57,288.83]]},{"start":288.83,"end":295.59,"text":"planning, building, and trials, many of the teams were amazed that the vehicles did what they","words":[["planning,",288.83,289.29],["building,",289.61,289.99],["and",290.33,290.39],["trials,",290.39,290.89],["many",291.59,291.91],["of",291.91,292.09],["the",292.09,292.21],["teams",292.21,292.53],["were",292.53,292.83],["amazed",292.83,293.39],["that",293.39,294.09],["the",294.09,294.25],["vehicles",294.25,294.65],["did",294.65,295.13],["what",295.13,295.43],["they",295.43,295.59]]},{"start":295.59,"end":299.77,"text":"wanted them to do it all because so many things can go wrong on the day.","words":[["wanted",295.59,295.91],["them",295.91,296.11],["to",296.11,296.27],["do",296.27,296.45],["it",296.45,296.61],["all",296.61,296.87]