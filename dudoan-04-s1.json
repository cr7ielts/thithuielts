1,161.53],["if",161.53,161.79],["that's",161.79,162.09],["okay.",162.09,162.41],["Have",162.91,163.15],["you",163.15,163.27],["got",163.27,163.45],["a",163.45,163.57],["few",163.57,163.71],["minutes?",163.71,163.95]]},{"start":164.57,"end":165.05,"text":"Of course.","words":[["Of",164.57,164.77],["course.",164.77,165.05]]},{"start":165.51,"end":166.95,"text":"Can I make a note of your name?","words":[["Can",165.51,165.79],["I",165.79,165.91],["make",165.91,166.07],["a",166.07,166.21],["note",166.21,166.39],["of",166.39,166.55],["your",166.55,166.69],["name?",166.69,166.95]]},{"start":167.57,"end":169.77,"text":"Yes, I'm Jim, Jim Grandley.","words":[["Yes,",167.57,167.95],["I'm",168.17,168.35],["Jim,",168.35,168.55],["Jim",168.95,169.21],["Grandley.",169.21,169.77]]},{"start":169.77,"end":175.71,"text":"Thanks. And do you represent every type of musician? Can you tell me a bit about that?","words":[["Thanks.",169.77,170.41],["And",170.95,171.31],["do",171.31,171.63],["you",171.63,171.83],["represent",171.83,172.29],["every",172.29,172.73],["type",172.73,173.03],["of",173.03,173.21],["musician?",173.21,173.51],["Can",174.29,174.59],["you",174.59,174.73],["tell",174.73,174.87],["me",174.87,175.01],["a",175.01,175.11],["bit",175.11,175.17],["about",175.17,175.45],["that?",175.45,175.71]]},{"start":176.67,"end":181.73,"text":"Well, we're basically a networking agency for musicians, but we don't actually find","words":[["Well,",176.67,176.77],["we're",176.97,177.19],["basically",177.19,177.69],["a",177.69,177.97],["networking",177.97,178.35],["agency",178.35,178.99],["for",178.99,179.21],["musicians,",179.21,179.61],["but",179.61,180.39],["we",180.39,180.55],["don't",180.55,180.83],["actually",180.83,181.35],["find",181.35,181.73]]},{"start":181.73,"end":188.03,"text":"you work. We have all our members on our database, the type of music they play, and also we","words":[["you",181.73,181.93],["work.",181.93,182.31],["We",182.77,182.99],["have",182.99,183.19],["all",183.19,183.47],["our",183.47,183.65],["members",183.65,183.93],["on",183.93,184.23],["our",184.23,184.39],["database,",184.39,184.87],["the",185.39,185.57],["type",185.57,185.75],["of",185.75,185.91],["music",185.91,186.13],["they",186.13,186.31],["play,",186.31,186.65],["and",187.03,187.27],["also",187.27,187.65],["we",187.65,188.03]]},{"start":188.03,"end":191.29,"text":"can put people in touch if they want to form a band, for example.","words":[["can",188.03,188.19],["put",188.19,188.39],["people",188.39,188.71],["in",188.71,188.91],["touch",188.91,189.23],["if",189.23,189.55],["they",189.55,189.67],["want",189.67,189.81],["to",189.81,189.97],["form",189.97,190.15],["a",190.15,190.29],["band,",190.29,190.65],["for",190.77,190.87],["example.",190.87,191.29]]},{"start":191.83,"end":193.79,"text":"Is there a lot of live music here?","words":[["Is",191.83,192.15],["there",192.15,192.35],["a",192.35,192.47],["lot",192.47,192.61],["of",192.61,192.79],["live",192.79,193.03],["music",193.03,193.45],["here?",193.45,193.79]]},{"start":194.31,"end":197.97,"text":"Yes, and venues contact us when they need musicians, etc.","words":[["Yes,",194.31,194.63],["and",194.89,195.25],["venues",195.25,195.69],["contact",195.69,196.17],["us",196.17,196.57],["when",196.57,196.79],["they",196.79,196.91],["need",196.91,197.09],["musicians,",197.09,197.57],["etc.",197.71,197.97]]},{"start":198.55,"end":203.87,"text":"We deal with modern music, especially rock, which is what most people seem to enjoy around","words":[["We",198.55,199.11],["deal",199.11,199.35],["with",199.35,199.61],["modern",199.61,199.95],["music,",199.95,200.39],["especially",200.67,201.05],["rock,",201.05,201.41],["which",201.75,201.93],["is",201.93,202.03],["what",202.03,202.17],["most",202.17,202.49],["people",202.49,202.77],["seem",202.77,203.03],["to",203.03,203.19],["enjoy",203.19,203.57],["around",203.57,203.87]]},{"start":203.87,"end":207.31,"text":"here, but we do also represent some jazz musicians.","words":[["here,",203.87,204.15],["but",204.67,204.85],["we",204.85,204.99],["do",204.99,205.19],["also",205.19,205.61],["represent",205.61,206.09],["some",206.09,206.39],["jazz",206.39,206.73],["musicians.",206.73,207.31]]},{"start":208.03,"end":210.17,"text":"We don't accept classical music, I'm afraid.","words":[["We",208.03,208.23],["don't",208.23,208.51],["accept",208.51,208.83],["classical",208.83,209.31],["music,",209.31,209.69],["I'm",209.83,209.91],["afraid.",209.91,210.17]]},{"start":210.53,"end":211.65,"text":"No, that's fine.","words":[["No,",210.53,210.89],["that's",211.05,211.35],["fine.",211.35,211.65]]},{"start":212.11,"end":212.79,"text":"What do you play?","words":[["What",212.11,212.29],["do",212.29,212.43],["you",212.43,212.55],["play?",212.55,212.79]]},{"start":213.33,"end":215.93,"text":"Guitar and violin, and a bit of flute.","words":[["Guitar",213.33,213.75],["and",213.75,214.09],["violin,",214.09,214.47],["and",215.01,215.25],["a",215.25,215.37],["bit",215.37,215.45],["of",215.45,215.63],["flute.",215.63,215.93]]},{"start":216.63,"end":219.75,"text":"As I'm new here, I thought you could help me get in touch with people.","words":[["As",216.63,216.85],["I'm",216.85,217.05],["new",217.05,217.25],["here,",217.25,217.57],["I",217.69,217.79],["thought",217.79,218.01],["you",218.01,218.17],["could",218.17,218.31],["help",218.31,218.49],["me",218.49,218.65],["get",218.65,218.77],["in",218.77,218.95],["touch",218.95,219.17],["with",219.17,219.39],["people.",219.39,219.75]]},{"start":220.19,"end":220.65,"text":"I see.","words":[["I",220.19,220.35],["see.",220.35,220.65]]},{"start":221.11,"end":221.43,"text":"Sure.","words":[["Sure.",221.11,221.43]]},{"start":222.05,"end":225.93,"text":"We actually have a newsletter I could send you that would give you a good idea of","words":[["We",222.05,222.35],["actually",222.35,222.63],["have",222.63,222.91],["a",222.91,223.05],["newsletter",223.05,223.39],["I",223.39,223.73],["could",223.73,223.83],["send",223.83,224.05],["you",224.05,224.31],["that",224.31,224.69],["would",224.69,224.83],["give",224.83,224.95],["you",224.95,225.09],["a",225.09,225.19],["good",225.19,225.39],["idea",225.39,225.71],["of",225.71,225.93]]},{"start":225.93,"end":231.91,"text":"what we do and how you can benefit from joining. The latest one came out this week. Would you","words":[["what",225.93,226.07],["we",226.07,226.23],["do",226.23,226.45],["and",226.45,227.05],["how",227.05,227.25],["you",227.25,227.39],["can",227.39,227.57],["benefit",227.57,227.97],["from",227.97,228.27],["joining.",228.27,228.61],["The",229.33,229.53],["latest",229.53,229.79],["one",229.79,230.09],["came",230.09,230.33],["out",230.33,230.53],["this",230.53,230.77],["week.",230.77,231.03],["Would",231.71,231.83],["you",231.83,231.91]]},{"start":231.91,"end":238.39,"text":"like me to send you a copy? That would be great. Is it weekly? No, every month. Weekly would","words":[["like",231.91,231.99],["me",231.99,232.11],["to",232.11,232.19],["send",232.19,232.37],["you",232.37,232.51],["a",232.51,232.57],["copy?",232.57,232.81],["That",233.37,233.49],["would",233.49,233.67],["be",233.67,233.83],["great.",233.83,234.19],["Is",234.87,235.03],["it",235.03,235.17],["weekly?",235.17,235.47],["No,",236.15,236.45],["every",236.67,236.89],["month.",236.89,237.25],["Weekly",237.75,238.15],["would",238.15,238.39]]},{"start":238.39,"end":243.49,"text":"be too much work, I think. Right. And what are the costs for joining and becoming a","words":[["be",238.39,238.55],["too",238.55,238.77],["much",238.77,239.01],["work,",239.01,239.29],["I",239.35,239.47],["think.",239.47,239.63],["Right.",239.97,240.35],["And",241.09,241.31],["what",241.31,241.45],["are",241.45,241.59],["the",241.59,241.67],["costs",241.67,242.01],["for",242.01,242.35],["joining",242.35,242.69],["and",242.69,242.93],["becoming",242.93,243.25],["a",243.25,243.49]]},{"start":243.49,"end":250.31,"text":"member? Is it expensive? I'm on a tight budget. You and every other musician in the region.","words":[["member?",243.49,243.71],["Is",244.41,244.57],["it",244.57,244.69],["expensive?",244.69,245.25],["I'm",245.89,246.05],["on",246.05,246.15],["a",246.15,246.27],["tight",246.27,246.49],["budget.",246.49,246.83],["You",247.77,248.23],["and",248.23,248.57],["every",248.57,249.01],["other",249.01,249.21],["musician",249.21,249.65],["in",249.65,249.83],["the",249.83,249.93],["region.",249.93,250.31]]},{"start":250.95,"end":255.33,"text":"No, we do everything to keep costs down because we know what it's like. We're pretty","words":[["No,",250.95,251.15],["we",251.33,251.43],["do",251.43,251.61],["everything",251.61,251.95],["to",251.95,252.19],["keep",252.19,252.39],["costs",252.39,252.71],["down",252.71,253.13],["because",253.13,253.49],["we",253.49,253.67],["know",253.67,253.81],["what",253.81,253.95],["it's",253.95,254.13],["like.",254.13,254.37],["We're",254.89,255.19],["pretty",255.19,255.33]]},{"start":255.33,"end":261.85,"text":"pretty much all musicians ourselves too. So to join is just £35 and that's a one-off","words":[["pretty",255.33,255.41],["much",255.41,255.63],["all",255.63,255.87],["musicians",255.87,256.27],["ourselves",256.27,256.89],["too.",256.89,257.33],["So",258.09,258.35],["to",258.35,258.57],["join",258.57,258.89],["is",258.89,259.07],["just",259.07,259.27],["£35",259.27,259.99],["and",259.99,261.05],["that's",261.05,261.35],["a",261.35,261.45],["one",261.45,261.69],["-off",261.69,261.85]]},{"start":261.85,"end":268.27,"text":"payment. Oh actually, that's the discounted rate for young musicians under 18s. The standard","words":[["payment.",261.85,262.17],["Oh",263.01,263.21],["actually,",263.21,263.53],["that's",263.75,263.93],["the",263.93,264.03],["discounted",264.03,264.89],["rate",264.89,265.15],["for",265.15,265.39],["young",265.39,265.65],["musicians",265.65,266.15],["under",266.15,266.59],["18s.",266.59,267.29],["The",267.59,267.73],["standard",267.73,268.27]]},{"start":268.27,"end":276.49,"text":"rate is £45. Unfortunately I'm over 18. And how about joining? Can I join when I want?","words":[["rate",268.27,268.61],["is",268.61,268.89],["£45.",268.89,269.51],["Unfortunately",270.41,270.97],["I'm",270.97,271.61],["over",271.61,271.85],["18.",271.85,272.35],["And",273.17,273.49],["how",273.49,273.81],["about",273.81,274.09],["joining?",274.09,274.47],["Can",275.29,275.41],["I",275.41,275.59],["join",275.59,275.87],["when",275.87,276.07],["I",276.07,276.23],["want?",276.23,276.49]]},{"start":276.99,"end":284.17,"text":"Now for example. Or do you have a limit on numbers? No, you can join anytime. We don't","words":[["Now",276.99,277.39],["for",277.39,277.63],["example.",277.63,278.09],["Or",278.71,278.97],["do",278.97,279.11],["you",279.11,279.25],["have",279.25,279.45],["a",279.45,279.57],["limit",279.57,279.83],["on",279.83,280.11],["numbers?",280.11,280.51],["No,",281.37,281.63],["you",281.79,281.89],["can",281.89,282.07],["join",282.07,282.33],["anytime.",282.33,282.69],["We",283.53,283.83],["don't",283.83,284.17]]},{"start":284.17,"end":290.13,"text":"have a limit on the numbers of members we can have, the more the merrier, in fact. Our membership's","words":[["have",284.17,284.35],["a",284.35,284.43],["limit",284.43,284.59],["on",284.59,284.79],["the",284.79,284.89],["numbers",284.89,285.23],["of",285.23,285.41],["members",285.41,285.69],["we",285.69,285.93],["can",285.93,286.09],["have,",286.09,286.39],["the",286.77,287.07],["more",287.07,287.33],["the",287.33,287.49],["merrier,",287.49,287.93],["in",288.03,288.13],["fact.",288.13,288.47],["Our",289.35,289.53],["membership's",289.53,290.13]]},{"start":290.13,"end":299.07,"text":"gone up recently from 700 to 750. Before you hear the rest of the conversation,","words":[["gone",290.13,290.33],["up",290.33,290.51],["recently",290.51,290.93],["from",290.93,291.29],["700",291.29,292.01],["to",292.01,292.29],["750.",292.29,293.23],["Before",296.89,297.33],["you",297.33,297.59],["hear",297.59,297.85],["the",297.85,298.05],["rest",298.05,298.31],["of",298.31,298.41],["the",298.41,298.49],["conversation,",298.49,299.07]]},{"start":299.65,"end":331.4,"text":"you have some time to look at questions 6 to 10 on page 2. Now listen and answer questions","words":[["you",299.65,299.93],["have",299.93,300.15],["some",300.15,300.33],["time",300.33,300.73],["to",300.73,300.99],["look",300.99,301.13],["at",301.13,301.27],["questions",301.27,301.57],["6",301.57,302.13],["to",302.13,302.33],["10",302.33,302.73],["on",302.73,303.39],["page",303.39,303.71],["2.",303.71,304.25],["Now",329.48,329.84],["listen",329.84,330.16],["and",330.16,330.58],["answer",330.58,331.02],["questions",331.02,331.4]]},{"start":331.4,"end":340.93,"text":"6 to 10. That's good. And your ad says you also have facilities there that musicians","words":[["6",331.4,332.02],["to",332.02,332.18],["10.",332.18,332.56],["That's",335.85,336.41],["good.",336.41,336.71],["And",337.43,337.67],["your",337.67,337.83],["ad",337.83,338.03],["says",338.03,338.31],["you",338.31,338.65],["also",338.65,339.09],["have",339.09,339.41],["facilities",339.41,339.87],["there",339.87,340.39],["that",340.39,340.61],["musicians",340.61,340.93]]},{"start":340.93,"end":343.87,"text":"can use. Can you explain a bit about that?","words":[["can",340.93,341.25],["use.",341.25,341.71],["Can",342.21,342.43],["you",342.43,342.57],["explain",342.57,343.01],["a",343.01,343.23],["bit",343.23,343.31],["about",343.31,343.59],["that?",343.59,343.87]]},{"start":344.37,"end":349.55,"text":"Sure. Well, it's not huge, but we do have a couple of rooms where you can rehearse.","words":[["Sure.",344.37,344.71],["Well,",345.33,345.59],["it's",345.75,345.91],["not",345.91,346.03],["huge,",346.03,346.51],["but",346.69,346.95],["we",346.95,347.11],["do",347.11,347.29],["have",347.29,347.55],["a",347.55,347.65],["couple",347.65,347.95],["of",347.95,348.13],["rooms",348.13,348.41],["where",348.41,348.69],["you",348.69,348.81],["can",348.81,348.95],["rehearse.",348.95,349.55]]},{"start":349.95,"end":355.93,"text":"They're soundproof. And we've just opened a studio, a small one. And it's already proving","words":[["They're",349.95,350.17],["soundproof.",350.17,350.63],["And",351.11,351.51],["we've",351.51,351.73],["just",351.73,351.97],["opened",351.97,352.43],["a",352.43,352.61],["studio,",352.61,352.95],["a",353.37,353.51],["small",353.51,353.71],["one.",353.71,353.95],["And",354.51,354.85],["it's",354.85,355.07],["already",355.07,355.49],["proving",355.49,355.93]]},{"start":355.93,"end":360.15,"text":"popular with bands that want to send demo tapes to venues and record labels.","words":[["popular",355.93,356.37],["with",356.37,356.69],["bands",356.69,357.05],["that",357.05,357.29],["want",357.29,357.45],["to",357.45,357.63],["send",357.63,357.85],["demo",357.85,358.21],["tapes",358.21,358.59],["to",358.59,358.83],["venues",358.83,359.19],["and",359.19,359.45],["record",359.45,359.75],["labels.",359.75,360.15]]},{"start":360.55,"end":365.81,"text":"Wow, that sounds brilliant! And is that free? Guess not.","words":[["Wow,",360.55,361.15],["that",361.45,361.61],["sounds",361.61,362.01],["brilliant!",362.01,362.59],["And",363.39,363.79],["is",363.79,363.91],["that",363.91,364.09],["free?",364.09,364.49],["Guess",365.21,365.49],["not.",365.49,365.81]]},{"start":365.81,"end":373.29,"text":"No, that's extra. But we do have some free services. For example, we can offer legal advice","words":[["No,",365.81,366.79],["that's",367.01,367.31],["extra.",367.31,367.69],["But",368.23,368.41],["we",368.41,368.61],["do",368.61,368.79],["have",368.79,369.01],["some",369.01,369.25],["free",369.25,369.65],["services.",369.65,370.21],["For",370.87,371.01],["example,",371.01,371.41],["we",371.97,372.07],["can",372.07,372.23],["offer",372.23,372.45],["legal",372.45,372.89],["advice",372.89,373.29]]},{"start":373.29,"end":377.93,"text":"if you need it, for contracts and things like that. Pretty useful stuff, you know.","words":[["if",373.29,373.53],["you",373.53,373.61],["need",373.61,373.75],["it,",373.75,373.95],["for",374.25,374.37],["contracts",374.37,374.83],["and",374.83,375.15],["things",375.15,375.41],["like",375.41,375.59],["that.",375.59,375.83],["Pretty",376.51,376.75],["useful",376.75,377.15],["stuff,",377.15,377.59],["you",377.75,377.81],["know.",377.81,377.93]]},{"start":378.31,"end":384.11,"text":"Great. So if I'm interested, what's the next step? How do I become a member?","words":[["Great.",378.31,378.71],["So",379.45,379.87],["if",379.87,380.13],["I'm",380.13,380.39],["interested,",380.39,380.85],["what's",381.21,381.45],["the",381.45,381.59],["next",381.59,381.91],["step?",381.91,382.35],["How",383.01,383.25],["do",383.25,383.39],["I",383.39,383.51],["become",383.51,383.75],["a",383.75,383.93],["member?",383.93,384.11]]},{"start":384.79,"end":390.67,"text":"Well, simple really. Just send us a letter with your contact details and a recording made","words":[["Well,",384.79,385.15],["simple",385.37,385.79],["really.",385.79,386.15],["Just",386.71,386.93],["send",386.93,387.31],["us",387.31,387.47],["a",387.47,387.61],["letter",387.61,387.79],["with",387.79,388.05],["your",388.05,388.19],["contact",388.19,388.53],["details",388.53,389.03],["and",389.03,389.79],["a",389.79,389.93],["recording",389.93,390.29],["made",390.29,390.67]]},{"start":390.67,"end":395.11,"text":"within the last couple of months. That'll give other members an idea of what you play.","words":[["within",390.67,390.95],["the",390.95,391.11],["last",391.11,391.41],["couple",391.41,391.65],["of",391.65,391.79],["months.",391.79,392.07],["That'll",392.55,392.95],["give",392.95,393.07],["other",393.07,393.35],["members",393.35,393.65],["an",393.65,393.91],["idea",393.91,394.17],["of",394.17,394.41],["what",394.41,394.55],["you",394.55,394.75],["play.",394.75,395.11]]},{"start":395.11,"end":401.07,"text":"And where are you based? We're at 707 Kipak Street, Marbury.","words":[["And",395.11,396.29],["where",396.29,396.63],["are",396.63,396.77],["you",396.77,396.87],["based?",396.87,397.31],["We're",397.83,397.97],["at",397.97,398.09],["707",398.09,399.01],["Kipak",399.01,399.71],["Street,",399.71,400.15],["Marbury.",400.65,401.07]]},{"start":401.67,"end":408.69,"text":"How do you spell Kipaks? It's K-I-P-A-X. And is there an email address?","words":[["How",401.67,402.05],["do",402.05,402.19],["you",402.19,402.31],["spell",402.31,402.61],["Kipaks?",402.61,403.25],["It's",404.03,404.41],["K",404.41,404.69],["-I",404.69,405.05],["-P",405.05,405.39],["-A",405.39,406.21],["-X.",406.21,406.71],["And",407.11,407.53],["is",407.53,407.73],["there",407.73,407.91],["an",407.91,408.07],["email",408.07,408.25],["address?",408.25,408.69]]},{"start":409.45,"end":417.59,"text":"Yes, it's music.talent at bsu.co.uk. Talent is in the word?","words":[["Yes,",409.45,409.75],["it's",410.07,410.43],["music",410.43,411.01],[".talent",411.01,412.09],["at",412.09,412.75],["bsu",412.75,413.83],[".co",413.83,414.67],[".uk.",414.67,415.41],["Talent",416.01,416.63],["is",416.63,416.95],["in",416.95,417.13],["the",417.13,417.29],["word?",417.29,417.59]]},{"start":417.99,"end":427.58,"text":"Yes. Right. Just one last thing. That is the end of section one.","words":[["Yes.",417.99,418.27],["Right.",418.89,419.29],["Just",420.19,420.65],["one",420.65,421.07],["last",421.07,421.47],["thing.",421.47,421.79],["That",425.48,425.94],["is",425.94,426.1],["the",426.1,426.24],["end",426.24,426.64],["of",426.64,426.84],["section",426.84,427.1],["one.",427.1,427.58]]},{"start":427.58,"end":431.22,"text":"You now have half a minute to check your answers.","words":[["You",427.58,428.58],["now",428.58,428.88],["have",428.88,429.22],["half",429.22,429.54],["a",429.54,429.72],["minute",429.72,429.98],["to",429.98,430.3],["check",430.3,430.64],["your",430.64,430.84],["answers.",430.84,431.22]]},{"start":461.71,"end":464.77,"text":"Now turn to section 2 on page 3.","words":[["Now",461.71,461.97],["turn",461.97,462.25],["to",462.25,462.49],["section",462.49,462.79],["2",462.79,463.33],["on",463.33,463.93],["page",463.93,464.27],["3.",464.27,464.77]]}]}