payment?","words":[["Right.",310.2,310.42],["And",310.96,311.2],["at",311.2,311.3],["what",311.3,311.44],["point",311.44,311.76],["might",311.76,312.14],["I",312.14,312.26],["receive",312.26,312.58],["a",312.58,312.7],["payment?",312.7,313.06]]},{"start":313.6,"end":317.76,"text":"Not sure. But once it's over, the college sends the employer a form","words":[["Not",313.6,314.02],["sure.",314.02,314.38],["But",314.92,315.12],["once",315.12,315.3],["it's",315.3,315.52],["over,",315.52,315.8],["the",316.04,316.1],["college",316.1,316.34],["sends",316.34,316.68],["the",316.68,316.86],["employer",316.86,317.24],["a",317.24,317.48],["form",317.48,317.76]]},{"start":317.76,"end":319.86,"text":"which they can choose to fill out or not","words":[["which",317.76,318.24],["they",318.24,318.38],["can",318.38,318.5],["choose",318.5,318.72],["to",318.72,318.94],["fill",318.94,319.12],["out",319.12,319.3],["or",319.3,319.54],["not",319.54,319.86]]},{"start":319.86,"end":323.78,"text":"about how well you did and what they recommend you focus on next time.","words":[["about",319.86,320.46],["how",320.46,320.68],["well",320.68,320.96],["you",320.96,321.16],["did",321.16,321.38],["and",321.38,321.96],["what",321.96,322.14],["they",322.14,322.32],["recommend",322.32,322.62],["you",322.62,322.82],["focus",322.82,323.08],["on",323.08,323.28],["next",323.28,323.48],["time.",323.48,323.78]]},{"start":325.26,"end":330.88,"text":"That is the end of Part 3.","words":[["That",325.26,325.82],["is",328.92,329.48],["the",329.48,329.66],["end",329.66,330.1],["of",330.1,330.28],["Part",330.28,330.5],["3.",330.5,330.88]]},{"start":331.52,"end":335.84,"text":"You now have 30 seconds to check your answers to Part 3.","words":[["You",331.52,331.98],["now",331.98,332.3],["have",332.3,332.7],["30",332.7,333.1],["seconds",333.1,333.62],["to",333.62,333.92],["check",333.92,334.24],["your",334.24,334.46],["answers",334.46,334.88],["to",334.88,335.2],["Part",335.2,335.4],["3.",335.4,335.84]]}]}