2.78],["in",122.78,123.1],["yourself",123.1,123.46],["isn't",123.46,123.96],["enough",123.96,124.26],["by",124.26,124.56],["itself",124.56,125.08]]},{"start":125.08,"end":131.3,"text":"to guarantee success. Confidence can be a good thing, but a person can have too","words":[["to",125.08,125.32],["guarantee",125.32,125.66],["success.",125.66,126.4],["Confidence",127.3,127.9],["can",127.9,128.48],["be",128.48,128.66],["a",128.66,128.8],["good",128.8,128.94],["thing,",128.94,129.38],["but",129.44,129.96],["a",129.96,130.1],["person",130.1,130.44],["can",130.44,130.7],["have",130.7,130.98],["too",130.98,131.3]]},{"start":131.3,"end":137.96,"text":"much confidence. And people who try to learn to be confident by buying those how to succeed","words":[["much",131.3,131.8],["confidence.",131.8,132.34],["And",133.18,133.34],["people",133.34,133.66],["who",133.66,133.84],["try",133.84,134.08],["to",134.08,134.28],["learn",134.28,134.64],["to",134.64,134.9],["be",134.9,135.06],["confident",135.06,135.5],["by",135.5,135.86],["buying",135.86,136.62],["those",136.62,136.94],["how",136.94,137.28],["to",137.28,137.44],["succeed",137.44,137.96]]},{"start":137.96,"end":144.82,"text":"books are just wasting their time. The advice given in these American studies was that being","words":[["books",137.96,138.46],["are",138.46,139.04],["just",139.04,139.2],["wasting",139.2,139.6],["their",139.6,139.9],["time.",139.9,140.34],["The",141.28,141.44],["advice",141.44,141.84],["given",141.84,142.1],["in",142.1,142.28],["these",142.28,142.46],["American",142.46,142.92],["studies",142.92,143.46],["was",143.46,144.24],["that",144.24,144.48],["being",144.48,144.82]]},{"start":144.82,"end":151.52,"text":"a successful entrepreneur comes down to having the right attitude. It's no good getting","words":[["a",144.82,145.22],["successful",145.22,145.72],["entrepreneur",145.72,146.42],["comes",146.42,147.34],["down",147.34,147.68],["to",147.68,147.86],["having",147.86,148.18],["the",148.18,148.54],["right",148.54,148.84],["attitude.",148.84,149.54],["It's",150.2,150.6],["no",150.6,150.76],["good",150.76,151.08],["getting",151.08,151.52]]},{"start":151.52,"end":157.36,"text":"depressed every time something goes wrong. Always keep your goals in mind and never","words":[["depressed",151.52,152.18],["every",152.18,152.66],["time",152.66,152.94],["something",152.94,153.32],["goes",153.32,153.7],["wrong.",153.7,154.16],["Always",154.76,155.22],["keep",155.22,155.5],["your",155.5,155.7],["goals",155.7,156.18],["in",156.18,156.44],["mind",156.44,156.84],["and",156.84,157.06],["never",157.06,157.36]]},{"start":157.36,"end":164.04,"text":"give up and don't listen to all the people around you who say oh this will never work.","words":[["give",157.36,157.54],["up",157.54,157.8],["and",157.8,158.68],["don't",158.68,159.2],["listen",159.2,159.54],["to",159.54,159.78],["all",159.78,159.96],["the",159.96,160.08],["people",160.08,160.4],["around",160.4,160.84],["you",160.84,161.24],["who",161.24,161.7],["say",161.7,161.96],["oh",161.96,162.52],["this",162.52,162.9],["will",162.9,163.12],["never",163.12,163.44],["work.",163.44,164.04]]},{"start":165.06,"end":169.9,"text":"One thing I've learned in business is that you don't have to be an expert in everything","words":[["One",165.06,165.64],["thing",165.64,165.86],["I've",165.86,166.14],["learned",166.14,166.36],["in",166.36,166.56],["business",166.56,166.92],["is",166.92,167.52],["that",167.52,167.66],["you",167.66,167.76],["don't",167.76,168.06],["have",168.06,168.26],["to",168.26,168.4],["be",168.4,168.58],["an",168.58,168.7],["expert",168.7,169.16],["in",169.16,169.52],["everything",169.52,169.9]]},{"start":169.9,"end":176.42,"text":"like marketing for example. When I started my business I tried to do it all myself but","words":[["like",169.9,170.56],["marketing",170.56,171.08],["for",171.08,171.38],["example.",171.38,171.82],["When",172.6,172.82],["I",172.82,172.98],["started",172.98,173.3],["my",173.3,173.56],["business",173.56,1