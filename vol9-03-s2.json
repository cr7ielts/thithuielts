,235.71],["attendant.",235.71,236.11],["Peter",237.07,237.53],["Marshall",237.53,237.99],["had",237.99,238.23]]},{"start":238.23,"end":243.31,"text":"read about work opportunities on the zoo website and just went along with a friend to talk to","words":[["read",238.23,238.41],["about",238.41,238.61],["work",238.61,238.93],["opportunities",238.93,239.55],["on",239.55,239.93],["the",239.93,240.05],["zoo",240.05,240.25],["website",240.25,240.73],["and",240.73,241.53],["just",241.53,241.75],["went",241.75,241.95],["along",241.95,242.21],["with",242.21,242.39],["a",242.39,242.53],["friend",242.53,242.77],["to",242.77,242.95],["talk",242.95,243.17],["to",243.17,243.31]]},{"start":243.31,"end":249.19,"text":"someone in personnel. He was offered a job there and then, as easy as that. In previous","words":[["someone",243.31,243.57],["in",243.57,243.73],["personnel.",243.73,244.11],["He",245.05,245.21],["was",245.21,245.31],["offered",245.31,245.53],["a",245.53,245.67],["job",245.67,245.97],["there",245.97,246.39],["and",246.39,246.57],["then,",246.57,246.77],["as",247.07,247.25],["easy",247.25,247.49],["as",247.49,247.65],["that.",247.65,247.85],["In",248.59,248.91],["previous",248.91,249.19]]},{"start":249.19,"end":254.05,"text":"years he'd done singularly unexciting shop work, so he was very pleased to be doing","words":[["years",249.19,249.63],["he'd",249.63,249.93],["done",249.93,250.09],["singularly",250.09,250.87],["unexciting",250.87,251.53],["shop",251.53,251.85],["work,",251.85,252.19],["so",252.61,252.91],["he",252.91,253.03],["was",253.03,253.15],["very",253.15,253.33],["pleased",253.33,253.69],["to",253.69,253.81],["be",253.81,253.87],["doing",253.87,254.05]]},{"start":254.05,"end":260.19,"text":"such original work. He ended up working for just under three months, which was actually","words":[["such",254.05,254.25],["original",254.25,254.75],["work.",254.75,255.11],["He",256.29,256.77],["ended",256.77,256.95],["up",256.95,257.13],["working",257.13,257.45],["for",