349.4],["particular",349.4,349.84]]},{"start":349.84,"end":355.52,"text":"achievement was their stylish and clever working of crystal. Although these perfume","words":[["achievement",349.84,350.4],["was",350.4,351.0],["their",351.0,351.2],["stylish",351.2,351.72],["and",351.72,352.1],["clever",352.1,352.48],["working",352.48,352.92],["of",352.92,353.24],["crystal.",353.24,353.64],["Although",354.56,354.86],["these",354.86,355.22],["perfume",355.22,355.52]]},{"start":355.52,"end":360.76,"text":"ornaments were very expensive, Tiffany and Co. were able to use catalogs to reach","words":[["ornaments",355.52,355.94],["were",355.94,356.2],["very",356.2,356.52],["expensive,",356.52,357.1],["Tiffany",357.72,357.94],["and",357.94,358.22],["Co.",358.22,358.38],["were",358.78,358.92],["able",358.92,359.22],["to",359.22,359.4],["use",359.4,359.64],["catalogs",359.64,360.42],["to",360.42,360.54],["reach",360.54,360.76]]},{"start":360.76,"end":362.06,"text":"a wider clientele.","words":[["a",360.76,360.98],["wider",360.98,361.26],["clientele.",361.26,362.06]]},{"start":363.02,"end":369.64,"text":"Many innovative designs were used in perfume ornaments produced in the 1920s and 30s. The most","words":[["Many",363.02,363.74],["innovative",363.74,364.32],["designs",364.32,364.8],["were",364.8,365.16],["used",365.16,365.56],["in",365.56,365.76],["perfume",365.76,366.06],["ornaments",366.06,366.52],["produced",366.52,366.96],["in",366.96,367.32],["the",367.32,367.4],["1920s",367.4,368.22],["and",368.22,368.32],["30s.",368.32,368.92],["The",369.22,369.38],["most",369.38,369.64]]},{"start":369.64,"end":376.38,"text":"notable was probably the vanity. This was an ingeniously designed case used not only for holding","words":[["notable",369.64,370.04],["was",370.04,370.76],["probably",370.76,371.34],["the",371.34,371.6],["vanity.",371.6,372.02],["This",372.74,373.0],["was",373.0,373.16],["an",373.16,373.32],["ingeniously",373.32,373.94],["designed",373.94,374.44],["case",374.44,374.9],["used",374.9,375.42],["not",375.42,375.66],["only",375.66,375.92],["for",375.92,376.06],["holding",376.06,376.38]]},{"start":376.38,"end":383.4,"text":"perfume but also makeup in a whole maze of tiny additional compartments. It was made in the","words":[["perfume",376.38,376.8],["but",376.8,377.42],["also",377.42,377.74],["makeup",377.74,378.12],["in",378.12,378.72],["a",378.72,378.84],["whole",378.84,379.06],["maze",379.06,379.4],["of",379.4,379.68],["tiny",379.68,380.08],["additional",380.08,380.68],["compartments.",380.68,381.48],["It",382.1,382.82],["was",382.82,382.94],["made",382.94,383.14],["in",383.14,383.3],["the",383.3,383.4]]},{"start":383.4,"end":389.46,"text":"first instance of ivory but later Bakelite was used, the resinous plastic which was so popular","words":[["first",383.4,383.62],["instance",383.62,384.08],["of",384.08,384.4],["ivory",384.4,384.76],["but",384.76,385.56],["later",385.56,385.92],["Bakelite",385.92,386.44],["was",386.44,386.66],["used,",386.66,386.94],["the",387.36,387.48],["resinous",387.48,387.9],["plastic",387.9,388.34],["which",388.34,388.62],["was",388.62,388.8],["so",388.8,388.98],["popular",388.98,389.46]]},{"start":389.46,"end":391.54,"text":"with all kinds of designers of the period.","words":[["with",389.46,389.66],["all",389.66,389.84],["kinds",389.84,390.08],["of",390.08,390.4],["designers",390.4,390.86],["of",390.86,391.1],["the",391.1,391.18],["period.",391.18,391.54]]},{"start":392.56,"end":397.56,"text":"Now I've brought along a selection of the items in the collection which I've set out here.","words":[["Now",392.56,392.88],["I've",392.88,393.26],["brought",393.26,393.48],["along",393.48,393.8],["a",393.8,394.04],["selection",394.04,394.36],["of",394.36,394.64],["the",394.64,394.74],["items",394.74,395.12],["in",395.12,395.42],["the",395.42,395.52],["collection",395.52,395.94],["which",395.94,396.56],["I've",396.56,396.82],["set",396.82,397.0],["out",397.0,397.24],["here.",397.24,397.56]]},{"start":398.54,"end":405.18,"te