catch",341.94,342.2],["on",342.2,342.48],["as",342.48,342.66],["well",342.66,342.82],["as",342.82,342.96],["bitchu",342.96,343.3],["blocks.",343.3,343.64]]},{"start":343.88,"end":353.18,"text":"I'm not sure. I think the key to commercial success will be things like tax breaks for any companies producing materials, incorporating recycled materials.","words":[["I'm",343.88,344.08],["not",344.08,344.24],["sure.",344.24,344.56],["I",345.18,345.56],["think",345.56,345.88],["the",345.88,346.08],["key",346.08,346.36],["to",346.36,346.58],["commercial",346.58,347.0],["success",347.0,347.56],["will",347.56,347.78],["be",347.78,347.92],["things",347.92,348.18],["like",348.18,348.44],["tax",348.44,348.86],["breaks",348.86,349.24],["for",349.24,349.52],["any",349.52,349.66],["companies",349.66,350.04],["producing",350.04,350.5],["materials,",350.5,351.1],["incorporating",351.18,351.8],["recycled",351.8,352.54],["materials.",352.54,353.18]]},{"start":353.18,"end":359.12,"text":"yes that's true it'll be interesting to see what happens anyway so what do you","words":[["yes",353.18,353.76],["that's",353.76,354.24],["true",354.24,354.56],["it'll",354.56,355.58],["be",355.58,355.68],["interesting",355.68,356.0],["to",356.0,356.22],["see",356.22,356.38],["what",356.38,356.54],["happens",356.54,356.92],["anyway",356.92,357.28],["so",357.28,358.44],["what",358.44,358.78],["do",358.78,358.98],["you",358.98,359.12]]},{"start":359.12,"end":367.43,"text":"know that is the end of section three you now have half a minute to check your","words":[["know",359.12,359.24],["that",359.24,360.2],["is",362.79,362.97],["the",362.97,363.11],["end",363.11,363.51],["of",363.51,363.69],["section",363.69,363.97],["three",363.97,364.45],["you",364.45,365.43],["now",365.43,365.69],["have",365.69,366.01],["half",366.01,366.35],["a",366.35,366.47],["minute",366.47,366.69],["to",366.69,366.97],["check",366.97,367.23],["your",367.23,367.43]]},{"start":367.43,"end":367.77,"text":"answers","words":[["answers",367.