{"id":"forecast-07","section":1,"path":"bank/listening/forecast-07/audio-1.mp3","model":"small","duration":375.88,"segments":[{"start":0.85,"end":1.91,"text":"Section 1.","words":[["Section",0.85,1.45],["1.",1.45,1.91]]},{"start":3.21,"end":8.19,"text":"You will hear a man inquiring about joining a wildlife conservation society.","words":[["You",3.21,3.77],["will",3.77,3.95],["hear",3.95,4.11],["a",4.11,4.29],["man",4.29,4.57],["inquiring",4.57,5.29],["about",5.29,5.57],["joining",5.57,6.03],["a",6.03,6.29],["wildlife",6.29,6.63],["conservation",6.63,7.31],["society.",7.31,8.19]]},{"start":9.47,"end":14.35,"text":"First, you have some time to look at questions 1 to 6 on page 2.","words":[["First,",9.47,10.03],["you",10.23,10.27],["have",10.27,10.43],["some",10.43,10.61],["time",10.61,10.93],["to",10.93,11.17],["look",11.17,11.33],["at",11.33,11.49],["questions",11.49,11.79],["1",11.79,12.31],["to",12.31,12.49],["6",12.49,12.91],["on",12.91,13.59],["page",13.59,13.87],["2.",13.87,14.35]]},{"start":39.62,"end":42.66,"text":"You will see that there is an example that has been done for you.","words":[["You",39.62,39.84],["will",39.84,40.02],["see",40.02,40.24],["that",40.24,40.44],["there",40.44,40.6],["is",40.6,40.76],["an",40.76,40.86],["example",40.86,41.34],["that",41.34,41.6],["has",41.6,41.7],["been",41.7,41.84],["done",41.84,42.08],["for",42.08,42.4],["you.",42.4,42.66]]},{"start":43.3,"end":48.0,"text":"On this occasion only, the conversation relating to this will be played first.","words":[["On",43.3,43.58],["this",43.58,43.8],["occasion",43.8,44.12],["only,",44.12,44.52],["the",45.0,45.16],["conversation",45.16,45.6],["relating",45.6,46.24],["to",46.24,46.52],["this",46.52,46.76],["will",46.76,47.1],["be",47.1,47.26],["played",47.26,47.64],["first.",47.64,48.0]]},{"start":51.64,"end":55.14,"text":"Wildlife Conservation Society, good afternoon, can I help you?","words":[["Wildlife",51.64,52.2],["Conservation",52.2,52.76],["Society,",52.76,53.26],["good",53.74,53.84],["afternoon,",53.84,54.3],["can",54.48,54.6],["I",54.6,54.72],["help",54.72,54.9],["you?",54.9,55.14]]},{"start":55.14,"end":59.4,"text":"Oh, hello. Yes, I'd like to join, please.","words":[["Oh,",55.14,56.04],["hello.",56.12,56.32],["Yes,",57.08,57.62],["I'd",58.02,58.3],["like",58.3,58.42],["to",58.42,58.58],["join,",58.58,58.96],["please.",59.18,59.4]]},{"start":60.14,"end":65.06,"text":"Oh, yes, certainly. I just get some details from you. Could I have your name?","words":[["Oh,",60.14,60.36],["yes,",60.4,60.64],["certainly.",60.86,61.12],["I",61.74,61.98],["just",61.98,62.18],["get",62.18,62.34],["some",62.34,62.52],["details",62.52,62.86],["from",62.86,63.24],["you.",63.24,63.5],["Could",64.18,64.44],["I",64.44,64.56],["have",64.56,64.66],["your",64.66,64.78],["name?",64.78,65.06]]},{"start":65.78,"end":67.1,"text":"Michael Jones.","words":[["Michael",65.78,66.18],["Jones.",66.18,67.1]]},{"start":71.01,"end":77.23,"text":"The caller's name is Michael Jones. So Michael Jones has been written in the space.","words":[["The",71.01,71.39],["caller's",71.39,71.89],["name",71.89,72.19],["is",72.19,72.57],["Michael",72.57,72.93],["Jones.",72.93,73.57],["So",74.19,74.57],["Michael",74.57,75.09],["Jones",75.09,75.69],["has",75.69,76.17],["been",76.17,76.33],["written",76.33,76.57],["in",76.57,76.83],["the",76.83,76.93],["space.",76.93,77.23]]},{"start":78.63,"end":85.83,"text":"Now we shall begin. You should answer the questions as you listen, because you will not hear the recording a second time.","words":[["Now",78.63,79.19],["we",79.19,79.39],["shall",79.39,79.55],["begin.",79.55,79.89],["You",80.75,80.91],["should",80.91,81.05],["answer",81.05,81.31],["the",81.31,81.47],["questions",81.47,81.83],["as",81.83,82.31],["you",82.31,82.47],["listen,",82.47,82.79],["because",83.19,83.41],["you",83.41,83.61],["will",83.61,83.73],["not",83.73,83.97],["hear",83.97,84.27],["the",84.27,84.41],["recording",84.41,84.83],["a",84.83,85.11],["second",85.11,85.35],["time.",85.35,85.83]]},{"start":86.79,"end":90.33,"text":"Listen carefully and answer questions one to six.","words":[["Listen",86.79,87.35],["carefully",87.35,87.87],["and",87.87,88.29],["answer",88.29,88.73],["questions",88.73,89.23],["one",89.23,89.73],["to",89.73,89.93],["six.",89.93,90.33]]},{"start":93.76,"end":97.3,"text":"Wildlife Conservation Society. Good afternoon. Can I help you?","words":[["Wildlife",93.76,94.32],["Conservation",94.32,94.88],["Society.",94.88,95.54],["Good",95.88,96.0],["afternoon.",96.0,96.46],["Can",96.68,96.76],["I",96.76,96.86],["help",96.86,97.06],["you?",97.06,97.3]]},{"start":97.82,"end":101.54,"text":"Oh, hello. Yes, I'd like to join, please.","words":[["Oh,",97.82,98.2],["hello.",98.24,98.5],["Yes,",99.24,99.72],["I'd",100.0,100.44],["like",100.44,100.56],["to",100.56,100.74],["join,",100.74,101.06],["please.",101.34,101.54]]},{"start":102.24,"end":107.2,"text":"Oh, yes, certainly. I just get some details from you. Could I have your name?","words":[["Oh,",102.24,102.52],["yes,",102.54,102.8],["certainly.",102.94,103.28],["I",103.96,104.12],["just",104.12,104.32],["get",104.32,104.5],["some",104.5,104.68],["details",104.68,105.0],["from",105.0,105.4],["you.",105.4,105.66],["Could",106.2,106.6],["I",106.6,106.72],["have",106.72,106.84],["your",106.84,106.94],["name?",106.94,107.2]]},{"start":108.08,"end":109.2,"text":"Michael Jones.","words":[["Michael",108.08,108.64],["Jones.",108.64,109.2]]},{"start":109.82,"end":116.64,"text":"Right. And can I ask where you heard about us? Was it in an advert, or did a friend tell you?","words":[["Right.",109.82,110.38],["And",111.18,111.54],["can",111.54,111.74],["I",111.74,111.92],["ask",111.92,112.16],["where",112.16,112.36],["you",112.36,112.5],["heard",112.5,112.74],["about",112.74,112.96],["us?",112.96,113.3],["Was",113.88,114.14],["it",114.14,114.3],["in",114.3,114.42],["an",114.42,114.56],["advert,",114.56,114.86],["or",115.24,115.44],["did",115.44,115.66],["a",115.66,115.8],["friend",115.8,116.02],["tell",116.02,116.34],["you?",116.34,116.64]]},{"start":116.64,"end":124.6,"text":"Or neither actually it was a radio program. Then I just got your number from the phone book. Oh, right","words":[["Or",116.64,117.3],["neither",117.3,117.78],["actually",117.78,118.32],["it",118.32,118.74],["was",118.74,118.96],["a",118.96,119.22],["radio",119.22,119.56],["program.",119.56,119.96],["Then",120.22,121.02],["I",121.02,121.2],["just",121.2,121.42],["got",121.42,121.78],["your",121.78,121.94],["number",121.94,122.2],["from",122.2,122.44],["the",122.44,122.58],["phone",122.58,122.78],["book.",122.78,123.08],["Oh,",123.38,124.12],["right",124.2,124.6]]},{"start":125.64,"end":131.34,"text":"Now I need some membership details. It's Michael Jones and the address","words":[["Now",125.64,126.14],["I",126.14,126.58],["need",126.58,126.86],["some",126.86,127.06],["membership",127.06,127.46],["details.",127.46,128.08],["It's",128.48,129.28],["Michael",129.28,129.6],["Jones",129.6,130.04],["and",130.04,130.76],["the",130.76,130.94],["address",130.94,131.34]]},{"start":132.12,"end":133.72,"text":"21 Beale Street","words":[["21",132.12,132.52],["Beale",132.52,133.42],["Street",133.42,133.72]]},{"start":134.68,"end":135.12,"text":"Okay","words":[["Okay",134.68,135.12]]},{"start":135.92,"end":136.62,"text":"Leads","words":[["Leads",135.92,136.62]]},{"start":137.48,"end":143.58,"text":"Fine, and do you know your postcode? Yes, it's LS 14","words":[["Fine,",137.48,138.16],["and",138.38,139.2],["do",139.2,139.34],["you",139.34,139.42],["know",139.42,139.54],["your",139.54,139.7],["postcode?",139.7,140.24],["Yes,",140.78,141.16],["it's",141.26,141.66],["LS",141.66,142.38],["14",142.38,143.58]]},{"start":144.28,"end":146.14,"text":"to jw","words":[["to",144.28,144.8],["jw",144.8,146.14]]},{"start":147.24,"end":152.0,"text":"Okay. And do you have a daytime telephone number we can contact you on?","words":[["Okay.",147.24,147.76],["And",148.34,148.78],["do",148.78,149.2],["you",149.2,149.34],["have",149.34,149.52],["a",149.52,149.64],["daytime",149.64,149.9],["telephone",149.9,150.32],["number",150.32,150.76],["we",150.76,150.92],["can",150.92,151.08],["contact",151.08,151.46],["you",151.46,151.8],["on?",151.8,152.0]]},{"start":152.28,"end":162.04,"text":"Yes, you can call me at work. The number is 0117358642.","words":[["Yes,",152.28,152.64],["you",152.86,152.96],["can",152.96,153.08],["call",153.08,153.32],["me",153.32,153.46],["at",153.46,153.56],["work.",153.56,153.86],["The",154.32,154.38],["number",154.38,154.66],["is",154.66,155.02],["0117358642.",155.02,162.04]]},{"start":163.22,"end":166.2,"text":"And I can give you my office email address if you like.","words":[["And",163.22,163.74],["I",163.74,163.9],["can",163.9,164.04],["give",164.04,164.22],["you",164.22,164.32],["my",164.32,164.5],["office",164.5,164.86],["email",164.86,165.2],["address",165.2,165.64],["if",165.64,165.9],["you",165.9,165.96],["like.",165.96,166.2]]},{"start":166.88,"end":169.0,"text":"That would probably be useful. Yes, please.","words":[["That",166.88,167.28],["would",167.28,167.38],["probably",167.38,167.7],["be",167.7,167.9],["useful.",167.9,168.24],["Yes,",168.54,168.72],["please.",168.78,169.0]]},{"start":169.0,"end":176.66,"text":"It's MJ at Hennings.co.uk.","words":[["It's",169.0,170.06],["MJ",170.06,171.16],["at",171.16,172.68],["Hennings",172.68,173.96],[".co",173.96,175.18],[".uk.",175.18,176.66]]},{"start":177.48,"end":181.54,"text":"Is that H-E-N-N-I-N-G-S?","words":[["Is",177.48,178.12],["that",178.12,178.34],["H",178.34,178.84],["-E",178.84,179.2],["-N",179.2,179.66],["-N",179.66,180.2],["-I",180.2,180.56],["-N",180.56,180.94],["-G",180.94,181.08],["-S?",181.08,181.54]]},{"start":181.98,"end":182.54,"text":"That's right.","words":[["That's",181.98,182.38],["right.",182.38,182.54]]},{"start":183.12,"end":183.7,"text":"Thank you.","words":[["Thank",183.12,183.46],["you.",183.46,183.7]]},{"start":184.84,"end":188.8,"text":"Now I just need to ask you some questions about exactly what you want.","words":[["Now",184.84,185.2],["I",185.2,185.38],["just",185.38,185.62],["need",185.62,185.78],["to",185.78,185.94],["ask",185.94,186.22],["you",186.22,186.42],["some",186.42,186.62],["questions",186.62,187.12],["about",187.12,187.5],["exactly",187.5,188.06],["what",188.06,188.34],["you",188.34,188.54],["want.",188.54,188.8]]},{"start":189.66,"end":192.52,"text":"First of all, how long do you want the membership for?","words":[["First",189.66,189.96],["of",189.96,190.14],["all,",190.14,190.36],["how",190.8,191.08],["long",191.08,191.28],["do",191.28,191.42],["you",191.42,191.48],["want",191.48,191.66],["the",191.66,191.8],["membership",191.8,192.04],["for?",192.04,192.52]]},{"start":192.92,"end":197.56,"text":"We do two, three and five year memberships and we also do one for life.","words":[["We",192.92,193.14],["do",193.14,193.4],["two,",193.4,193.9],["three",193.98,194.4],["and",194.4,194.66],["five",194.66,195.02],["year",195.02,195.2],["memberships",195.2,195.78],["and",195.78,196.32],["we",196.32,196.42],["also",196.42,196.72],["do",196.72,196.9],["one",196.9,197.1],["for",197.1,197.24],["life.",197.24,197.56]]},{"start":197.56,"end":201.68,"text":"Uh, I think I'll just get the minimum length this time around.","words":[["Uh,",197.56,198.58],["I",198.76,198.94],["think",198.94,199.26],["I'll",199.26,199.52],["just",199.52,199.72],["get",199.72,199.9],["the",199.9,200.08],["minimum",200.08,200.42],["length",200.42,200.82],["this",200.82,201.08],["time",201.08,201.34],["around.",201.34,201.68]]},{"start":202.22,"end":204.9,"text":"Fine. And then the type of membership.","words":[["Fine.",202.22,202.74],["And",203.4,203.7],["then",203.7,203.88],["the",203.88,204.06],["type",204.06,204.36],["of",204.36,204.54],["membership.",204.54,204.9]]},{"start":205.32,"end":209.46,"text":"We do single, joint, or family, which covers up to four children.","words":[["We",205.32,205.48],["do",205.48,205.68],["single,",205.68,206.3],["joint,",206.66,206.84],["or",207.1,207.16],["family,",207.16,207.66],["which",207.94,208.12],["covers",208.12,208.36],["up",208.36,208.62],["to",208.62,208.74],["four",208.74,209.0],["children.",209.0,209.46]]},{"start":209.94,"end":211.46,"text":"Well, we haven't got any children.","words":[["Well,",209.94,210.2],["we",210.24,210.38],["haven't",210.38,210.58],["got",210.58,210.8],["any",210.8,211.04],["children.",211.04,211.46]]},{"start":212.12,"end":216.98,"text":"But I think I'll get the joint one because my wife will probably want to do the activities with me.","words":[["But",212.12,212.4],["I",212.4,212.56],["think",212.56,212.7],["I'll",212.7,212.88],["get",212.88,212.98],["the",212.98,213.12],["joint",213.12,213.44],["one",213.44,213.7],["because",213.7,213.96],["my",213.96,214.2],["wife",214.2,214.62],["will",214.62,214.82],["probably",214.82,215.18],["want",215.18,215.46],["to",215.46,215.62],["do",215.62,215.72],["the",215.72,215.84],["activities",215.84,216.24],["with",216.24,216.7],["me.",216.7,216.98]]},{"start":217.38,"end":220.72,"text":"Yes. Fine. Let me see.","words":[["Yes.",217.38,217.72],["Fine.",218.32,218.76],["Let",219.78,220.1],["me",220.1,220.28],["see.",220.28,220.72]]},{"start":221.56,"end":224.1,"text":"That'll be 49 pounds altogether, then, please.","words":[["That'll",221.56,221.9],["be",221.9,222.04],["49",222.04,222.6],["pounds",222.6,222.98],["altogether,",222.98,223.38],["then,",223.68,223.8],["please.",223.92,224.1]]},{"start":224.1,"end":232.9,"text":"Before you hear the rest of the conversation, you have some time to look at questions 7","words":[["Before",224.1,225.36],["you",228.3,228.6],["hear",228.6,228.8],["the",228.8,228.94],["rest",228.94,229.18],["of",229.18,229.28],["the",229.28,229.38],["conversation,",229.38,229.92],["you",230.34,230.72],["have",230.72,230.9],["some",230.9,231.08],["time",231.08,231.46],["to",231.46,231.7],["look",231.7,231.86],["at",231.86,232.02],["questions",232.02,232.3],["7",232.3,232.9]]},{"start":232.9,"end":258.4,"text":"to 10 on page 2. Now listen and answer questions 7 to 10.","words":[["to",232.9,233.16],["10",233.16,233.64],["on",233.64,234.24],["page",234.24,234.54],["2.",234.54,235.12],["Now",255.36,255.66],["listen",255.66,256.04],["and",256.04,256.38],["answer",256.38,256.76],["questions",256.76,257.1],["7",257.1,257.76],["to",257.76,257.98],["10.",257.98,258.4]]},{"start":261.6,"end":263.08,"text":"How would you like to pay?","words":[["How",261.6,262.12],["would",262.12,262.28],["you",262.28,262.38],["like",262.38,262.54],["to",262.54,262.74],["pay?",262.74,263.08]]},{"start":263.88,"end":265.08,"text":"By direct debit?","words":[["By",263.88,264.42],["direct",264.42,264.78],["debit?",264.78,265.08]]},{"start":265.7,"end":270.16,"text":"No problem. I just need your bank details. Can you give me the name first?","words":[["No",265.7,265.92],["problem.",265.92,266.34],["I",267.0,267.1],["just",267.1,267.38],["need",267.38,267.56],["your",267.56,267.68],["bank",267.68,267.92],["details.",267.92,268.4],["Can",268.78,268.92],["you",268.92,269.08],["give",269.08,269.22],["me",269.22,269.34],["the",269.34,269.48],["name",269.48,269.8],["first?",269.8,270.16]]},{"start":270.76,"end":272.26,"text":"It's the Union Bank.","words":[["It's",270.76,271.1],["the",271.1,271.34],["Union",271.34,271.74],["Bank.",271.74,272.26]]},{"start":272.82,"end":276.8,"text":"And now I've got your name, but I need your account number.","words":[["And",272.82,273.14],["now",273.14,273.5],["I've",273.5,274.22],["got",274.22,274.34],["your",274.34,274.5],["name,",274.5,274.92],["but",275.2,275.3],["I",275.3,275.46],["need",275.46,275.66],["your",275.66,275.9],["account",275.9,276.24],["number.",276.24,276.8]]},{"start":276.8,"end":286.1,"text":"Uh, uh, zero one, zero five, nine, six, one, two.","words":[["Uh,",276.8,277.5],["uh,",277.98,278.12],["zero",278.34,278.64],["one,",278.64,279.32],["zero",280.22,280.72],["five,",280.72,281.46],["nine,",282.44,282.9],["six,",283.7,283.9],["one,",284.64,285.14],["two.",285.66,286.1]]},{"start":287.44,"end":292.88,"text":"Okay. When would you like to start payment next month on the 1st of October or...","words":[["Okay.",287.44,288.0],["When",288.8,289.14],["would",289.14,289.3],["you",289.3,289.38],["like",289.38,289.54],["to",289.54,289.7],["start",289.7,289.96],["payment",289.96,290.42],["next",290.42,291.16],["month",291.16,291.48],["on",291.48,291.74],["the",291.74,291.84],["1st",291.84,292.08],["of",292.08,292.14],["October",292.14,292.6],["or...",292.6,292.88]]},{"start":293.7,"end":295.6,"text":"Can you make it the 15th instead?","words":[["Can",293.7,294.02],["you",294.02,294.16],["make",294.16,294.34],["it",294.34,294.46],["the",294.46,294.62],["15th",294.62,295.28],["instead?",295.28,295.6]]},{"start":296.46,"end":299.98,"text":"No problem. The membership will begin then too. Is that alright?","words":[["No",296.46,296.76],["problem.",296.76,297.1],["The",297.74,297.92],["membership",297.92,298.18],["will",298.18,298.48],["begin",298.48,298.72],["then",298.72,299.0],["too.",299.0,299.36],["Is",299.52,299.6],["that",299.6,299.72],["alright?",299.72,299.98]]},{"start":300.5,"end":301.02,"text":"That's fine.","words":[["That's",300.5,300.78],["fine.",300.78,301.02]]},{"start":301.82,"end":305.56,"text":"I'll just give you a reference number in case there's any problem. Have you got a pen?","words":[["I'll",301.82,302.02],["just",302.02,302.16],["give",302.16,302.32],["you",302.32,302.42],["a",302.42,302.56],["reference",302.56,302.76],["number",302.76,303.22],["in",303.22,303.4],["case",303.4,303.58],["there's",303.58,303.8],["any",303.8,303.92],["problem.",303.92,304.34],["Have",304.88,305.02],["you",305.02,305.1],["got",305.1,305.24],["a",305.24,305.32],["pen?",305.32,305.56]]},{"start":306.18,"end":306.66,"text":"Yes.","words":[["Yes.",306.18,306.66]]},{"start":308.68,"end":310.84,"text":"It's JYZ-37.","words":[["It's",308.68,309.16],["JYZ",309.16,309.64],["-37.",309.64,310.84]]},{"start":311.82,"end":314.58,"text":"And we'll be sending you an information pack within a few days.","words":[["And",311.82,312.06],["we'll",312.06,312.22],["be",312.22,312.32],["sending",312.32,312.56],["you",312.56,312.76],["an",312.76,312.88],["information",312.88,313.36],["pack",313.36,313.72],["within",313.72,313.98],["a",313.98,314.12],["few",314.12,314.24],["days.",314.24,314.58]]},{"start":315.5,"end":316.48,"text":"Is there anything else?","words":[["Is",315.5,315.8],["there",315.8,315.9],["anything",315.9,316.12],["else?",316.12,316.48]]},{"start":317.04,"end":319.64,"text":"Oh yes, could you send me an additional one?","words":[["Oh",317.04,317.48],["yes,",317.48,317.7],["could",317.78,317.92],["you",317.92,318.06],["send",318.06,318.32],["me",318.32,318.56],["an",318.56,318.8],["additional",318.8,319.2],["one?",319.2,319.64]]},{"start":319.92,"end":321.44,"text":"I've got a friend who's very interested.","words":[["I've",319.92,320.1],["got",320.1,320.18],["a",320.18,320.3],["friend",320.3,320.6],["who's",320.6,320.88],["very",320.88,321.06],["interested.",321.06,321.44]]},{"start":322.34,"end":323.42,"text":"Certainly, no problem.","words":[["Certainly,",322.34,322.82],["no",322.96,323.08],["problem.",323.08,323.42]]},{"start":323.78,"end":324.62,"text":"I'll make a note of that.","words":[["I'll",323.78,323.9],["make",323.9,324.02],["a",324.02,324.12],["note",324.12,324.28],["of",324.28,324.42],["that.",324.42,324.62]]},{"start":325.3,"end":327.7,"text":"There's also a video we can send you if you like.","words":[["There's",325.3,325.66],["also",325.66,325.92],["a",325.92,326.1],["video",326.1,326.36],["we",326.36,326.62],["can",326.62,326.82],["send",326.82,327.04],["you",327.04,327.24],["if",327.24,327.34],["you",327.34,327.44],["like.",327.44,327.7]]},{"start":327.82,"end":328.5,"text":"There's no charge.","words":[["There's",327.82,327.98],["no",327.98,328.12],["charge.",328.12,328.5]]},{"start":328.9,"end":329.58,"text":"Yes, please.","words":[["Yes,",328.9,329.24],["please.",329.3,329.58]]},{"start":330.08,"end":330.64,"text":"That'll be great.","words":[["That'll",330.08,330.26],["be",330.26,330.38],["great.",330.38,330.64]]},{"start":333.9,"end":335.9,"text":"That is the end of section one.","words":[["That",333.9,334.38],["is",334.38,334.52],["the",334.52,334.64],["end",334.64,335.0],["of",335.0,335.22],["section",335.22,335.44],["one.",335.44,335.9]]},{"start":335.9,"end":339.38,"text":"You now have half a minute to check your answers.","words":[["You",335.9,336.9],["now",336.9,337.18],["have",337.18,337.5],["half",337.5,337.88],["a",337.88,338.04],["minute",338.04,338.28],["to",338.28,338.56],["check",338.56,338.84],["your",338.84,339.02],["answers.",339.02,339.38]]},{"start":369.98,"end":373.22,"text":"Now turn to section 2, on page 3.","words":[["Now",369.98,370.26],["turn",370.26,370.54],["to",370.54,370.78],["section",370.78,371.06],["2,",371.06,371.72],["on",372.2,372.44],["page",372.44,372.74],["3.",372.74,373.22]]}]}