 that there is an example that has been done for you on this occasion","words":[["will",96.42,96.56],["see",96.56,96.82],["that",96.82,97.02],["there",97.02,97.22],["is",97.22,97.38],["an",97.38,97.48],["example",97.48,98.0],["that",98.0,98.48],["has",98.48,98.62],["been",98.62,98.78],["done",98.78,99.06],["for",99.06,99.4],["you",99.4,99.7],["on",99.7,100.74],["this",100.74,100.94],["occasion",100.94,101.22]]},{"start":101.22,"end":109.82,"text":"only the conversation relating to this will be played first hello move it","words":[["only",101.22,101.66],["the",101.66,102.26],["conversation",102.26,102.82],["relating",102.82,103.48],["to",103.48,103.76],["this",103.76,104.0],["will",104.0,104.22],["be",104.22,104.36],["played",104.36,104.76],["first",104.76,105.22],["hello",107.9,109.24],["move",109.24,109.68],["it",109.68,109.82]]},{"start":109.82,"end":114.7,"text":"shipping hi I'd like a few more details about your services please","words":[["shipping",109.82,110.12],["hi",110.12,111.4],["I'd",111.4,112.16],["like",112.16,112.28],["a",112.28,112.46],["few",112.46,112.66],["more",112.66,112.84],["details",112.84,113.24],["about",113.24,113.58],["your",113.58,113.8],["services",113.8,114.24],["please",114.24,114.7]]},{"start":114.7,"end":115.46,"text":"Certainly.","words":[["Certainly.",114.7,115.46]]},{"start":116.1,"end":121.36,"text":"I've been on your website looking into sending some things abroad when I go away to study","words":[["I've",116.1,116.4],["been",116.4,116.56],["on",116.56,116.72],["your",116.72,116.86],["website",116.86,117.38],["looking",117.38,118.26],["into",118.26,118.6],["sending",118.6,118.94],["some",118.94,119.24],["things",119.24,119.5],["abroad",119.5,119.94],["when",119.94,120.3],["I",120.3,120.46],["go",120.46,120.62],["away",120.62,120.92],["to",120.92,121.08],["study",121.08,121.36]]},{"start":121.36,"end":121.96,"text":"next term.","words":[["next",121.36,121.64],["term.",121.64,121.96]]},{"start":122.64,"end":128.5,"text":"I see that you provide special empty boxes so that I can pack them myself and you then transport","words":[["I",122.64,122.96],["see",122.96,123.14],["that",123.14,123.3],["you",123.3,123.42],["provide",123.42,123.74],["special",123.74,124.3],["empty",124.3,124.76],["boxes",124.76,125.24],["so",125.24,125.86],["that",125.86,126.02],["I",126.02,126.14],["can",126.14,126.26],["pack",126.26,126.5],["them",126.5,126.66],["myself",126.66,127.14],["and",127.14,127.64],["you",127.64,127.86],["then",127.86,128.06],["transport",128.06,128.5]]},{"start":128.5,"end":128.8,"text":"them.","words":[["them.",128.5,128.8]]},{"start":129.16,"end":129.78,"text":"That's right.","words":[["That's",129.16,129.54],["right.",129.54,129.78]]},{"start":130.24,"end":131.78,"text":"We provide those free of charge.","words":[["We",130.24,130.4],["provide",130.4,130.7],["those",130.7,131.0],["free",131.0,131.32],["of",131.32,131.46],["charge.",131.46,131.78]]},{"start":135.28,"end":141.3,"text":"The company provide boxes for packing, so boxes has been written in the space.","words":[["The",135.28,135.7],["company",135.7,136.06],["provide",136.06,136.54],["boxes",136.54,137.12],["for",137.12,137.4],["packing,",137.4,137.78],["so",137.78,138.74],["boxes",138.74,139.46],["has",139.46,140.18],["been",140.18,140.38],["written",140.38,140.62],["in",140.62,140.86],["the",140.86,140.98],["space.",140.98,141.3]]},{"start":142.56,"end":143.56,"text":"Now we shall begin.","words":[["Now",142.56,142.88],["we",142.88,143.06],["shall",143.06,143.22],["begin.",143.22,143.56]]},{"start":143.56,"end":148.72,"text":"in. You should answer the questions as you listen because you will not hear the recording","words":[["in.",143.56,143.7],["You",144.14,144.54],["should",144.54,144.72],["answer",144.72,145.02],["the",145.02,145.2],["questions",145.2,145.68],["as",145.68,146.08],["you",146.08,146.26],["listen",146.26,146.6],["because",146.6,147.22],["you",147.22,147.46],["will",147.46,147.58],["not",147.58,147.86],["hear",147.86,148.16],["the",148.16,148.3],["recording",148.3,148.72]]},{"start":148.72,"end":154.16,"text":"a second time. Listen carefully and answer questions one to six.","words":[["a",148.72,149.02],["second",149.02,149.24],["time.",149.24,149.7],["Listen",150.74,151.18],["carefully",151.18,151.64],["and",151.64,152.3],["answer",152.3,152.68],["questions",152.68,153.26],["one",153.26,153.62],["to",153.62,153.8],["six.",153.8,154.16]]},{"start":157.57,"end":159.15,"text":"Hello, move it shipping.","words":[["Hello,",157.57,158.21],["move",158.47,158.69],["it",158.69,158.83],["shipping.",158.83,159.15]]},{"start":160.03,"end":163.67,"text":"Hi, I'd like a few more details about your services please.","words":[["Hi,",160.03,160.41],["I'd",160.87,161.19],["like",161.19,161.31],["a",161.31,161.51],["few",161.51,161.69],["more",161.69,161.87],["details",161.87,162.27],["about",162.27,162.59],["your",162.59,162.83],["services",162.83,163.29],["please.",163.29,163.67]]},{"start":164.05,"end":164.47,"text":"Certainly.","words":[["Certainly.",164.05,164.47]]},{"start":165.05,"end":170.37,"text":"I've been on your website looking into sending some things abroad when I go away to study","words":[["I've",165.05,165.41],["been",165.41,165.57],["on",165.57,165.75],["your",165.75,165.89],["website",165.89,166.39],["looking",166.39,167.27],["into",167.27,167.63],["sending",167.63,167.95],["some",167.95,168.27],["things",168.27,168.53],["abroad",168.53,168.99],["when",168.99,169.33],["I",169.33,169.49],["go",169.49,169.63],["away",169.63,169.93],["to",169.93,170.11],["study",170.11,170.37]]},{"start":170.37,"end":176.89,"text":"next term. I see that you provide special empty boxes so that I can pack them myself and you","words":[["next",170.37,170.63],["term.",170.63,170.99],["I",171.67,171.99],["see",171.99,172.17],["that",172.17,172.33],["you",172.33,172.43],["provide",172.43,172.75],["special",172.75,173.35],["empty",173.35,173.77],["boxes",173.77,174.27],["so",174.27,174.89],["that",174.89,175.03],["I",175.03,175.17],["can",175.17,175.29],["pack",175.29,175.53],["them",175.53,175.69],["myself",175.69,176.15],["and",176.15,176.67],["you",176.67,176.89]]},{"start":176.89,"end":180.83,"text":"then transport them. That's right. We provide those free of charge.","words":[["then",176.89,177.07],["transport",177.07,177.55],["them.",177.55,177.83],["That's",178.19,178.57],["right.",178.57,178.79],["We",179.27,179.41],["provide",179.41,179.75],["those",179.75,180.03],["free",180.03,180.35],["of",180.35,180.47],["charge.",180.47,180.83]]},{"start":181.43,"end":186.35,"text":"And can I ask what goods you can transport? Like, do you take electrical goods?","words":[["And",181.43,181.59],["can",181.59,181.73],["I",181.73,181.85],["ask",181.85,182.07],["what",182.07,182.25],["goods",182.25,182.51],["you",182.51,182.69],["can",182.69,182.91],["transport?",182.91,183.45],["Like,",184.23,184.59],["do",184.95,185.07],["you",185.07,185.25],["take",185.25,185.47],["electrical",185.47,185.97],["goods?",185.97,186.35]]},{"start":187.23,"end":192.47,"text":"Well, it depends. If you've got something like a computer, that's fine. But things","words":[["Well,",187.23,187.55],["it",187.63,187.75],["depends.",187.75,188.09],["If",188.85,189.05],["you've",189.05,189.21],["got",189.21,189.35],["something",189.35,189.67],["like",189.67,189.93],["a",189.93,190.07],["computer,",190.07,190.57],["that's",190.87,191.15],["fine.",191.15,191.45],["But",191.99,192.27],["things",192.27,192.47]]},{"start":192.47,"end":196.51,"text":"like washing machines and fridges are too heavy and bulky for our service.","words":[["like",192.47,192.77],["washing",192.77,193.09],["machines",193.09,193.59],["and",193.59,193.87],["fridges",193.87,194.31],["are",194.31,194.57],["too",194.57,194.69],["heavy",194.69,195.01],["and",195.01,195.21],["bulky",195.21,195.57],["for",195.57,195.85],["our",195.85,196.07],["service.",196.07,196.51]]},{"start":196.51,"end":199.61,"text":"No, I wouldn't be taking that sort of stuff.","words":[["No,",196.51,197.47],["I",197.69,197.85],["wouldn't",197.85,198.13],["be",198.13,198.27],["taking",198.27,198.59],["that",198.59,198.89],["sort",198.89,199.15],["of",199.15,199.31],["stuff.",199.31,199.61]]},{"start":200.05,"end":203.43,"text":"You can always check with us if there's anything you're not sure about including.","words":[["You",200.05,200.29],["can",200.29,200.47],["always",200.47,200.71],["check",200.71,201.05],["with",201.05,201.25],["us",201.25,201.39],["if",201.39,201.55],["there's",201.55,201.75],["anything",201.75,202.05],["you're",202.05,202.35],["not",202.35,202.49],["sure",202.49,202.73],["about",202.73,203.01],["including.",203.01,203.43]]},{"start":204.15,"end":206.25,"text":"I was wondering about my bicycle.","words":[["I",204.15,204.63],["was",204.63,204.85],["wondering",204.85,205.23],["about",205.23,205.59],["my",205.59,205.83],["bicycle.",205.83,206.25]]},{"start":207.23,"end":208.95,"text":"I suppose that would be too bulky.","words":[["I",207.23,207.45],["suppose",207.45,207.73],["that",207.73,208.05],["would",208.05,208.21],["be",208.21,208.35],["too",208.35,208.59],["bulky.",208.59,208.95]]},{"start":209.43,"end":213.07,"text":"No, that's fine, though we wouldn't be able to take a motorbike.","words":[["No,",209.43,209.75],["that's",209.87,210.17],["fine,",210.17,210.47],["though",211.07,211.21],["we",211.21,211.33],["wouldn't",211.33,211.61],["be",211.61,211.79],["able",211.79,212.03],["to",212.03,212.19],["take",212.19,212.39],["a",212.39,212.55],["motorbike.",212.55,213.07]]},{"start":213.67,"end":214.03,"text":"Sure.","words":[["Sure.",213.67,214.03]]},{"start":214.87,"end":216.95,"text":"Is there anything else you don't take?","words":[["Is",214.87,215.27],["there",215.27,215.47],["anything",215.47,215.77],["else",215.77,216.13],["you",216.13,216.37],["don't",216.37,216.63],["take?",216.63,216.95]]},{"start":217.63,"end":224.23,"text":"Well, basically, the service is restricted to what one man can lif