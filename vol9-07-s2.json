shments and","words":[["magnificent",310.31,310.75],["views",310.75,311.29],["of",311.29,311.53],["the",311.53,311.65],["sea,",311.65,311.91],["a",312.59,312.73],["café",312.73,313.05],["could",313.05,313.41],["provide",313.41,313.85],["visitors",313.85,314.33],["with",314.33,314.85],["light",314.85,315.15],["refreshments",315.15,315.91],["and",315.91,316.53]]},{"start":316.53,"end":323.21,"text":"an opportunity to browse a range of magazines. There would be external access to this area","words":[["an",316.53,316.65],["opportunity",316.65,317.09],["to",317.09,317.47],["browse",317.47,317.77],["a",317.77,318.03],["range",318.03,318.29],["of",318.29,318.49],["magazines.",318.49,318.97],["There",320.37,320.71],["would",320.71,320.85],["be",320.85,321.05],["external",321.05,321.67],["access",321.67,322.19],["to",322.19,322.55],["this",322.55,322.75],["area",322.75,323.21]]},{"start":323.21,"end":330.63,"text":"via a set of steps leading down towards Queen's Parade. Now, let's go back to the entrance","words":[["via",323.21,323.79],["a",323.79,324.09],["set",324.09,324.25],["of",324.25,324.41],["steps",324.41,324.79],["leading",324.79,325.37],["down",325.37,325.81],["towards",325.81,326.15],["Queen's",326.15,327.03],["Parade.",327.03,327.41],["Now,",328.17,328.85],["let's",329.25,329.59],["go",329.59,329.73],["back",329.73,329.95],["to",329.95,330.15],["the",330.15,330.29],["entrance",330.29,330.63]]},{"start":330.63,"end":335.47,"text":"entrance hall again. On the right of the entrance hall, facing","words":[["entrance",330.63,330.79],["hall",330.79,330.97],["again.",330.97,331.29],["On",332.65,333.25],["the",333.25,333.39],["right",333.39,333.63],["of",333.63,333.83],["the",333.83,333.95],["entrance",333.95,334.21],["hall,",334.21,334.71],["facing",335.11,335.47]]},{"start":335.47,"end":342.15,"text":"onto the right Roberts Avenue, is the new staff workroom. The fact that the workroom would","words":[["onto",335.47,335.81],["the",335.81,336.03],["right",336.03,336.29],