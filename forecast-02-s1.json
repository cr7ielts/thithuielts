12,62.5],["to",62.5,62.76],["look",62.76,62.9],["at",62.9,63.02],["questions",63.02,63.4],["one",63.4,63.9],["to",63.9,64.1],["five.",64.1,64.52]]},{"start":89.76,"end":93.44,"text":"Now listen carefully and answer questions one to five.","words":[["Now",89.76,90.22],["listen",90.22,90.56],["carefully",90.56,91.04],["and",91.04,91.42],["answer",91.42,91.84],["questions",91.84,92.42],["one",92.42,92.82],["to",92.82,92.98],["five.",92.98,93.44]]},{"start":93.76,"end":101.23,"text":"I heard your advert on the radio about the sale you're having,","words":[["I",93.76,94.04],["heard",98.01,98.25],["your",98.25,98.41],["advert",98.41,98.83],["on",98.83,99.15],["the",99.15,99.27],["radio",99.27,99.73],["about",99.73,100.11],["the",100.11,100.33],["sale",100.33,100.65],["you're",100.65,100.97],["having,",100.97,101.23]]},{"start":101.59,"end":103.75,"text":"and I wanted to find out about your cars.","words":[["and",101.59,101.87],["I",101.87,101.99],["wanted",101.99,102.21],["to",102.21,102.43],["find",102.43,102.67],["out",102.67,102.89],["about",102.89,103.13],["your",103.13,103.33],["cars.",103.33,103.75]]},{"start":104.07,"end":108.03,"text":"Well, you've called the right place. So, how much do you want to spend?","words":[["Well,",104.07,104.35],["you've",104.45,104.65],["called",104.65,104.85],["the",104.85,104.99],["right",104.99,105.21],["place.",105.21,105.57],["So,",106.09,106.43],["how",106.71,107.01],["much",107.01,107.19],["do",107.19,107.39],["you",107.39,107.45],["want",107.45,107.57],["to",107.57,107.75],["spend?",107.75,108.03]]},{"start":108.65,"end":114.77,"text":"I'd like to spend about four thousand dollars, but definitely no more than four thousand three hundred.","words":[["I'd",108.65,109.21],["like",109.21,109.39],["to",109.39,109.61],["spend",109.61,109.85],["about",109.85,110.11],["four",110.11,110.47],["thousand",110.47,110.87],["dollars,",110.87,111.33],["but",111.75,111.97],["definitely",111.97,112.47],["no",112.47,112.83],["more",112.83,113.09],["than",113.09,113.27],["four",113.27,113.57],["thousand",113.57,114.01],["three",114.01,114.37],["hundred.",114.37,114.77]]},{"start":115.25,"end":120.89,"text":"Okay, for that price we've got some nice cars. I've got a lovely Noda. Do you know that model?","words":[["Okay,",115.25,115.71],["for",116.21,116.39],["that",116.39,116.57],["price",116.57,116.91],["we've",116.91,117.17],["got",117.17,117.27],["some",117.27,117.47],["nice",117.47,117.73],["cars.",117.73,118.11],["I've",118.59,118.83],["got",118.83,118.95],["a",118.95,119.05],["lovely",119.05,119.27],["Noda.",119.27,119.71],["Do",120.13,120.29],["you",120.29,120.39],["know",120.39,120.49],["that",120.49,120.67],["model?",120.67,120.89]]},{"start":121.53,"end":128.29,"text":"Yes. What color is it? I know it sounds unimportant, but there are certain colors I don't want.","words":[["Yes.",121.53,121.87],["What",122.49,122.93],["color",122.93,123.27],["is",123.27,123.51],["it?",123.51,123.67],["I",124.19,124.39],["know",124.39,124.57],["it",124.57,124.73],["sounds",124.73,125.03],["unimportant,",125.03,125.73],["but",126.13,126.35],["there",126.35,126.51],["are",126.51,126.61],["certain",126.61,126.93],["colors",126.93,127.29],["I",127.29,127.61],["don't",127.61,128.01],["want.",128.01,128.29]]},{"start":128.55,"end":130.39,"text":"Well, this one is silver.","words":[["Well,",128.55,128.87],["this",128.99,129.27],["one",129.27,129.57],["is",129.57,130.01],["silver.",130.01,130.39]]},{"start":130.95,"end":136.15,"text":"That's good, because I don't want a dark color, like black, as they get too hot in summer.","words":[["That's",130.95,131.37],["good,",131.37,131.57],["because",131.89,132.13],["I",132.13,132.31],["don't",132.31,132.49],["want",132.49,132.65],["a",132.65,132.75],["dark",132.75,133.11],["color,",133.11,133.49],["like",133.67,133.91],["black,",133.91,134.23],["as",134.59,134.75],["they",134.75,134.89],["get",134.89,135.07],["too",135.07,135.29],["hot",135.29,135.59],["in",135.59,135.81],["summer.",135.81,136.15]]},{"start":136.63,"end":138.15,"text":"So is it in good condition?","words":[["So",136.63,137.07],["is",137.07,137.25],["it",137.25,137.37],["in",137.37,137.49],["good",137.49,137.69],["condition?",137.69,138.15]]},{"start":138.61,"end":141.05,"text":"It's just had a state-of-the-art stereo put in.","words":[["It's",138.61,138.75],["just",138.75,138.93],["had",138.93,139.17],["a",139.17,139.27],["state",139.27,139.61],["-of",139.61,139.79],["-the",139.79,139.89],["-art",139.89,140.09],["stereo",140.09,140.57],["put",140.57,140.87],["in.",140.87,141.05]]},{"start":141.41,"end":143.11,"text":"And although one light is damaged,","words":[["And",141.41,141.65],["although",141.65,142.07],["one",142.07,142.35],["light",142.35,142.57],["is",142.57,142.77],["damaged,",142.77,143.11]]},{"start":143.33,"end":145.71,"text":"we'd repair that for you if you decided to buy it.","words":[["we'd",143.33,143.57],["repair",143.57,143.95],["that",143.95,144.15],["for",144.15,144.43],["you",144.43,144.59],["if",144.59,144.71],["you",144.71,144.77],["decided",144.77,145.15],["to",145.15,145.31],["buy",145.31,145.53],["it.",145.53,145.71]]},{"start":146.03,"end":147.27,"text":"Oh, that's good of you.","words":[["Oh,",146.03,146.35],["that's",146.51,146.79],["good",146.79,146.95],["of",146.95,147.11],["you.",147.11,147.27]]},{"start":147.49,"end":149.75,"text":"I've also got a Kamina. It's a white one.","words":[["I've",147.49,147.67],["also",147.67,147.99],["got",147.99,148.15],["a",148.15,148.27],["Kamina.",148.27,148.71],["It's",149.07,149.21],["a",149.21,149.33],["white",149.33,149.51],["one.",149.51,149.75]]},{"start":150.19,"end":153.47,"text":"It's slightly more expensive than the Noda, but it's a good car.","words":[["It's",150.19,150.43],["slightly",150.43,150.85],["more",150.85,151.11],["expensive",151.11,151.67],["than",151.67,151.99],["the",151.99,152.13],["Noda,",152.13,152.45],["but",152.61,152.75],["it's",152.75,152.99],["a",152.99,153.05],["good",153.05,153.19],["car.",153.19,153.47]]},{"start":154.05,"end":156.85,"text":"I know it quite well because it was owned by our manager here.","words":[["I",154.05,154.29],["know",154.29,154.39],["it",154.39,154.51],["quite",154.51,154.73],["well",154.73,155.07],["because",155.07,155.31],["it",155.31,155.43],["was",155.43,155.53],["owned",155.53,155.83],["by",155.83,156.01],["our",156.01,156.21],["manager",156.21,156.51],["here.",156.51,156.85]]},{"start":156.99,"end":158.73,"text":"So I used to get to drive it quite a bit.","words":[["So",156.99,157.19],["I",157.19,157.35],["used",157.35,157.47],["to",157.47,157.59],["get",157.59,157.67],["to",157.67,157.81],["drive",157.81,158.07],["it",158.07,158.21],["quite",158.21,158.43],["a",158.43,158.57],["bit.",158.57,158.73]]},{"start":159.25,"end":162.49,"text":"The Kamina is okay, but it's a little on the big side.","words":[["The",159.25,159.57],["Kamina",159.57,159.87],["is",159.87,160.11],["okay,",160.11,160.43],["but",160.63,161.09],["it's",161.09,161.27],["a",161.27,161.37],["little",161.37,161.49],["on",161.49,161.75],["the",161.75,161.89],["big",161.89,162.11],["side.",162.11,162.49]]},{"start":162.89,"end":164.67,"text":"Well, how about a Telster?","words":[["Well,",162.89,163.31],["how",163.63,163.89],["about",163.89,164.13],["a",164.13,164.31],["Telster?",164.31,164.67]]},{"start":164.67,"end":171.11,"text":"they're smaller but not too small. We've got an orange one of those, actually what","words":[["they're",164.67,165.35],["smaller",165.35,165.73],["but",165.73,166.09],["not",166.09,166.47],["too",166.47,166.79],["small.",166.79,167.21],["We've",168.31,168.49],["got",168.49,168.61],["an",168.61,168.75],["orange",168.75,169.03],["one",169.03,169.31],["of",169.31,169.43],["those,",169.43,169.69],["actually",170.01,170.47],["what",170.47,171.11]]},{"start":171.11,"end":176.59,"text":"kind of model were you after? This one's an automatic. Great, they are so much easier","words":[["kind",171.11,171.41],["of",171.41,171.55],["model",171.55,171.83],["were",171.83,172.07],["you",172.07,172.17],["after?",172.17,172.51],["This",172.91,173.01],["one's",173.01,173.27],["an",173.27,173.37],["automatic.",173.37,173.75],["Great,",174.39,174.73],["they",175.31,175.51],["are",175.51,175.63],["so",175.63,175.95],["much",175.95,176.19],["easier",176.19,176.59]]},{"start":176.59,"end":181.25,"text":"to drive than the manual model, although I'm fine with either. And another good","words":[["to",176.59,176.81],["drive",176.81,177.13],["than",177.13,177.41],["the",177.41,177.53],["manual",177.53,177.85],["model,",177.85,178.29],["although",178.67,178.97],["I'm",178.97,179.25],["fine",179.25,179.45],["with",179.45,179.67],["either.",179.67,179.99],["And",180.31,180.61],["another",180.61,181.05],["good",181.05,181.25]]},{"start":181.25,"end":186.23,"text":"feature is that the previous owner only replaced its tyres last month. That will","words":[["feature",181.25,181.67],["is",181.67,181.99],["that",181.99,182.13],["the",182.13,182.27],["previous",182.27,182.61],["owner",182.61,183.07],["only",183.07,183.51],["replaced",183.51,183.87],["its",183.87,184.19],["tyres",184.19,184.51],["last",184.51,184.89],["month.",184.89,185.35],["That",185.79,186.09],["will",186.09,186.23]]},{"start":186.23,"end":190.43,"text":"save some money and anything to do with the wheels is so important for","words":[["save",186.23,186.51],["some",186.51,186.73],["money",186.73,187.03],["and",187.03,187.65],["anything",187.65,187.93],["to",187.93,188.25],["do",188.25,188.39],["with",188.39,188.57],["the",188.57,188.69],["wheels",188.69,189.01],["is",189.01,189.23],["so",189.23,189.59],["important",189.59,190.13],["for",190.13,190.43]]},{"start":190.43,"end":196.51,"text":"safety it might be worth a look. Okay, now let's look at what else we've got in your price range.","words":[["safety",190.43,190.83],["it",190.83,191.65],["might",191.65,191.81],["be",191.81,191.97],["worth",191.97,192.15],["a",192.15,192.31],["look.",192.31,192.49],["Okay,",192.81,193.13],["now",193.71,194.07],["let's",194.07,194.45],["look",194.45,194.63],["at",194.63,194.73],["what",194.73,194.87],["else",194.87,195.19],["we've",195.19,195.45],["got",195.45,195.55],["in",195.55,195.69],["your",195.69,195.81],["price",195.81,196.15],["range.",196.15,196.51]]},{"start":197.05,"end":201.89,"text":"How about an abrada? It's a red one. It's the newest of the cars for sale in your bracket.","words":[["How",197.05,197.51],["about",197.51,197.77],["an",197.77,197.97],["abrada?",197.97,198.31],["It's",198.81,198.93],["a",198.93,199.03],["red",199.03,199.19],["one.",199.19,199.37],["It's",199.71,199.87],["the",199.87,199.99],["newest",199.99,200.21],["of",200.21,200.41],["the",200.41,200.51],["cars",200.51,200.79],["for",200.79,201.05],["sale",201.05,201.33],["in",201.33,201.49],["your",201.49,201.63],["bracket.",201.63,201.89]]},{"start":202.39,"end":206.51,"text":"How old is it? I doubt I could afford anything less than 10 years old.","words":[["How",202.39,202.73],["old",202.73,202.95],["is",202.95,203.09],["it?",203.09,203.29],["I",203.79,203.93],["doubt",203.93,204.13],["I",204.13,204.33],["could",204.33,204.45],["afford",204.45,204.75],["anything",204.75,205.01],["less",205.01,205.39],["than",205.39,205.67],["10",205.67,205.95],["years",205.95,206.13],["old.",206.13,206.51]]},{"start":206.77,"end":211.41,"text":"Well you might be surprised. There was only one previous owner and they had it eight years.","words":[["Well",206.77,206.97],["you",206.97,207.11],["might",207.11,207.27],["be",207.27,207.45],["surprised.",207.45,207.89],["There",208.39,208.53],["was",208.53,208.67],["only",208.67,208.91],["one",208.91,209.19],["previous",209.19,209.53],["owner",209.53,209.97],["and",209.97,210.25],["they",210.25,210.35],["had",210.35,210.53],["it",210.53,210.65],["eight",210.65,210.91],["years.",210.91,211.41]]},{"start":211.61,"end":216.17,"text":"All the others are at least nine years old. Now that's a possibility.","words":[["All",211.61,211.81],["the",211.81,211.95],["others",211.95,212.13],["are",212.13,212.31],["at",212.31,212.41],["least",212.41,212.77],["nine",212.77,213.05],["years",213.05,213.31],["old.",213.31,213.67],["Now",214.05,214.49],["that's",214.49,215.59],["a",215.59,215.65],["possibility.",215.65,216.17]]},{"start":219.54,"end":224.88,"text":"Before you hear the rest of the conversation, you have some time to look at questions 6","words":[["Before",219.54,220.02],["you",220.02,220.3],["hear",220.3,220.54],["the",220.54,220.72],["rest",220.72,220.96],["of",220.96,221.08],["the",221.08,221.18],["conversation,",221.18,221.82],["you",222.28,222.58],["have",222.58,222.82],["some",222.82,223.02],["time",223.02,223.46],["to",223.46,223.68],["look",223.68,223.84],["at",223.84,223.96],["questions",223.96,224.32],["6",224.32,224.88]]},{"start":224.88,"end":254.1,"text":"to 10. Now listen and answer questions 6 to 10.","words":[["to",224.88,225.12],["10.",225.12,225.54],["Now",250.68,251.16],["listen",251.16,251.5],["and",251.5,251.94],["answer",251.94,252.44],["questions",252.44,252.88],["6",252.88,253.52],["to",253.52,253.72],["10.",253.72,254.1]]},{"start":257.52,"end":262.22,"text":"Okay. Well, I'm interested in a couple of those. Could I come and take a look at them?","words":[["Okay.",257.52,257.96],["Well,",258.46,258.7],["I'm",258.84,259.02],["interested",259.02,259.36],["in",259.36,259.58],["a",259.58,259.7],["couple",259.7,259.94],["of",259.94,260.14],["those.",260.14,260.44],["Could",260.98,261.12],["I",261.12,261.24],["come",261.24,261.38],["and",261.38,261.52],["take",261.52,261.68],["a",261.68,261.82],["look",261.82,261.92],["at",261.92,262.08],["them?",262.08,262.22]]},{"start":262.5,"end":265.76,"text":"Sure. We're open seven days a week. Do you know where we are?","words":[["Sure.",262.5,262.74],["We're",263.16,263.38],["open",263.38,263.6],["seven",263.6,263.94],["days",263.94,264.18],["a",264.18,264.34],["week.",264.34,264.54],["Do",264.84,265.02],["you",265.02,265.16],["know",265.16,265.28],["where",265.28,265.44],["we",265.44,265.58],["are?",265.58,265.76]]},{"start":266.22,"end":272.72,"text":"I think so. You're on Station Road in Mitchell, right? I usually go past your place when I'm on the bus.","words":[["I",266.22,266.5],["think",266.5,266.78],["so.",266.78,267.12],["You're",267.64,267.9],["on",267.9,268.04],["Station",268.04,268.48],["Road",268.48,268.92],["in",268.92,269.12],["Mitchell,",269.12,269.42],["right?",269.58,269.82],["I",270.28,270.5],["usually",270.5,270.84],["go",270.84,271.12],["past",271.12,271.42],["your",271.42,271.66],["place",271.66,271.94],["when",271.94,272.14],["I'm",272.14,272.28],["on",272.28,272.38],["the",272.38,272.52],["bus.",272.52,272.72]]},{"start":272.72,"end":278.26,"text":"That's right. You can't miss us. What day would suit you? Don't leave it too long as these","words":[["That's",272.72,273.26],["right.",273.26,273.42],["You",273.68,273.8],["can't",273.8,274.1],["miss",274.1,274.24],["us.",274.24,274.42],["What",274.96,275.12],["day",275.12,275.48],["would",275.48,275.68],["suit",275.68,275.92],["you?",275.92,276.16],["Don't",276.72,276.94],["leave",276.94,277.06],["it",277.06,277.22],["too",277.22,277.54],["long",277.54,277.88],["as",277.88,278.06],["these",278.06,278.26]]},{"start":278.26,"end":281.06,"text":"cars are likely to go quickly at these prices.","words":[["cars",278.26,278.68],["are",278.68,279.1],["likely",279.1,279.5],["to",279.5,279.68],["go",279.68,279.82],["quickly",279.82,280.24],["at",280.24,280.42],["these",280.42,280.56],["prices.",280.56,281.06]]},{"start":281.72,"end":286.7,"text":"Well, I couldn't get there before Wednesday and even that might be pushing it. How does","words":[["Well,",281.72,282.02],["I",282.26,282.4],["couldn't",282.4,282.66],["get",282.66,282.82],["there",282.82,283.02],["before",283.02,283.3],["Wednesday",283.3,283.8],["and",283.8,284.5],["even",284.5,284.7],["that",284.7,284.94],["might",284.94,285.16],["be",285.16,285.34],["pushing",285.34,285.68],["it.",285.68,285.94],["How",286.34,286.52],["does",286.52,286.7]]},{"start":286.7,"end":287.54,"text":"Thursday sound?","words":[["Thursday",286.7,286.96],["sound?",286.96,287.54]]},{"start":287.76,"end":291.92,"text":"Sounds good. I usually don't work then or Fridays but I am this week.","words":[["Sounds",287.76,287.98],["good.",287.98,288.2],["I",288.7,288.86],["usually",288.86,289.1],["don't",289.1,289.48],["work",289.48,289.74],["then",289.74,290.0],["or",290.0,290.3],["Fridays",290.3,290.74],["but",290.74,291.18],["I",291.18,291.46],["am",291.46,291.56],["this",291.56,291.74],["week.",291.74,291.92]]},{"start":292.38,"end":297.86,"text":"That's good. I'd prefer to deal with you. Okay, so would 9.30 in the morning be okay?","words":[["That's",292.38,292.86],["good.",292.86,293.04],["I'd",293.42,293.7],["prefer",293.7,293.88],["to",293.88,294.12],["deal",294.12,294.28],["with",294.28,294.5],["you.",294.5,294.7],["Okay,",295.36,295.72],["so",295.98,296.22],["would",296.22,296.38],["9",296.38,296.56],[".30",296.56,296.88],["in",296.88,297.08],["the",297.08,297.14],["morning",297.14,297.34],["be",297.34,297.58],["okay?",297.58,297.86]]},{"start":297.86,"end":304.66,"text":"No worries. When you arrive, ask for Gerald Smith. That's G-E-R-A-L-D.","words":[["No",297.86,298.38],["worries.",298.38,298.72],["When",299.12,299.4],["you",299.4,299.56],["arrive,",299.56,299.9],["ask",300.1,300.44],["for",300.44,300.66],["Gerald",300.66,300.92],["Smith.",300.92,301.28],["That's",301.86,302.02],["G",302.02,302.38],["-E",302.38,302.68],["-R",302.68,303.14],["-A",303.14,303.78],["-L",303.78,304.24],["-D.",304.24,304.66]]},{"start":305.2,"end":305.56,"text":"Okay.","words":[["Okay.",305.2,305.56]]},{"start":305.98,"end":309.0,"text":"Now, will you be coming by car or public transport?","words":[["Now,",305.98,306.26],["will",306.48,306.72],["you",306.72,306.82],["be",306.82,306.96],["coming",306.96,307.16],["by",307.16,307.44],["car",307.44,307.88],["or",307.88,308.16],["public",308.16,308.52],["transport?",308.52,309.0]]},{"start":309.68,"end":313.9,"text":"I'll probably come with my dad in his car. He knows all about this sort of thing.","words":[["I'll",309.68,309.92],["probably",309.92,310.22],["come",310.22,310.48],["with",310.48,310.66],["my",310.66,310.84],["dad",310.84,311.12],["in",311.12,311.3],["his",311.3,311.52],["car.",311.52,311.84],["He",312.28,312.46],["knows",312.46,312.64],["all",312.64,312.86],["about",312.86,313.1],["this",313.1,313.4],["sort",313.4,313.56],["of",313.56,313.66],["thing.",313.66,313.9]]},{"start":314.26,"end":316.46,"text":"Well, you should be able to park at the supermarket.","words":[["Well,",314.26,314.5],["you",314.66,314.84],["should",314.84,315.1],["be",315.1,315.3],["able",315.3,315.4],["to",315.4,315.56],["park",315.56,315.82],["at",315.82,316.0],["the",316.0,316.12],["supermarket.",316.12,316.46]]},{"start":317.16,"end":321.64,"text":"Parking can be a bit hard with all the businesses around here and all our cars out the front.","words":[["Parking",317.16,317.64],["can",317.64,317.9],["be",317.9,318.12],["a",318.12,318.2],["bit",318.2,318.3],["hard",318.3,318.68],["with",318.68,318.94],["all",318.94,319.06],["the",319.06,319.16],["businesses",319.16,319.54],["around",319.54,319.96],["here",319.96,320.26],["and",320.26,320.4],["all",320.4,320.54],["our",320.54,320.76],["cars",320.76,321.08],["out",321.08,321.28],["the",321.28,321.42],["front.",321.42,321.64]]},{"start":322.14,"end":325.38,"text":"Great. Now, is there anything I need to bring with me?","words":[["Great.",322.14,322.62],["Now,",323.26,323.5],["is",323.6,323.68],["there",323.68,323.82],["anything",323.82,324.14],["I",324.14,324.36],["need",324.36,324.52],["to",324.52,324.7],["bring",324.7,324.9],["with",324.9,325.14],["me?",325.14,325.38]]},{"start":325.38,"end":331.52,"text":"Mmm, let me think. If you want to take the car for a test drive, you'll need to have identification with you.","words":[["Mmm,",325.38,325.96],["let",326.1,326.18],["me",326.18,326.3],["think.",326.3,326.68],["If",327.36,327.56],["you",327.56,327.68],["want",327.68,327.82],["to",327.82,327.92],["take",327.92,328.1],["the",328.1,328.22],["car",328.22,328.46],["for",328.46,328.62],["a",328.62,328.7],["test",328.7,328.96],["drive,",328.96,329.42],["you'll",329.56,329.68],["need",329.68,329.88],["to",329.88,330.1],["have",330.1,330.24],["identification",330.24,330.84],["with",330.84,331.36],["you.",331.36,331.52]]},{"start":331.78,"end":335.04,"text":"I mean, otherwise you could just drive off in it and never come back.","words":[["I",331.78,331.88],["mean,",331.88,332.06],["otherwise",332.4,332.74],["you",332.74,333.04],["could",333.04,333.18],["just",333.18,333.4],["drive",333.4,333.72],["off",333.72,333.98],["in",333.98,334.08],["it",334.08,334.2],["and",334.2,334.28],["never",334.28,334.5],["come",334.5,334.76],["back.",334.76,335.04]]},{"start":335.52,"end":336.88,"text":"Okay, that's easy.","words":[["Okay,",335.52,335.9],["that's",336.36,336.72],["easy.",336.72,336.88]]},{"start":337.42,"end":339.18,"text":"Perfect. See you later this week.","words":[["Perfect.",337.42,337.76],["See",338.3,338.52],["you",338.52,338.58],["later",338.58,338.76],["this",338.76,338.98],["week.",338.98,339.18]]},{"start":342.62,"end":349.1,"text":"That is the end of Part 1. You now have one minute to check your answers to Part 1.","words":[["That",342.62,343.08],["is",343.08,343.24],["the",343.24,343.4],["end",343.4,343.78],["of",343.78,343.96],["Part",343.96,344.16],["1.",344.16,344.54],["You",345.52,345.72],["now",345.72,346.0],["have",346.0,346.3],["one",346.3,346.62],["minute",346.62,347.04],["to",347.04,347.28],["check",347.28,347.56],["your",347.56,347.74],["answers",347.74,348.18],["to",348.18,348.42],["Part",348.42,348.66],["1.",348.66,349.1]]}]}