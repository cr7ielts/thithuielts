.6],["somewhere",259.6,260.08],["not",260.08,260.34],["too",260.34,260.6],["far",260.6,260.86],["from",260.86,261.0],["a",261.0,261.14],["station",261.14,261.42]]},{"start":261.42,"end":261.98,"text":"if possible.","words":[["if",261.42,261.62],["possible.",261.62,261.98]]},{"start":262.42,"end":263.48,"text":"But it's not essential.","words":[["But",262.42,262.64],["it's",262.64,262.94],["not",262.94,263.06],["essential.",263.06,263.48]]},{"start":264.08,"end":264.66,"text":"I've got a bike.","words":[["I've",264.08,264.26],["got",264.26,264.32],["a",264.32,264.46],["bike.",264.46,264.66]]},{"start":265.38,"end":265.66,"text":"Right.","words":[["Right.",265.38,265.66]]},{"start":266.24,"end":267.14,"text":"And what else?","words":[["And",266.24,266.6],["what",266.6,266.88],["else?",266.88,267.14]]},{"start":267.72,"end":271.22,"text":"You'll want a lounge, and will you want a separate dining room?","words":[["You'll",267.72,268.0],["want",268.0,268.26],["a",268.26,268.42],["lounge,",268.42,268.88],["and",269.2,269.52],["will",269.52,269.94],["you",269.94,270.02],["want",270.02,270.22],["a",270.22,270.36],["separate",270.36,270.62],["dining",270.62,270.94],["room?",270.94,271.22]]},{"start":271.74,"end":273.04,"text":"Well, not really.","words":[["Well,",271.74,272.26],["not",272.38,272.66],["really.",272.66,273.04]]},{"start":273.36,"end":274.52,"text":"We tend to eat in the kitchen.","words":[["We",273.36,273.5],["tend",273.5,273.72],["to",273.72,273.88],["eat",273.88,274.02],["in",274.02,274.14],["the",274.14,274.24],["kitchen.",274.24,274.52]]},{"start":274.52,"end":278.4,"text":"So it'd be good if that was large enough for us to do that.","words":[["So",274.52,275.42],["it'd",275.42,275.8],["be",275.8,275.92],["good",275.92,276.28],["if",276.28,276.68],["that",276.68,276.9],["was",276.9,277.06],["large",277.06,277.38],["enough",277.38,277.54],["for",277.54,277.78],["us",277.78,277.9],["to",277.9,278.02],["do",278.02,278.18],["that.",278.18,278.4]]},{"start":278