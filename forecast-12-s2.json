],["out",109.11,109.47],["occasionally",109.47,110.01],["but",110.01,110.65],["usually",110.65,111.11]]},{"start":111.11,"end":117.37,"text":"there's enough to cope with a group your size. If you now move to the bottom lift of your map","words":[["there's",111.11,111.57],["enough",111.57,111.85],["to",111.85,111.99],["cope",111.99,112.21],["with",112.21,112.37],["a",112.37,112.49],["group",112.49,112.65],["your",112.65,112.91],["size.",112.91,113.33],["If",114.49,115.05],["you",115.05,115.23],["now",115.23,115.53],["move",115.53,115.79],["to",115.79,115.93],["the",115.93,116.05],["bottom",116.05,116.39],["lift",116.39,116.75],["of",116.75,116.95],["your",116.95,117.07],["map",117.07,117.37]]},{"start":117.37,"end":123.43,"text":"map, among the pine trees, there is a special flat site set up for pitching tents, with","words":[["map,",117.37,117.45],["among",117.77,117.99],["the",117.99,118.19],["pine",118.19,118.41],["trees,",118.41,118.79],["there",119.47,119.79],["is",119.79,119.97],["a",119.97,120.09],["special",120.09,120.37],["flat",120.37,120.81],["site",120.81,121.33],["set",121.33,121.65],["up",121.65,121.85],["for",121.85,122.01],["pitching",122.01,122.25],["tents,",122.25,122.67],["with",123.19,123.43]]},{"start":123.43,"end":130.51,"text":"power points and outdoor taps for water. Now let's go back and move along the top of","words":[["power",123.43,123.79],["points",123.79,124.19],["and",124.19,124.61],["outdoor",124.61,125.11],["taps",125.11,125.53],["for",125.53,125.77],["water.",125.77,126.03],["Now",127.21,127.67],["let's",127.67,128.13],["go",128.13,128.29],["back",128.29,128.57],["and",128.57,129.23],["move",129.23,129.51],["along",129.51,129.81],["the",129.81,130.03],["top",130.03,130.35],["of",130.35,130.51]]},{"start":130.51,"end":136.91,"text":"your map. There's another area of pine forest and then over on the far right hand side","words":[["your",130.51,130.63],["map.",130.63,130.93],["There's",131.37,131.73],["another",131.73,132.07],["area",13