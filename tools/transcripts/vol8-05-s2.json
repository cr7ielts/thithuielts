4,294.02],["includes",294.02,294.3],["some",294.3,294.56],["beautiful",294.56,294.9],["drawings",294.9,295.38],["based",295.38,296.12],["on",296.12,296.44],["the",296.44,296.56],["artwork",296.56,296.88],["of",296.88,297.24],["the",297.24,297.36],["era.",297.36,297.68]]},{"start":298.32,"end":300.32,"text":"Next is The Running Boy.","words":[["Next",298.32,298.94],["is",298.94,299.62],["The",299.62,299.8],["Running",299.8,300.02],["Boy.",300.02,300.32]]},{"start":300.32,"end":305.52,"text":"It's about a boy who gets himself into some difficult situations at school.","words":[["It's",300.32,301.48],["about",301.48,301.72],["a",301.72,301.9],["boy",301.9,302.12],["who",302.12,302.5],["gets",302.5,302.68],["himself",302.68,303.16],["into",303.16,303.48],["some",303.48,303.7],["difficult",303.7,304.1],["situations",304.1,304.7],["at",304.7,305.14],["school.",305.14,305.52]]},{"start":306.3,"end":311.18,"text":"I think Simon Darling, the writer, has done a fantastic job in his debut book.","words":[["I",306.3,306.44],["think",306.44,306.66],["Simon",306.66,307.06],["Darling,",307.06,307.48],["the",307.8,308.0],["writer,",308.0,308.32],["has",308.78,308.86],["done",308.86,309.0],["a",309.0,309.06],["fantastic",309.06,309.44],["job",309.44,310.04],["in",310.04,310.18],["his",310.18,310.4],["debut",310.4,310.8],["book.",310.8,311.18]]},{"start":311.86,"end":316.9,"text":"He's currently working on his second novel, A Crime Story, aimed at the adult market.","words":[["He's",311.86,312.14],["currently",312.14,312.5],["working",312.5,312.92],["on",312.92,313.2],["his",313.2,313.32],["second",313.32,313.64],["novel,",313.64,313.92],["A",314.42,314.5],["Crime",314.5,314.76],["Story,",314.76,315.22],["aimed",315.6,315.86],["at",315.86,316.04],["the",316.04,316.18],["adult",316.18,316.48],["market.",316.48,316.9]]},{"start":317.7,"end":320.48,"text":"I'm sure that will definitely be worth waiting for.","words":[["I'm",317.7,318.12],["sure",318.12,318.36],["that",318.36,318.6],["will",318.6,318.84],["definitely",318.84,319.3],["be",319.3,319.64],["worth",319.64,319.88],["waiting",319.88,320.22],["for.",320.22,320.48]]},{"start":321.22,"end":327.88,"text":"The next book I have here is The Hidden Code, which won several prizes at the last","words":[["The",321.22,321.7],["next",321.7,321.84],["book",321.84,322.08],["I",322.08,322.3],["have",322.3,322.54],["here",322.54,322.8],["is",322.8,323.38],["The",323.38,323.96],["Hidden",323.96,324.36],["Code,",324.36,325.08],["which",325.6,325.9],["won",325.9,326.06],["several",326.06,326.38],["prizes",326.38,326.88],["at",326.88,327.5],["the",327.5,327.62],["last",327.62,327.88]]},{"start":327.88,"end":328.74,"text":"book convention.","words":[["book",327.88,328.18],["convention.",328.18,328.74]]},{"start":329.7,"end":336.08,"text":"Marketed as a book for older children, it deals with realistic problems faced by young people today.","words":[["Marketed",329.7,330.38],["as",330.38,330.76],["a",330.76,330.88],["book",330.88,331.0],["for",331.0,331.2],["older",331.2,331.64],["children,",331.64,332.12],["it",332.56,332.64],["deals",332.64,332.92],["with",332.92,333.2],["realistic",333.2,333.72],["problems",333.72,334.4],["faced",334.4,334.74],["by",334.74,335.0],["young",335.0,335.32],["people",335.32,335.64],["today.",335.64,336.08]]},{"start":336.66,"end":338.56,"text":"Basically, it's a work of fiction.","words":[["Basically,",336.66,337.08],["it's",337.72,337.82],["a",337.82,337.92],["work",337.92,338.1],["of",338.1,338.28],["fiction.",338.28,338.56]]},{"start":339.8,"end":346.16,"text":"It's something that should also be read by every parent, not just the younger members of the family.","words":[["It's",339.8,340.48],["something",340.48,340.72],["that",340.72,341.02],["should",341.02,341.2],["also",341.2,341.5],["be",341.5,341.78],["read",341.78,342.06],["by",342.06,342.32],["every",342.32,342.92],["parent,",342.92,343.54],["not",343.98,344.22],["just",344.22,344.56],["the",344.56,344.86],["younger",344.86,345.14],["members",345.14,345.5],["of",345.5,345.7],["the",345.7,345.8],["family.",345.8,346.16]]},{"start":347.16,"end":352.0,"text":"And finally, my personal favourite, The Orange Moon.","words":[["And",347.16,347.84],["finally,",347.84,348.44],["my",348.9,349.08],["personal",349.08,349.64],["favourite,",349.64,350.12],["The",350.82,350.92],["Orange",350.92,351.48],["Moon.",351.48,352.0]]},{"start":352.78,"end":359.64,"text":"This is the final book in a set of novels about the lives of a fictional group of friends living in Outback Australia.","words":[["This",352.78,353.34],["is",353.34,353.7],["the",353.7,353.84],["final",353.84,354.12],["book",354.12,354.44],["in",354.44,354.64],["a",354.64,354.72],["set",354.72,354.98],["of",354.98,355.1],["novels",355.1,355.36],["about",355.36,355.8],["the",355.8,356.02],["lives",356.02,356.36],["of",356.36,356.56],["a",356.56,356.72],["fictional",356.72,356.98],["group",356.98,357.34],["of",357.34,357.5],["friends",357.5,357.8],["living",357.8,358.48],["in",358.48,358.74],["Outback",358.74,359.06],["Australia.",359.06,359.64]]},{"start":360.7,"end":367.42,"text":"I hear this is being adapted to a movie suitable for the whole family, which I'm sure will be very popular.","words":[["I",360.7,360.9],["hear",360.9,361.08],["this",361.08,361.26],["is",361.26,361.4],["being",361.4,361.64],["adapted",361.64,362.02],["to",362.02,362.32],["a",362.32,362.44],["movie",362.44,362.72],["suitable",362.72,363.28],["for",363.28,363.68],["the",363.68,363.8],["whole",363.8,364.04],["family,",364.04,364.62],["which",364.88,365.28],["I'm",365.28,365.52],["sure",365.52,365.78],["will",365.78,366.18],["be",366.18,366.42],["very",366.42,366.84],["popular.",366.84,367.42]]},{"start":370.65,"end":376.35,"text":"That is the end of section 2. You now have half a minute to check your answers.","words":[["That",370.65,371.15],["is",371.15,371.31],["the",371.31,371.45],["end",371.45,371.85],["of",371.85,372.01],["section",372.01,372.23],["2.",372.23,